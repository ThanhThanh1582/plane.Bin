ructor() {\\n        this.currentOutfit = {\\n            shirt: null,\\n            pants: null,\\n            shoes: null,\\n            seatbelt: null\\n        };\\n\\n        const ART_DIR = 'C:/Users/USER/.gemini/antigravity/brain/6f49409f-fe23-4490-984d-4f0e771339c6/';\\n\\n        this.sprites = {\\n            base: ART_DIR + 'bin_base_neutral_1787728929375.jpg',\\n            shirtOnly: ART_DIR + 'bin_yellow_shirt_only_1787728966000.jpg',\\n            shirtPants: ART_DIR + 'bin_yellow_shirt_blue_pants_1787728991730.jpg',\\n            fullOutfit: ART_DIR + 'bin_yellow_shirt_blue_pants_shoes_1787729023680.jpg'\\n        };\\n\\n        this.containers = new Set();\\n\\n        if (document.readyState === 'loading') {\\n            document.addEventListener('DOMContentLoaded', () => this.mountAll());\\n        } else {\\n            this.mountAll();\\n        }\\n    }\\n\\n    mountAll() {\\n        document.querySelectorAll('[data-bin-character]').forEach(el => {\\n            this.renderTo(el);\\n        });\\n    }\\n\\n    renderTo(containerOrId) {\\n        const container = typeof containerOrId === 'string' ? document.getElementById(containerOrId) : containerOrId;\\n        if (!container) return;\\n\\n        this.containers.add(container);\\n        this.updateImage(container);\\n    }\\n\\n    getCurrentImageSrc() {\\n        if (this.currentOutfit.shirt && this.currentOutfit.pants && this.currentOutfit.shoes) {\\n            return this.sprites.fullOutfit;\\n        } else if (this.currentOutfit.shirt && this.currentOutfit.pants) {\\n            return this.sprites.shirtPants;\\n        } else if (this.currentOutfit.shirt) {\\n            return this.sprites.shirtOnly;\\n        } else if (this.currentOutfit.pants) {\\n            return this.sprites.shirtPants;\\n        } else if (this.currentOutfit.shoes) {\\n            return this.sprites.fullOutfit;\\n        \n<truncated 1328 bytes>","Description":"\"Cập nhật character-renderer.js nạp trực