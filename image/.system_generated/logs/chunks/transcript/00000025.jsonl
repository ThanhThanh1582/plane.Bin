          return this.scenes.shirtPants;\n40:         } else if (this.currentOutfit.shirt) {\n41:             return this.scenes.shirtOnly;\n42:         } else if (this.currentOutfit.pants) {\n43:             return this.scenes.shirtPants;\n44:         } else if (this.currentOutfit.shoes) {\n45:             return this.scenes.fullOutfit;\n46:         }\n47:         return this.scenes.base;\n48:     }\n49: \n50:     updateScene() {\n51:         const sceneImg = document.getElementById('act1-room-scene-img');\n52:         if (sceneImg) {\n53:             sceneImg.src = this.getCurrentImageSrc();\n54:         }\n55:     }\n56: \n57:     setShirt(shirtKey) {\n58:         this.currentOutfit.shirt = true;\n59:         this.updateScene();\n60:     }\n61: \n62:     setPants(pantsKey) {\n63:         this.currentOutfit.pants = true;\n64:         this.updateScene();\n65:     }\n66: \n67:     setShoes(shoesKey) {\n68:         this.currentOutfit.shoes = true;\n69:         this.updateScene();\n70:     }\n71: \n72:     setSeatbelt(seatbeltKey) {\n73:         this.currentOutfit.seatbelt = seatbeltKey;\n74:     }\n75: \n76:     reset() {\n77:         this.currentOutfit = { shirt: false, pants: false, shoes: false, seatbelt: null };\n78:         this.updateScene();\n79:     }\n80: }\n81: \n82: // Khởi tạo Singleton\n83: window.binRenderer = new BinCharacterRenderer();\n84: \n85: \n86: window.binRenderer = new BinCharacterRenderer();\n87: \nThe above content shows the entire, complete file contents of the requested file.\n"}
