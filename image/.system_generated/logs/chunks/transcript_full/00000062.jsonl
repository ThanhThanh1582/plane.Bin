Đúng rồi! Món này mềm và dễ vận động.');\n1098: \n1099:         if (state.outfit.shirt && state.outfit.pants && state.outfit.shoes) {\n1100:           completeActivity(1);\n1101:           showFeedback(1);\n1102:         }\n1103:       });\n1104:     });\n1105:   }\n1106: \n1107:   function bindActivity2() {\n1108:     document.querySelectorAll('#act-2 [data-luggage-item=\"true\"]').forEach(btn => {\n1109:       btn.addEventListener('click', () => {\n1110:         const cat = btn.dataset.category;\n1111:         const name = btn.dataset.name || 'Món đồ';\n1112:         const icon = btn.dataset.icon || '📦';\n1113: \n1114:         if (cat === 'PACK') {\n1115:           btn.classList.add('runtime-packed');\n1116:           btn.style.opacity = '0.5';\n1117:           btn.style.pointerEvents = 'none';\n1118:           state.packed.add(name);\n1119: \n1120:           // Thêm hình ảnh/badge đồ vật trực tiếp vào trong vali mở\n1121:           const targetSuitcase = el('suitcase-packed-items');\n1122:           if (targetSuitcase) {\n1123:             const badge = document.createElement('div');\n1124:             badge.style.background = 'rgba(255, 255, 255, 0.95)';\n1125:             badge.style.border = '2px solid #0288D1';\n1126:             badge.style.borderRadius = '12px';\n1127:             badge.style.padding = '4px 8px';\n1128:             badge.style.fontSize = '12px';\n1129:             badge.style.fontWeight = '900';\n1130:             badge.style.color = '#01579B';\n1131:             badge.style.display = 'flex';\n1132:             badge.style.alignItems = 'center';\n1133:             badge.style.gap = '4px';\n1134:             badge.style.boxShadow = '0 4px 10px rgba(0,0,0,0.18)';\n1135:             badge.innerHTML = `${icon} ${name} ✓`;\n1136:             targetSuitcase.appendChild(badge);\n1137:           }\n1138: \n1139:           sfx.good();\n1140:           showPrompt('Bố', `Đúng rồi! ${name} cần thiết mang theo!`);\n1141:           if (state.packed.size >= 3) {\n1142:             completeActivity(2);\n1143:             showFeedback(2);\n1144:           }\n1145:         } else {\n1146:           sfx.bad();\n1147:           if (name === 'Kéo nhọn') {\n1148:             showPrompt('Bố', 'Kéo nhọn nguy hiểm, không được mang lên máy bay con nhé!');\n1149:           } else if (name === 'Ô tô to') {\n1150:             showPrompt('Bố', 'Ô tô to quá chiếm hết vali, mình để ở nhà chơi sau nhé!');\n1151:           } else {\n1152:             showPrompt('Bố', 'Bình nước lớn qua cổng an ninh không được mang, mình để ở nhà nhé!');\n1153:           }\n1154:         }\n1155:       });\n1156:     });\n1157:   }\n1158: \n1159:   function bindSimpleActivities() {\n1160:     // Act 3: Kiểm tra vé & Khoanh tròn Đỏ Số Ghế 12A & Đóng dấu Boarding Pass\n1161:     const onTicketCheck = () => {\n1162:       const redCircle = el('seat-red-circle');\n1163:       if (redCircle) redCircle.style.display = 'block';\n1164:       const stamp = el('pass-stamp-overlay');\n1165:       if (stamp) stamp.style.display = 'block';\n1166: \n1167:       sfx.good();\n1168:       setTimeout(() => sfx.stamp(), 200);\n1169: \n1170:       showPrompt('Mẹ', 'Giỏi lắm! Ghế 12A là ghế cạnh cửa sổ của Bin đấy!');\n1171:       completeActivity(3);\n1172:       showFeedback(3);\n1173:     };\n1174: \n1175:     el('seat-selection-btn')?.addEventListener('click', onTicketCheck);\n1176:     el('btn-show-ticket-3')?.addEventListener('click', onTicketCheck);\n1177:     el('boarding-pass-card')?.addEventListener('click', onTicketCheck);\n1178: \n1179:     // Act 4: Soi hành lý\n1180:     document.querySelectorAll('#act-4 .xray-item-tile').forEach((tile, i) => {\n1181:       tile.addEventListener('click', () => {\n1182:         state.xrayChecked.add(i);\n1183:         tile.classList.add('runtime-checked');\n1184:         sfx.good();\n1185:         if (state.xrayChecked.size >= 3) {\n1186:           completeActivity(4);\n1187:           showFeedback(4);\n1188:         }\n1189:       });\n1190:     });\n1191: \n1192:     // Act 5: Cổng an ninh\n1193:     el('btn-walk-gate-5')?.addEventListener('click', () => {\n1194:       sfx.good();\n1195:       showPrompt('Mẹ', 'Bíp boong! Bin qua cửa an toàn rồi!');\n1196:       completeActivity(5);\n1197:       showFeedback(5);\n1198:     });\n1199: \n1200:     // Act 6: Tìm Cổng 03\n1201:     document.querySelectorAll('#act-6 .gate-hud-btn').forEach(btn => {\n1202:       btn.addEventListener('click', () => {\n1203:         if (btn.dataset.gate === '03') {\n1204:           btn.classList.add('runtime-correct');\n1205:           sfx.good();\n1206:           showPrompt('Bố', 'Đúng rồi! Cổng 03 đây rồi!');\n1207:           completeActivity(6);\n1208:           showFeedback(6);\n1209:         } else {\n1210:           sfx.bad();\n1211:           showPrompt('Bố', 'Con nhìn lại số trên vé nhé!');\n1212:         }\n1213:       });\n1214:     });\n1215: \n1216:     // Act 7: Cài dây an toàn\n1217:     el('btn-buckle-action-7')?.addEventListener('click', () => {\n1218:       if (window.binRenderer) window.binRenderer.setSeatbelt('fastened');\n1219:       sfx.clack();\n1220:       showPrompt('Mẹ', 'CẠCH! Dây an toàn chắc chắn rồi!');\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
