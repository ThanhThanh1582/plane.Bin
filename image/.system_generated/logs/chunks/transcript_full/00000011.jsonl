USEL)\n   ========================================================================== */\n.carousel-final-arena {\n    width: 100%;\n    max-width: 900px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 14px;\n}\n\n.carousel-track-chunky {\n    width: 90%;\n    height: 160px;\n    border: 16px solid #455A64;\n    border-radius: 80px;\n    background: #ECEFF1;\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: space-around;\n    box-shadow: inset 0 0 18px rgba(0,0,0,0.25);\n    overflow: hidden;\n}\n\n.carousel-suitcases-track {\n    display: flex;\n    gap: 30px;\n    position: absolute;\n    animation: carousel-orbit 14s linear infinite;\n}\n\n.carousel-suitcases-track.paused {\n    animation-play-state: paused;\n}\n\n.carousel-bag-tile {\n    width: 78px;\n    height: 90px;\n    border-radius: 20px;\n    border: 4px solid rgba(0,0,0,0.2);\n    box-shadow: 0 6px 12px rgba(0,0,0,0.18);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 36px;\n    cursor: pointer;\n    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);\n}\n\n.carousel-bag-tile:active {\n    transform: scale(1.3) translateY(-10px);\n}\n\n/* Modal Phần Thưởng Cuối */\n.golden-medal-modal {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%) scale(0.8);\n    opacity: 0;\n    visibility: hidden;\n    width: 90%;\n    max-width: 580px;\n    background: linear-gradient(135deg, #FFFDE7 0%, #FFF9C4 100%);\n    border-radius: 38px;\n    border: 8px solid #FFD54F;\n    box-shadow: 0 20px 60px rgba(0,0,0,0.35);\n    padding: 26px;\n    text-align: center;\n    z-index: 200;\n    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);\n}\n\n.golden-medal-modal.show {\n    opacity: 1;\n    visibility: visible;\n    transform: translate(-50%, -50%) scale(1);\n}\n\n/* ==========================================================================\n   CỔNG BA MẸ (PARENT CONTROL HUB)\n   ========================================================================== */\n.parent-modal-overlay {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100vw;\n    height: 100vh;\n    background: rgba(0, 0, 0, 0.65);\n    backdrop-filter: blur(8px);\n    z-index: 999;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    opacity: 0;\n    visibility: hidden;\n    transition: all 0.3s ease;\n}\n\n.parent-modal-overlay.open {\n    opacity: 1;\n    visibility: visible;\n}\n\n.parent-control-card {\n    width: 90%;\n    max-width: 560px;\n    max-height: 88vh;\n    overflow-y: auto;\n    background: #FFFFFF;\n    border-radius: 36px;\n    padding: 24px;\n    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);\n    border: 5px solid #FF8A65;\n}\n\n.parent-tip-box {\n    background: #FFF3E0;\n    border-left: 5px solid #FF9800;\n    padding: 10px 14px;\n    border-radius: 12px;\n    margin-bottom: 10px;\n    font-size: 14px;\n    line-height: 1.45;\n    color: #4E342E;\n}\n\n.level-jump-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 8px;\n    margin: 10px 0;\n}\n\n.jump-btn {\n    padding: 8px;\n    background: #ECEFF1;\n    border: 2px solid #CFD8DC;\n    border-radius: 12px;\n    font-weight: 800;\n    font-size: 14px;\n    cursor: pointer;\n}\n\n/* ==========================================================================\n   KEYFRAME ANIMATIONS\n   ========================================================================== */\n@keyframes gentle-sway {\n    0%, 100% { transform: rotate(-3deg); }\n    50% { transform: rotate(3deg); }\n}\n\n@keyframes gentle-bounce {\n    0% { transform: translateY(0); }\n    100% { transform: translateY(-8px); }\n}\n\n@keyframes gentle-pulse {\n    0%, 100% { transform: scale(1); }\n    50% { transform: scale(1.12); }\n}\n\n@keyframes lamp-blink {\n    0% { opacity: 0.3; }\n    100% { opacity: 1; }\n}\n\n@keyframes carousel-orbit {\n    0% { transform: translateX(0); }\n    100% { transform: translateX(-400px); }\n}\n\n.pop-in {\n    animation: popIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;\n}\n\n@keyframes popIn {\n    0% { transform: scale(0.6); opacity: 0; }\n    100% { transform: scale(1); opacity: 1; }\n}\n\n.hidden {\n    display: none !important;\n}\n\n/* ==========================================================================\n   RESPONSIVE OPTIMIZATIONS (MOBILE & TABLET)\n   ========================================================================== */\n@media (max-width: 768px) {\n    .wardrobe-arena, .suitcase-arena, .cabin-seat-arena, .etiquette-arena {\n        grid-template-columns: 1fr;\n        flex-direction: column;\n    }\n    .security-station-grid {\n        grid-template-columns: 1fr;\n    }\n    .parent-prompt-signboard {\n        padding: 8px 16px;\n    }\n    .prompt-speech-text {\n        font-size: 18px;\n    }\n    .prompt-icon-badge {\n        font-size: 24px;\n    }\n    .gate-pillar {\n        width: 80px;\n        height: 85px;\n        font-size: 18px;\n    }\n}\n","Description":"Cập nhật style.css với typography offline và nút cảm xúc kèm nhãn chữ","Overwrite":true,"TargetFile":"c:\\Demo.plane\\css\\style.css","toolAction":"Writing file","toolSummary":"Update style.css with offline font stack"}}]}
