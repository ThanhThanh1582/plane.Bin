;\">\n                        BẮT ĐẦU HOẠT ĐỘNG 🚀\n                    </button>\n                </div>\n\n                <div class=\"activity-gameplay-view hidden\" id=\"gameplay-act-5\">\n                    <div class=\"unified-scene-stage\">\n                        <img id=\"scene-img-act-5\" class=\"unified-scene-img\" src=\"assets/scenes/intro_act5_gate.svg\" alt=\"Scene Cổng an ninh\">\n\n                        <div class=\"scene-interactive-hud\">\n                            <button id=\"btn-walk-gate-5\" class=\"tycoon-btn tycoon-btn-primary\" style=\"font-size: 17px; padding: 8px 24px;\">\n                                🚶 Chạm để Bin bước qua cổng an ninh\n                            </button>\n                        </div>\n                    </div>\n\n                    <div class=\"activity-feedback-overlay hidden\" id=\"feedback-act-5\">\n                        <span class=\"feedback-text\">Mẹ: “Bíp boong! Bin qua cửa an toàn rồi!”</span>\n                        <button class=\"tycoon-btn tycoon-btn-green btn-next-activity\" data-next=\"6\">\n                            TÌM CỔNG BAY 🚪 ➡️\n                        </button>\n                    </div>\n                </div>\n            </section>\n\n            <!-- ==========================================================================\n                 CHẶNG 4 — HOẠT ĐỘNG 6: TÌM ĐÚNG CỔNG 03\n                 ========================================================================== -->\n            <section id=\"act-6\" class=\"activity-container\" data-act=\"6\" data-stage=\"4\">\n                <div class=\"activity-intro-view\" id=\"intro-act-6\">\n                    <span class=\"intro-header-badge\">CHẶNG 4 — HOẠT ĐỘNG 6</span>\n                    <h2 class=\"intro-activity-title\">TÌM ĐÚNG CỔNG 03</h2>\n                    <div class=\"intro-art-frame\">\n                        <img src=\"assets/scenes/scene_act6_gate03.svg\" alt=\"Tìm Cổng 03\">\n                    </div>\