OTOTYPE)\n   - Boarding Pass lớn, chân thực, đầy đủ thông tin: BÉ BIN, CỔNG 03, GHẾ 12A, HAN -> DAD\n   - 5 Vali thật (Artwork 2D Storybook) trên băng chuyền hành lý\n   - Activity 1: Bé Bin đứng trực tiếp trong căn phòng ngủ\n   - Activity 5 & 6: Unified Scene cổng an ninh và sảnh chờ bay (Gate Concourse)\n   ========================================================================== */\n\n:root {\n    --color-sky-blue: #73C7E8;\n    --color-warm-orange: #F5A45D;\n    --color-cream-yellow: #F8D978;\n    --color-soft-green: #82C99A;\n    --color-coral-pink: #EFA49A;\n    --color-suitcase-red: #E75B52;\n    --outline-brown: #514B48;\n    --text-dark: #37474F;\n    --shadow-soft: 0 6px 14px rgba(81, 75, 72, 0.14);\n    --shadow-chunky: 0 6px 0 rgba(81, 75, 72, 0.18), 0 10px 20px rgba(0, 0, 0, 0.1);\n    --radius-round: 9999px;\n    --radius-story: 28px;\n\n    /* Master Family Reference Sprite Sheet */\n    --char-sprite: url('file:///C:/Users/USER/.gemini/antigravity/brain/6f49409f-fe23-4490-984d-4f0e771339c6/.user_uploaded/media_1787727192577.png');\n}\n\n* {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n    -webkit-tap-highlight-color: transparent;\n    user-select: none;\n    -webkit-user-select: none;\n}\n\nbody, html {\n    width: 100%;\n    height: 100%;\n    overflow: hidden;\n    font-family: \"Nunito\", \"Arial Rounded MT Bold\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n    background: #E1F5FE;\n    color: var(--text-dark);\n    touch-action: manipulation;\n}\n\n#app-root {\n    width: 100vw;\n    height: 100vh;\n    display: flex;\n    flex-direction: column;\n    position: relative;\n    overflow: hidden;\n}\n\n#effects-canvas {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    pointer-events: none;\n    z-index: 1000;\n}\n\n/* ==========================================================================\n   TẦNG 1: THANH TIẾN TRÌNH (8 CHẶNG LỚN & CỔNG BA MẸ)\n   ========================================================================== */\n.top-nav {\n    height: 48px;\n    padding: 4px 16px;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    z-index: 50;\n}\n\n.stage-indicators {\n    display: flex;\n    gap: 8px;\n    background: rgba(255, 255, 255, 0.95);\n    backdrop-filter: blur(10px);\n    padding: 4px 12px;\n    border-radius: var(--radius-round);\n    box-shadow: var(--shadow-soft);\n    border: 2px solid #FFF;\n}\n\n.stage-dot {\n    width: 34px;\n    height: 34px;\n    border-radius: 50%;\n    background: #ECEFF1;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 15px;\n    cursor: pointer;\n    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);\n    box-shadow: inset 0 -3px 0 #CFD8DC;\n    border: none;\n}\n\n.stage-dot.active {\n    background: linear-gradient(180deg, #F8D978 0%, #F5A45D 100%);\n    transform: scale(1.18);\n    box-shadow: 0 4px 12px rgba(245, 164, 93, 0.45), inset 0 -3px 0 #E67E22;\n}\n\n.stage-dot.completed {\n    background: linear-gradient(180deg, #A5D6A7 0%, #82C99A 100%);\n    box-shadow: inset 0 -3px 0 #66BB6A;\n}\n\n.stage-dot.locked {\n    opacity: 0.35;\n    cursor: not-allowed;\n    filter: grayscale(0.8);\n}\n\n.tycoon-btn {\n    min-width: 60px;\n    min-height: 42px;\n    padding: 6px 18px;\n    border: none;\n    border-radius: var(--radius-round);\n    background: #FFFFFF;\n    color: var(--text-dark);\n    font-weight: 900;\n    font-size: 15px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    cursor: pointer;\n    box-shadow: 0 5px 0 #CFD8DC, 0 8px 14px rgba(0, 0, 0, 0.1);\n    transition: all 0.12s ease;\n    touch-action: manipulation;\n}\n\n.tycoon-btn:active:not(:disabled) {\n    transform: translateY(3px);\n    box-shadow: 0 2px 0 #CFD8DC;\n}\n\n.tycoon-btn:disabled {\n    cursor: not-allowed;\n    opacity: 0.6;\n}\n\n.tycoon-btn-green {\n    background: linear-gradient(180deg, #82C99A 0%, #66BB6A 100%);\n    color: #1B5E20;\n    box-shadow: 0 5px 0 #43A047, 0 8px 18px rgba(67, 160, 71, 0.3);\n}\n\n.tycoon-btn-primary {\n    background: linear-gradient(180deg, #F8D978 0%, #F5A45D 100%);\n    color: #5D4037;\n    box-shadow: 0 5px 0 #E67E22, 0 8px 18px rgba(230, 126, 34, 0.3);\n}\n\n.parent-gate-btn {\n    position: relative;\n    overflow: hidden;\n}\n\n.parent-hold-ring {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    pointer-events: none;\n    transform: rotate(-90deg);\n}\n\n.parent-hold-ring circle {\n    fill: none;\n    stroke: #FF7043;\n    stroke-width: 5;\n    stroke-dasharray: 175;\n    stroke-dashoffset: 175;\n    transition: stroke-dashoffset 0.1s linear;\n}\n\n/* ==========================================================================\n   TẦNG 2: TIẾN TRÌNH PHỤ & LỜI THOẠI BA MẸ\n   ========================================================================== */\n.parent-prompt-container {\n    width: 100%;\n    max-width: 900px;\n    margin: 0 auto 2px auto;\n    padding: 0 16px;\n    z-index: 40;\n    display: flex;\n    flex-direction: column;\n    gap: 3px;\n}\n\n.sub-progress-bar {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 12px;\n    background: rgba(255, 255, 255, 0.9);\n    padding: 2px 14px;\n    border-radius: var(--radius-round);\n    font-size: 13px;\n    font-weight: 800;\n    color: #455A64;\n    border: 1px solid rgba(255, 255, 255, 0.9);\n}\n\n.parent-prompt-signboard {\n    background: rgba(255, 255, 255, 0.96);\n    border-radius: 20px;\n    padding: 4px 16px;\n    border: 3px solid #FFE082;\n    box-shadow: 0 3px 0 #FFCA28, var(--shadow-soft);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    text-align: center;\n}\n\n.prompt-avatar-sprite {\n    width: 42px;\n    height: 42px;\n    border-radius: 50%;\n    border: 3px solid #F5A45D;\n    box-shadow: 0 3px 8px rgba(0,0,0,0.12);\n    background-image: var(--char-sprite);\n    background-repeat: no-repeat;\n    flex-shrink: 0;\n}\n\n.prompt-avatar-sprite.speaker-mom {\n    background-size: 500% auto;\n    background-position: 29.5% 18%;\n    border-color: #EFA49A;\n}\n\n.prompt-avatar-sprite.speaker-dad {\n    background-size: 500% auto;\n    background-position: 51.5% 18%;\n    border-color: #82C99A;\n}\n\n.prompt-avatar-sprite.speaker-bin {\n    background-size: 500% auto;\n    background-position: 8.5% 18%;\n    border-color: #F5A45D;\n}\n\n.prompt-avatar-sprite.speaker-attendant {\n    background-size: 500% auto;\n    background-position: 88.5% 18%;\n    border-color: #00897B;\n}\n\n.prompt-speech-text {\n    font-size: 17px;\n    font-weight: 900;\n    color: var(--text-dark);\n    line-height: 1.3;\n}\n\n/* ==========================================================================\n   TẦNG 3: VIEWPORT 13 HOẠT ĐỘNG\n   ========================================================================== */\n.screens-viewport {\n    flex: 1;\n    position: relative;\n    width: 100%;\n    height: calc(100vh - 110px);\n    overflow: hidden;\n}\n\n.activity-container {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    opacity: 0;\n    visibility: hidden;\n    transform: scale(0.98);\n    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.34, 1.25, 0.64, 1), visibility 0.3s;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    padding: 2px 14px 8px 14px;\n    background-size: cover;\n    background-position: center;\n    background-repeat: no-repeat;\n}\n\n.activity-container.active {\n    opacity: 1;\n    visibility: visible;\n    transform: scale(1);\n}\n\n/* MÀN GIỚI THIỆU HOẠT ĐỘNG (INTRO VIEW) */\n.activity-intro-view {\n    width: 100%;\n    max-width: 820px;\n    height: 90%;\n    background: rgba(255, 255, 255, 0.96);\n    backdrop-filter: blur(10px);\n    border-radius: var(--radius-story);\n    border: 4px solid #FFE082;\n    box-shadow: 0 10px 0 #FFCA28, var(--shadow-chunky);\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: space-between;\n    padding: 12px 20px;\n    text-align: center;\n    margin: auto 0;\n    z-index: 10;\n}\n\n.intro-header-badge {\n    background: #E1F5FE;\n    color: #0288D1;\n    font-size: 13px;\n    font-weight: 900;\n    padding: 3px 14px;\n    border-radius: var(--radius-round);\n    border: 2px solid #B3E5FC;\n}\n\n.intro-activity-title {\n    font-size: 21px;\n    font-weight: 900;\n    color: #E65100;\n    margin: 2px 0;\n}\n\n.intro-art-frame {\n    width: 100%;\n    max-width: 620px;\n    height: 250px;\n    border-radius: 20px;\n    overflow: hidden;\n    box-shadow: 0 6px 16px rgba(0,0,0,0.12);\n    border: 3px solid #FFF;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background: #FFF;\n}\n\n.intro-art-frame img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n}\n\n.intro-prompt-quote {\n    font-size: 16px;\n    font-weight: 800;\n    color: #37474F;\n    line-height: 1.3;\n    padding: 0 10px;\n}\n\n.activity-gameplay-view {\n    width: 100%;\n    height: 100%;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    position: relative;\n}\n\n/* ==========================================================================\n   UNIFIED SCENE ART STAGE\n   ========================================================================== */\n.unified-scene-stage {\n    width: 100%;\n    max-width: 860px;\n    height: 86%;\n    position: relative;\n    border-radius: 28px;\n    overflow: hidden;\n    box-shadow: 0 8px 24px rgba(0,0,0,0.18), 0 0 0 4px #FFFFFF;\n    background: #000;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin: auto 0;\n}\n\n.unified-scene-img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    transition: opacity 0.35s ease, transform 0.35s cubic-bezier(0.34, 1.25, 0.64, 1);\n}\n\n.scene-interactive-hud {\n    position: absolute;\n    bottom: 12px;\n    left: 50%;\n    transform: translateX(-50%);\n    background: rgba(255, 255, 255, 0.95);\n    backdrop-filter: blur(8px);\n    border-radius: var(--radius-round);\n    padding: 8px 20px;\n    border: 3px solid #FFE082;\n    box-shadow: 0 6px 0 #FFCA28, var(--shadow-soft);\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    z-index: 20;\n}\n\n.activity-feedback-overlay {\n    position: absolute;\n    bottom: 14px;\n    left: 50%;\n    transform: translateX(-50%);\n    background: rgba(255, 255, 255, 0.98);\n    border-radius: 30px;\n    padding: 8px 22px;\n    border: 4px solid #82C99A;\n    box-shadow: 0 8px 0 #43A047, var(--shadow-chunky);\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    z-index: 60;\n    animation: popBounce 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);\n    white-space: nowrap;\n}\n\n.activity-feedback-overlay.hidden {\n    display: none !important;\n}\n\n.feedback-text {\n    font-size: 17px;\n    font-weight: 900;\n    color: #1B5E20;\n}\n\n/* ==========================================================================\n   ACTIVITY 1: THAY ĐỒ TRỰC TIẾP TRONG PHÒNG NGỦ\n   ========================================================================== */\n.bedroom-scene-layout {\n    width: 100%;\n    max-width: 920px;\n    height: 86%;\n    position: relative;\n    border-radius: 28px;\n    overflow: hidden;\n    box-shadow: 0 8px 24px rgba(0,0,0,0.18), 0 0 0 4px #FFFFFF;\n    background-image: url('file:///C:/Users/USER/.gemini/antigravity/brain/6f49409f-fe23-4490-984d-4f0e771339c6/bg_home_1787718137754.jpg');\n    background-size: cover;\n    background-position: center;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 18px 32px;\n}\n\n.room-wardrobe-shelf {\n    background: rgba(255, 255, 255, 0.92);\n    backdrop-filter: blur(8px);\n    border: 4px solid #FFE082;\n    border-radius: 24px;\n    padding: 10px;\n    box-shadow: 0 8px 20px rgba(0,0,0,0.14);\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 10px;\n    z-index: 10;\n}\n\n.room-bin-stand {\n    width: 250px;\n    height: 360px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    position: relative;\n    z-index: 10;\n}\n\n.clothes-tile-art {\n    min-height: 85px;\n    min-width: 110px;\n    background: #FFFFFF;\n    border-radius: 18px;\n    border: 3px solid #CFD8DC;\n    box-shadow: 0 4px 0 #B0BEC5, 0 6px 12px rgba(0,0,0,0.06);\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    padding: 4px;\n    cursor: pointer;\n    touch-action: none;\n    transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);\n}\n\n.clothes-tile-art:hover { transform: translateY(-3px) scale(1.04); }\n.clothes-tile-art:active { transform: scale(1.15); }\n.clothes-tile-art.shake-wobble {\n    animation: springShake 0.45s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;\n    border-color: #E75B52 !important;\n}\n\n.item-img-art {\n    width: 58px;\n    height: 58px;\n    object-fit: contain;\n    pointer-events: none;\n}\n\n.item-label-tag {\n    font-size: 12px;\n    font-weight: 800;\n    color: var(--text-dark);\n    margin-top: 2px;\n    text-align: center;\n}\n\n.bin-mount-lvl1 {\n    width: 240px;\n    height: 350px;\n}\n\n.bin-layered-stack {\n    position: relative;\n    width: 100%;\n    height: 100%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n}\n\n.bin-layer {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n    pointer-events: none;\n}\n\n/* ==========================================================================\n   ACTIVITY 3 & 6: BOARDING PASS LỚN, RÕ, ĐỦ THÔNG TIN\n   ========================================================================== */\n.real-boarding-pass {\n    width: 100%;\n    max-width: 560px;\n    background: #FFFFFF;\n    border-radius: 28px;\n    border: 4px solid #F5A45D;\n    box-shadow: 0 10px 0 #E67E22, var(--shadow-chunky);\n    overflow: hidden;\n    position: relative;\n    cursor: pointer;\n    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);\n}\n\n.real-boarding-pass:hover { transform: scale(1.02); }\n\n.pass-header-strip {\n    background: linear-gradient(90deg, #0288D1 0%, #29B6F6 100%);\n    color: #FFFFFF;\n    padding: 8px 18px;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    font-weight: 900;\n    font-size: 14px;\n}\n\n.pass-body-grid {\n    padding: 14px 20px;\n    display: grid;\n    grid-template-columns: 1.4fr 1fr;\n    gap: 14px;\n    background: #FFFDE7;\n}\n\n.pass-field-label {\n    font-size: 11px;\n    font-weight: 900;\n    color: #78909C;\n    text-transform: uppercase;\n}\n\n.pass-field-value {\n    font-size: 18px;\n    font-weight: 900;\n    color: #37474F;\n}\n\n.pass-gate-highlight {\n    background: #FFF3E0;\n    border: 3px solid #FF9800;\n    border-radius: 16px;\n    padding: 8px 12px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n}\n\n.pass-gate-num {\n    font-size: 34px;\n    font-weight: 900;\n    color: #E65100;\n    line-height: 1;\n}\n\n.pass-stamp-overlay {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%) rotate(-15deg) scale(0);\n    border: 5px solid #2E7D32;\n    color: #1B5E20;\n    background: rgba(232, 245, 233, 0.95);\n    font-weight: 900;\n    font-size: 26px;\n    padding: 8px 24px;\n    border-radius: 16px;\n    opacity: 0;\n    pointer-events: none;\n    box-shadow: 0 4px 16px rgba(46, 125, 50, 0.4);\n    transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);\n}\n\n.pass-stamp-overlay.stamped {\n    opacity: 1;\n    transform: translate(-50%, -50%) rotate(-15deg) scale(1.1);\n    animation: stampSlam 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;\n}\n\n/* ==========================================================================\n   ACTIVITY 4: SOI HÀNH LÝ VỚI ARTWORK THẬT (KHÔNG DÙNG EMOJI)\n   ========================================================================== */\n.xray-screen-art-grid {\n    width: 100%;\n    height: 130px;\n    background: #00251A;\n    border-radius: 22px;\n    border: 4px solid #00E676;\n    box-shadow: inset 0 0 20px rgba(0, 230, 118, 0.5);\n    display: flex;\n    align-items: center;\n    justify-content: space-around;\n    padding: 8px;\n}\n\n.xray-item-tile {\n    width: 80px;\n    height: 80px;\n    background: #004D40;\n    border: 3px solid #00E676;\n    border-radius: 20px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n    box-shadow: 0 0 14px rgba(0, 230, 118, 0.4);\n    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);\n    padding: 6px;\n}\n\n.xray-item-tile:hover { transform: scale(1.12); }\n.xray-item-tile img {\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n    filter: brightness(0.2) invert(1) drop-shadow(0 0 4px #00E676);\n}\n\n.xray-item-tile.revealed {\n    background: #FFFDE7;\n    border-color: #F8D978;\n    box-shadow: 0 0 18px #FFD54F;\n    animation: popBounce 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);\n}\n\n.xray-item-tile.revealed img {\n    filter: none;\n}\n\n/* ==========================================================================\n   ACTIVITY 6: GATE CONCOURSE SCENE & HOTZONES\n   ========================================================================== */\n.gate-concourse-stage {\n    width: 100%;\n    max-width: 860px;\n    height: 86%;\n    position: relative;\n    border-radius: 28px;\n    overflow: hidden;\n    box-shadow: 0 8px 24px rgba(0,0,0,0.18), 0 0 0 4px #FFFFFF;\n    background: #000;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin: auto 0;\n}\n\n.gate-select-hud {\n    position: absolute;\n    bottom: 12px;\n    left: 50%;\n    transform: translateX(-50%);\n    background: rgba(255, 255, 255, 0.95);\n    backdrop-filter: blur(8px);\n    border-radius: var(--radius-round);\n    padding: 6px 18px;\n    border: 3px solid #FFE082;\n    box-shadow: 0 6px 0 #FFCA28, var(--shadow-soft);\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    z-index: 20;\n}\n\n.gate-hud-btn {\n    min-width: 75px;\n    min-height: 44px;\n    padding: 4px 14px;\n    border-radius: 14px;\n    border: 3px solid #CFD8DC;\n    background: #263238;\n    color: #F8D978;\n    font-weight: 900;\n    font-size: 16px;\n    cursor: pointer;\n    transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);\n}\n\n.gate-hud-btn:hover { transform: scale(1.1); }\n.gate-hud-btn.matched {\n    background: linear-gradient(180deg, #2E7D32 0%, #1B5E20 100%);\n    border-color: #00E676;\n    color: #FFFFFF;\n    box-shadow: 0 0 16px #00E676;\n}\n\n/* ==========================================================================\n   ACTIVITY 13: 5 VALI THẬT TRÊN BĂNG CHUYỀN HÀNH LÝ\n   ========================================================================== */\n.real-carousel-track {\n    width: 100%;\n    max-width: 860px;\n    height: 200px;\n    border: 14px solid #455A64;\n    border-radius: 100px;\n    background: #ECEFF1;\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: space-around;\n    box-shadow: inset 0 0 16px rgba(0,0,0,0.2);\n    overflow: hidden;\n    margin: auto 0;\n}\n\n.real-suitcases-orbit {\n    display: flex;\n    gap: 32px;\n    position: absolute;\n    animation: carousel-orbit 14s linear infinite;\n    align-items: center;\n}\n\n.real-suitcases-orbit.paused { animation-play-state: paused; }\n\n.real-suitcase-card {\n    width: 100px;\n    height: 140px;\n    background: transparent;\n    border: none;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);\n}\n\n.real-suitcase-card:hover { transform: scale(1.15) translateY(-6px); }\n.real-suitcase-card img {\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n    filter: drop-shadow(0 6px 12px rgba(0,0,0,0.25));\n}\n\n.real-suitcase-card.bin-picked {\n    transform: scale(1.35) translateY(-14px);\n    filter: drop-shadow(0 0 16px #FFD54F);\n}\n\n/* ==========================================================================\n   KEYFRAME ANIMATIONS\n   ========================================================================== */\n@keyframes springShake {\n    10%, 90% { transform: translate3d(-3px, 0, 0) rotate(-3deg); }\n    20%, 80% { transform: translate3d(4px, 0, 0) rotate(3deg); }\n    30%, 50%, 70% { transform: translate3d(-5px, 0, 0) rotate(-2deg); }\n    40%, 60% { transform: translate3d(5px, 0, 0) rotate(2deg); }\n}\n@keyframes stampSlam {\n    0% { transform: translate(-50%, -50%) scale(2.4) rotate(-35deg); opacity: 0; }\n    50% { transform: translate(-50%, -50%) scale(0.95) rotate(-10deg); opacity: 1; }\n    100% { transform: translate(-50%, -50%) scale(1.1) rotate(-15deg); opacity: 1; }\n}\n@keyframes popBounce { 0% { transform: scale(0.8); } 60% { transform: scale(1.18); } 100% { transform: scale(1); } }\n@keyframes carousel-orbit { 0% { transform: translateX(0); } 100% { transform: translateX(-480px); } }\n\n.pop-in { animation: popIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; }\n@keyframes popIn { 0% { transform: scale(0.7); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }\n.hidden { display: none !important; }\n\n/* ==========================================================================\n   RESPONSIVE (1366x768 & 1920x1080)\n   ========================================================================== */\n@media (max-width: 900px) {\n    .bedroom-scene-