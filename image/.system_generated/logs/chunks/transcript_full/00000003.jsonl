l7Tasks.leg = true;\n                legTarget.style.transform = 'translateY(15px)';\n                if (legLabel) legLabel.textContent = '🪑 Chân đã thu lại ngay ngắn ✓';\n\n                if (window.effectsMgr) {\n                    const r = legTarget.getBoundingClientRect();\n                    window.effectsMgr.spawnFloatingHeartsAt(r.left + r.width / 2, r.top);\n                }\n\n                if (window.audioMgr) {\n                    window.audioMgr.playTing();\n                    window.audioMgr.speak('Bố', 'Bin ngồi ngoan lắm, không đạp vào lưng ghế phía trước là rất lịch sự!');\n                }\n                this.checkLevel7Completion();\n            };\n        }\n\n        if (btnNext7) {\n            btnNext7.onclick = () => {\n                if (window.audioMgr) window.audioMgr.playPop();\n                this.initLevel8();\n                this.showScreen(8);\n            };\n        }\n    }\n\n    checkLevel7Completion() {\n        const btnNext7 = document.getElementById('btn-next-level-7');\n        if (this.level7Tasks.volume && this.level7Tasks.leg) {\n            if (btnNext7) {\n                btnNext7.classList.remove('hidden');\n                btnNext7.classList.add('pop-in');\n            }\n        }\n    }\n\n    // ==========================================================================\n    // LEVEL 8: BĂNG CHUYỀN VUI NHỘN & HUY HIỆU DỰ THƯỞNG\n    // ==========================================================================\n    initLevel8() {\n        const unbuckleLatch = document.getElementById('unbuckle-latch-btn');\n        const baggageCarousel = document.getElementById('baggage-carousel-lvl8');\n        const bags = document.querySelectorAll('.carousel-bag-lvl8');\n        const badgeModal = document.getElementById('golden-badge-modal');\n        const btnReplay = document.getElementById('btn-replay-adventure');\n\n        // Bước 1: Mở lẫy đai an toàn\n        if (unbuckleLatch) {\n            unbuckleLatch.onclick = () => {\n                if (this.level8Tasks.unbuckle) return;\n                this.level8Tasks.unbuckle = true;\n                unbuckleLatch.innerHTML = '<span>🔓 Đã mở khóa đai an toàn ✓</span>';\n                unbuckleLatch.style.borderColor = '#00E676';\n\n                if (window.audioMgr) {\n                    window.audioMgr.playUnbuckle();\n                    setTimeout(() => {\n                        window.audioMgr.speak('Bố', 'Tách! Đai đã mở, giờ gia đình mình ra băng chuyền lấy vali dán hình gấu nhé!');\n                    }, 300);\n                }\n\n                if (baggageCarousel) baggageCarousel.classList.remove('hidden');\n            };\n        }\n\n        // Bước 2: Bắt đúng vali đỏ hình gấu\n        bags.forEach(bag => {\n            bag.onclick = () => {\n                if (!this.level8Tasks.unbuckle) {\n                    if (window.audioMgr) window.audioMgr.speak('Mẹ', 'Bin mở đai an toàn trước nhé!');\n                    return;\n                }\n\n                const isBinBag = bag.getAttribute('data-is-bin') === 'true';\n\n                if (isBinBag) {\n                    this.level8Tasks.baggage = true;\n                    bag.style.transform = 'scale(1.4) translateY(-20px)';\n                    document.querySelector('.carousel-suitcases').classList.add('paused');\n\n                    if (window.effectsMgr) {\n                        window.effectsMgr.startCelebrationFireworks(8000);\n                    }\n\n                    if (window.audioMgr) {\n                        window.audioMgr.playFanfare();\n                        setTimeout(() => {\n                            window.audioMgr.speak('Mẹ', 'Hoan hô bé Bin! Chúc mừng Hành khách nhí xuất sắc của Bố Mẹ!');\n                        }, 500);\n                    }\n\n                    setTimeout(() => {\n                        if (badgeModal) badgeModal.classList.add('show');\n                    }, 1200);\n                } else {\n                    if (window.audioMgr) {\n                        window.audioMgr.playBoing();\n                        window.audioMgr.speak('Bố', 'Vali này của bạn khác rồi, Bin tìm chiếc vali màu đỏ có dán hình gấu nhé!');\n                    }\n                }\n            };\n        });\n\n        if (btnReplay) {\n            btnReplay.onclick = () => {\n                if (window.audioMgr) window.audioMgr.playPop();\n                window.location.reload();\n            };\n        }\n    }\n}\n\ndocument.addEventListener('DOMContentLoaded', () => {\n    window.kidFlightApp = new KidFlightApp();\n});\n","Description":"Cập nhật app.js với logic và tương tác trọn vẹn 8 Level","Overwrite":true,"TargetFile":"c:\\Demo.plane\\js\\app.js","toolAction":"Writing file","toolSummary":"Update app.js"}}]}
