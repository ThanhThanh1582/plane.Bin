xrayCount++;\n\n                if (window.audioMgr) window.audioMgr.playTing();\n                if (window.effectsMgr) {\n                    const r = box.getBoundingClientRect();\n                    window.effectsMgr.burstStarsAt(r.left + r.width / 2, r.top + r.height / 2);\n                }\n\n                if (this.level3Steps.xrayCount >= 3) {\n                    window.dialogueMgr.show('Mẹ', '“Vali của Bin an toàn rồi! Chạm để Bin qua cổng nhé.”', '👩');\n                    this.checkLevel3Completion();\n                }\n            };\n        });\n\n        if (gate) {\n            gate.onclick = () => {\n                if (this.level3Steps.gate) return;\n                this.level3Steps.gate = true;\n\n                lamps.forEach(l => l.classList.add('green-flash'));\n                if (binWalker) binWalker.style.transform = 'translateY(-18px) scale(1.15)';\n\n                if (window.audioMgr) window.audioMgr.playBeepBoop();\n                window.dialogueMgr.show('Mẹ', '“Bíp boong! Bin qua cửa an toàn rồi!”', '👩');\n                this.checkLevel3Completion();\n            };\n        }\n\n        if (btnNext3) {\n            btnNext3.onclick = () => {\n                if (window.audioMgr) window.audioMgr.playPop();\n                this.showScreen(4);\n            };\n        }\n    }\n\n    checkLevel3Completion() {\n        const btnNext3 = document.getElementById('btn-next-level-3');\n        if (this.level3Steps.pass && this.level3Steps.xrayCount >= 3 && this.level3Steps.gate) {\n            if (btnNext3) {\n                btnNext3.classList.remove('hidden');\n                btnNext3.classList.add('pop-in');\n            }\n        }\n    }\n\n    // ==========================================================================\n    // LEVEL 4: RA CỔNG BAY & NỐI VÉ ĐA NHÂN VẬT\n    // ==========================================================================\n    initLevel4() {\n        const charCards = document.querySelectorAll('#screen-4 .character-ticket-card');\n        const gatePillars = document.querySelectorAll('#screen-4 .gate-pillar');\n        const btnNext4 = document.getElementById('btn-next-level-4');\n\n        charCards.forEach(card => {\n            card.onclick = () => {\n                charCards.forEach(c => c.classList.remove('selected'));\n                card.classList.add('selected');\n                this.level4SelectedChar = card.getAttribute('data-char');\n                const gateNum = card.getAttribute('data-gate');\n                const name = card.querySelector('strong').textContent;\n                window.dialogueMgr.show('Bố', `“${name} cầm vé số ${gateNum}. Con tìm Cổng ${gateNum} nhé!”`, '👨');\n                if (window.audioMgr) window.audioMgr.playPop();\n            };\n        });\n\n        gatePillars.forEach(pillar => {\n            pillar.onclick = () => {\n                if (!this.level4SelectedChar) {\n                    window.dialogueMgr.show('Bố', '“Con chạm vào bạn nhỏ trước, rồi chọn Cổng nhé!”', '👨');\n                    return;\n                }\n\n                const targetGate = pillar.getAttribute('data-gate');\n                const activeCard = document.querySelector(`#screen-4 .character-ticket-card[data-char=\"${this.level4SelectedChar}\"]`);\n                const correctGate = activeCard ? activeCard.getAttribute('data-gate') : null;\n\n                if (targetGate === correctGate) {\n                    pillar.classList.add('matched');\n                    activeCard.classList.remove('selected');\n                    activeCard.classList.add('connected');\n                    this.level4Connections[this.level4SelectedChar] = true;\n                    this.level4SelectedChar = null;\n\n                    if (window.effectsMgr) {\n                        const r = pillar.getBoundingClientRect();\n                        window.effectsMgr.burstStarsAt(r.left + r.width / 2, r.top + r.height / 2);\n                    }\n                    if (window.audioMgr) window.audioMgr.playConnect();\n\n                    if (correctGate === '03') {\n                        window.dialogueMgr.show('Tiếp viên', '“Đúng Cổng 03 rồi! Chào mừng Bin lên máy bay!”', '👩‍✈️');\n                    } else {\n                        window.dialogueMgr.show('Bố', '“Đúng cửa rồi, mời bạn lên máy bay!”', '👨');\n                    }\n\n                    if (this.level4Connections.bin) {\n                        if (btnNext4) {\n                            btnNext4.classList.remove('hidden');\n                            btnNext4.classList.add('pop-in');\n                        }\n                    }\n                } else {\n                    if (window.audioMgr) window.audioMgr.playBoing();\n                    window.dialogueMgr.show('Bố', '“Chưa đúng số trên vé rồi, con tìm lại nhé!”', '👨');\n                }\n            };\n        });\n\n        if (btnNext4) {\n            btnNext4.onclick = () => {\n                if (window.audioMgr) window.audioMgr.playPop();\n                this.showScreen(5);\n            };\n        }\n    }\n\n    // ==========================================================================\n    // LEVEL 5: HIỆP SĨ ĐAI AN TOÀN & UỐNG NƯỚC\n    // ==========================================================================\n    initLevel5() {\n        const strapLeft = document.getElementById('seatbelt-strap-lvl5');\n        const puzzleBox = document.getElementById('seatbelt-puzzle-lvl5');\n        const safetySign = document.getElementById('safety-sign-lvl5');\n        const knightCape = document.getElementById('bin-knight-cape');\n        const btnWater = document.getElementById('btn-drink-water-lvl5');\n        const earWaves = document.querySelectorAll('#screen-5 .ear-soundwave');\n        const btnNext5 = document.getElementById('btn-next-level-5');\n\n        const tryBuckleBelt = () => {\n            if (this.level5Belt.inserted) return;\n            this.level5Belt.inserted = true;\n            puzzleBox.classList.add('seatbelt-buckled');\n\n            if (safetySign) safetySign.classList.add('green-safe');\n            if (knightCape) knightCape.classList.add('active');\n\n            if (window.audioMgr) {\n                window.audioMgr.playClack();\n                window.audioMgr.startEngineSound(0.25);\n            }\n\n            if (window.effectsMgr) {\n                const r = puzzleBox.getBoundingClientRect();\n                window.effectsMgr.burstStarsAt(r.left + r.width / 2, r.top + r.height / 2);\n            }\n\n            window.dialogueMgr.show('Mẹ', '“CẠCH! Dây an toàn chắc chắn rồi!”', '👩');\n\n            setTimeout(() => {\n                earWaves.forEach(w => w.classList.remove('hidden'));\n                if (btnWater) btnWater.classList.remove('hidden');\n                window.dialogueMgr.show('Mẹ', '“Bin uống một ngụm nước để tai dễ chịu hơn nhé!”', '👩');\n            }, 3000);\n        };\n\n        if (strapLeft && puzzleBox) {\n            let isDragging = false;\n            let startX = 0;\n\n            const onDown = (e) => {\n                if (this.level5Belt.inserted) return;\n                isDragging = true;\n                strapLeft.setPointerCapture(e.pointerId);\n                startX = e.clientX;\n            };\n\n            const onMove = (e) => {\n                if (!isDragging || this.level5Belt.inserted) return;\n                const dx = Math.max(0, Math.min(45, e.clientX - startX));\n                strapLeft.style.transform = `translateX(${dx}px)`;\n\n                if (dx >= 35) {\n                    tryBuckleBelt();\n                }\n            };\n\n            const onUp = (e) => {\n                if (!isDragging) return;\n                isDragging = false;\n                strapLeft.releasePointerCapture(e.pointerId);\n                if (!this.level5Belt.inserted) {\n                    strapLeft.style.transform = 'translateX(0px)';\n                }\n            };\n\n            strapLeft.addEventListener('pointerdown', onDown);\n            strapLeft.addEventListener('pointermove', onMove);\n            strapLeft.addEventListener('pointerup', onUp);\n\n            puzzleBox.addEventListener('click', () => {\n                tryBuckleBelt();\n            });\n        }\n\n        if (btnWater) {\n            btnWater.onclick = () => {\n                if (this.level5Belt.earRelieved) return;\n                this.level5Belt.earRelieved = true;\n\n                earWaves.forEach(w => w.classList.add('hidden'));\n\n                if (window.effectsMgr) {\n                    const binHead = document.getElementById('bin-seat-head');\n                    if (binHead) {\n                        const r = binHead.getBoundingClientRect();\n                        window.effectsMgr.spawnMusicNotesAt(r.left + r.width / 2, r.top);\n                    }\n                }\n\n                if (window.audioMgr) window.audioMgr.playDrinkWater();\n                window.dialogueMgr.show('Bin', '“Tai Bin dễ chịu hơn rồi!”', '🧒');\n\n                if (btnNext5) {\n                    btnNext5.classList.remove('hidden');\n                    btnNext5.classList.add('pop-in');\n                }\n            };\n        }\n\n        if (btnNext5) {\n            btnNext5.onclick = () => {\n                if (window.audioMgr) window.audioMgr.playPop();\n                this.showScreen(6);\n            };\n        }\n    }\n\n    // ==========================================================================\n    // LEVEL 6: NGẮM MÂY BIẾN HÌNH\n    // ==========================================================================\n    initLevel6() {\n        const cloudTiles = document.querySelectorAll('#screen-6 .morph-cloud-tile');\n        const btnNext6 = document.getElementById('btn-next-level-6');\n\n        cloudTiles.forEach(tile => {\n            tile.onclick = () => {\n                if (tile.classList.contains('morphed')) return;\n                tile.classList.add('morphed');\n\n                const morphType = tile.getAttribute('data-morph');\n                const icon = tile.querySelector('.cloud-icon');\n                const label = tile.querySelector('.cloud-label');\n\n                if (morphType === 'bunny') {\n                    icon.textContent = '🐰';\n                    label.textContent = 'Chú thỏ';\n                    this.level6Clouds.c1 = true;\n                    window.dialogueMgr.show('Bin', '“Bin thấy giống chú thỏ! Còn con thấy giống gì?”', '🧒');\n                } else if (morphType === 'car') {\n                    icon.textContent = '🚗';\n                    label.textContent = 'Chiếc ô tô';\n                    this.level6Clouds.c2 = true;\n                    window.dialogueMgr.show('Bin', '“Bin thấy giống ô tô chạy! Còn con thấy giống gì?”', '🧒');\n                } else if (morphType === 'watermelon') {\n                    icon.textContent = '🍉';\n                    label.textContent = 'Miếng dưa hấu';\n                    this.level6Clouds.c3 = true;\n                    window.dialogueMgr.show('Bin', '“Bin thấy giống miếng dưa hấu! Còn con thấy giống gì?”', '🧒');\n                } else if (morphType === 'bear') {\n                    icon.textContent = '🐻';\n                    label.textContent = 'Chú gấu';\n                    this.level6Clouds.c4 = true;\n                    window.dialogueMgr.show('Bin', '“Bin thấy giống chú gấu vẫy tay! Còn con thấy giống gì?”', '🧒');\n                }\n\n                if (window.effectsMgr) {\n                    const r = tile.getBoundingClientRect();\n                    window.effectsMgr.burstStarsAt(r.left + r.width / 2, r.top + r.height / 2);\n                }\n                if (window.audioMgr) window.audioMgr.playBling();\n\n                if (this.level6Clouds.c1 && this.level6Clouds.c2 && this.level6Clouds.c3 && this.level6Clouds.c4) {\n                    if (btnNext6) {\n                        btnNext6.classList.remove('hidden');\n                        btnNext6.classList.add('pop-in');\n                    }\n                }\n            };\n        });\n\n        if (btnNext6) {\n            btnNext6.onclick = () => {\n                if (window.audioMgr) window.audioMgr.playPop();\n                this.showScreen(7);\n            };\n        }\n    }\n\n    // ==========================================================================\n    // LEVEL 7: MÓN QUÀ LỊCH SỰ\n    // ==========================================================================\n    initLevel7() {\n        const emotionBtns = document.querySelectorAll('#screen-7 .volume-emotion-btn');\n        const legTarget = document.getElementById('bin-leg-target');\n        const legLabel = document.getElementById('leg-status-label');\n        const btnNext7 = document.getElementById('btn-next-level-7');\n\n        emotionBtns.forEach(btn => {\n            btn.onclick = () => {\n                emotionBtns.forEach(b => b.classList.remove('selected'));\n                btn.classList.add('selected');\n                const level = btn.getAttribute('data-level');\n\n                if (level === 'whisper') {\n                    this.level7Tasks.volume = true;\n                    if (window.effectsMgr) {\n                        const r = btn.getBoundingClientRect();\n                        window.effectsMgr.spawnFloatingHeartsAt(r.left + r.width / 2, r.top);\n                    }\n                    if (window.audioMgr) window.audioMgr.playTing();\n                    window.dialogueMgr.show('Bin', '“Chúng mình nói nhỏ vừa đủ nghe để mọi người nghỉ ngơi nhé!”', '🧒');\n                    this.checkLevel7Completion();\n                } else {\n                    if (window.audioMgr) window.audioMgr.playPop();\n                    window.dialogueMgr.show('Mẹ', '“Trên máy bay con giúp Bin chọn nút nói nhỏ hơn nhé!”', '👩');\n                }\n            };\n        });\n\n        if (legTarget) {\n            legTarget.onclick = () => {\n                if (this.level7Tasks.leg) return;\n                this.level7Tasks.leg = true;\n                legTarget.style.transform = 'translateY(16px)';\n                if (legLabel) legLabel.textContent = 'Chân Bin đã thu lại ngay ngắn ✓';\n\n                if (window.effectsMgr) {\n                    const r = legTarget.getBoundingClientRect();\n                    window.effectsMgr.spawnFloatingHeartsAt(r.left + r.width / 2, r.top);\n                }\n\n                if (window.audioMgr) window.audioMgr.playTing();\n                window.dialogueMgr.show('Bố', '“Bin ngồi ngoan, không đạp ghế trước!”', '👨');\n                this.checkLevel7Completion();\n            };\n        }\n\n        if (btnNext7) {\n            btnNext7.onclick = () => {\n                if (window.audioMgr) window.audioMgr.playPop();\n                this.showScreen(8);\n            };\n        }\n    }\n\n    checkLevel7Completion() {\n        const btnNext7 = document.getElementById('btn-next-level-7');\n        if (this.level7Tasks.volume && this.level7Tasks.leg) {\n            if (btnNext7) {\n                btnNext7.classList.remove('hidden');\n                btnNext7.classList.add('pop-in');\n            }\n        }\n    }\n\n    // ==========================================================================\n    // LEVEL 8: LẤY VALI & NHẬN PHẦN THƯỞNG\n    // ==========================================================================\n    initLevel8() {\n        const unbuckleLatch = document.getElementById('unbuckle-latch-btn');\n        const baggageCarousel = document.getElementById('baggage-carousel-lvl8');\n        const bags = document.querySelectorAll('#screen-8 .carousel-bag-tile');\n        const medalModal = document.getElementById('golden-medal-modal');\n        const btnReplay = document.getElementById('btn-replay-adventure');\n\n        if (unbuckleLatch) {\n            unbuckleLatch.onclick = () => {\n                if (!this.level8State.planeStopped) {\n                    window.dialogueMgr.show('Bố', '“Máy bay đang chạy vào chỗ đỗ. Bin vẫn ngồi yên và giữ dây an toàn nhé!”', '👨');\n                    return;\n                }\n\n                if (this.level8State.unbuckled) return;\n                this.level8State.unbuckled = true;\n                unbuckleLatch.innerHTML = '<span>🔓 Đai an toàn đã mở ✓</span>';\n                unbuckleLatch.style.borderColor = '#00E676';\n\n                if (window.audioMgr) window.audioMgr.playUnbuckle();\n                window.dialogueMgr.show('Bố', '“Con tìm giúp Bin chiếc vali màu đỏ có dán hình gấu nhé!”', '👨');\n\n                if (baggageCarousel) baggageCarousel.classList.remove('hidden');\n            };\n        }\n\n        bags.forEach(bag => {\n            bag.onclick = () => {\n                if (!this.level8State.unbuckled) {\n                    window.dialogueMgr.show('Mẹ', '“Máy bay dừng hẳn rồi. Bây giờ mình mới mở dây an toàn nhé!”', '👩');\n                    return;\n                }\n\n                const isBinBag = bag.getAttribute('data-is-bin') === 'true';\n\n                if (isBinBag) {\n                    this.level8State.baggage = true;\n                    bag.style.transform = 'scale(1.4) translateY(-18px)';\n                    const track = document.querySelector('.carousel-suitcases-track');\n                    if (track) track.classList.add('paused');\n\n                    if (window.effectsMgr) {\n                        window.effectsMgr.startCelebrationFireworks(3200);\n                    }\n\n                    if (window.audioMgr) window.audioMgr.playFanfare();\n                    window.dialogueMgr.show('Mẹ', '“Hoan hô! Bin tìm đúng vali rồi!”', '👩');\n\n                    setTimeout(() => {\n                        if (medalModal) medalModal.classList.add('show');\n                    }, 1200);\n                } else {\n                    if (window.audioMgr) window.audioMgr.playBoing();\n                    window.dialogueMgr.show('Bố', '“Vali của bạn khác rồi, con tìm chiếc màu đỏ dán hình gấu nhé!”', '👨');\n                }\n            };\n        });\n\n        if (btnReplay) {\n            btnReplay.onclick = () => {\n                if (window.audioMgr) window.audioMgr.playPop();\n                window.location.reload();\n            };\n        }\n    }\n}\n\ndocument.addEventListener('DOMContentLoaded', () => {\n    window.kidFlightApp = new KidFlightApp();\n});\n","Description":"Tích hợp tính năng cắt hình nền 3D đa sắc màu vào app.js","Overwrite":true,"TargetFile":"c:\\Demo.plane\\js\\app.js","toolAction":"Writing file","toolSummary":"Update app.js with colorful background slice loader"}}]}
