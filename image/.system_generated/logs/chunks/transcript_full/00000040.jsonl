 let started = 0, raf = null;\n\n    function reset() {\n      if (raf) cancelAnimationFrame(raf);\n      raf = null; started = 0;\n      if (circle) circle.style.strokeDashoffset = '175';\n    }\n    function tick() {\n      const elapsed = performance.now() - started;\n      const progress = Math.min(1, elapsed/3000);\n      if (circle) circle.style.strokeDashoffset = String(175 - 175*progress);\n      if (progress >= 1) {\n        modal?.classList.add('open'); reset(); return;\n      }\n      raf = requestAnimationFrame(tick);\n    }\n    gate?.addEventListener('pointerdown', e => {\n      e.preventDefault(); started = performance.now(); raf = requestAnimationFrame(tick);\n    });\n    ['pointerup','pointerleave','pointercancel'].forEach(ev => gate?.addEventListener(ev, reset));\n    el('btn-close-parent')?.addEventListener('click', () => modal?.classList.remove('open'));\n\n    document.querySelectorAll('.jump-btn').forEach(btn => {\n      btn.addEventListener('click', () => {\n        modal?.classList.remove('open');\n        showActivity(Number(btn.dataset.act), {force:true});\n      });\n    });\n\n    el('btn-reset-app')?.addEventListener('click', () => location.reload());\n\n    el('setting-volume')?.addEventListener('input', e => volume = Number(e.target.value));\n    el('setting-reduced-motion')?.addEventListener('change', e => {\n      state.reducedMotion = e.target.checked;\n      document.documentElement.classList.toggle('reduced-motion', state.reducedMotion);\n    });\n  }\n\n  function bindImageFallbackForAppOpening() {\n    document.querySelectorAll('img').forEach(img => {\n      img.addEventListener('error', () => {\n        const parent = img.parentElement;\n        if (!parent || parent.querySelector(':scope > .asset-load-error')) return;\n        const msg = document.createElement('div');\n        msg.className = 'asset-load-error';\n        msg.textContent = `Thiếu ảnh: ${img.getAttribute('src')}`;\n        parent.appendChild(msg);\n        img.style.display = 'none';\n      });\n    });\n  }\n\n  function init() {\n    if (state.initialized) return;\n    state.initialized = true;\n    attachImageDiagnostics();\n    bindImageFallbackForAppOpening();\n    bindNavigation();\n    bindParentGate();\n    bindActivity1();\n    bindActivity2();\n    bindSimpleActivities();\n    showActivity(1, {force:true});\n    console.log('[APP READY] 13-activity controller loaded');\n  }\n\n  document.addEventListener('DOMContentLoaded', init);\n})();\n</script>\n\n</body>\n</html>\n","Description":"Đồng bộ tệp index.html với bản runtime hotfix chuẩn mới nhất","Overwrite":true,"TargetFile":"c:\\Demo.plane\\index.html","toolAction":"Writing file","toolSummary":"Sync index.html with runtime hotfix"}}]}
