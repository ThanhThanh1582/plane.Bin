roke-width=\"3\" opacity=\"0.5\"/>\n\n  <!-- Thảm len tròn màu ngọc bích dưới chân Bé Bin -->\n  <ellipse cx=\"620\" cy=\"515\" rx=\"240\" ry=\"60\" fill=\"url(#rugGrad)\" filter=\"url(#shadow)\"/>\n  <ellipse cx=\"620\" cy=\"515\" rx=\"210\" ry=\"48\" fill=\"#E0F2F1\" opacity=\"0.6\"/>\n\n  <!-- 3. TỦ QUẦN ÁO MỞ CÁNH (WARDROBE) -->\n  <g transform=\"translate(60, 50)\" filter=\"url(#shadow)\">\n    <rect x=\"0\" y=\"0\" width=\"340\" height=\"460\" rx=\"22\" fill=\"url(#wardrobeWood)\" stroke=\"#BF360C\" stroke-width=\"6\"/>\n    <rect x=\"20\" y=\"20\" width=\"300\" height=\"340\" rx=\"14\" fill=\"url(#wardrobeInner)\" stroke=\"#FFA726\" stroke-width=\"4\"/>\n    <rect x=\"35\" y=\"60\" width=\"270\" height=\"12\" rx=\"6\" fill=\"#8D6E63\"/>\n\n    <!-- Kệ để giày & đồ dùng dưới -->\n    <rect x=\"35\" y=\"230\" width=\"270\" height=\"10\" rx=\"4\" fill=\"#FFA726\"/>\n    <rect x=\"20\" y=\"375\" width=\"300\" height=\"65\" rx=\"12\" fill=\"#FB8C00\" stroke=\"#E65100\" stroke-width=\"4\"/>\n    <circle cx=\"170\" cy=\"407\" r=\"9\" fill=\"#FFE082\" stroke=\"#E65100\" stroke-width=\"3\"/>\n    <polygon points=\"0,0 -50,30 -50,430 0,460\" fill=\"#F57C00\" stroke=\"#BF360C\" stroke-width=\"5\"/>\n  </g>\n</svg>\n","Description":"Đồng bộ hoàn hảo bg_home.svg cùng bối cảnh 100% với intro_act1_wardrobe.svg","Overwrite":true,"TargetFile":"c:\\Demo.plane\\assets\\backgrounds\\bg_home.svg","toolAction":"Writing file","toolSummary":"Sync bg_home.svg with intro scene"}}]}
