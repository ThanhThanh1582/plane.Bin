th=\"4\"/>\n    <circle cx=\"200\" cy=\"361\" r=\"16\" fill=\"#00E676\" stroke=\"#00897B\" stroke-width=\"3\"/>\n    <!-- Dấu tích an toàn -->\n    <path d=\"M 193 361 L 198 366 L 208 355\" stroke=\"#FFFFFF\" stroke-width=\"4\" stroke-linecap=\"round\" fill=\"none\"/>\n\n    <!-- Cánh tay ôm lấy khóa an toàn -->\n    <rect x=\"70\" y=\"240\" width=\"44\" height=\"110\" rx=\"22\" transform=\"rotate(25 70 240)\" fill=\"url(#blueShirtBB)\" stroke=\"#01579B\" stroke-width=\"4\"/>\n    <circle cx=\"95\" cy=\"365\" r=\"20\" fill=\"url(#skinBB)\"/>\n    \n    <rect x=\"285\" y=\"240\" width=\"44\" height=\"110\" rx=\"22\" transform=\"rotate(-25 285 240)\" fill=\"url(#blueShirtBB)\" stroke=\"#01579B\" stroke-width=\"4\"/>\n    <circle cx=\"305\" cy=\"365\" r=\"20\" fill=\"url(#skinBB)\"/>\n\n    <!-- Khuôn mặt tròn Bé Bin -->\n    <circle cx=\"200\" cy=\"130\" r=\"85\" fill=\"url(#skinBB)\" stroke=\"#FFA726\" stroke-width=\"4\"/>\n    <circle cx=\"115\" cy=\"135\" r=\"18\" fill=\"url(#skinBB)\"/>\n    <circle cx=\"285\" cy=\"135\" r=\"18\" fill=\"url(#skinBB)\"/>\n    \n    <!-- Mái tóc nâu đen -->\n    <path d=\"M 115 110 C 115 40, 285 40, 285 110 C 275 85, 230 75, 200 90 C 170 75, 125 85, 115 110 Z\" fill=\"#3E2723\"/>\n    <path d=\"M 195 50 Q 210 20 225 35 Q 215 50 205 55 Z\" fill=\"#3E2723\"/>\n    \n    <!-- Đôi mắt tròn -->\n    <circle cx=\"165\" cy=\"125\" r=\"10\" fill=\"#212121\"/>\n    <circle cx=\"162\" cy=\"122\" r=\"3\" fill=\"#FFFFFF\"/>\n    <circle cx=\"235\" cy=\"125\" r=\"10\" fill=\"#212121\"/>\n    <circle cx=\"232\" cy=\"122\" r=\"3\" fill=\"#FFFFFF\"/>\n\n    <!-- Má hồng -->\n    <circle cx=\"145\" cy=\"145\" r=\"14\" fill=\"#FF8A80\" opacity=\"0.6\"/>\n    <circle cx=\"255\" cy=\"145\" r=\"14\" fill=\"#FF8A80\" opacity=\"0.6\"/>\n\n    <!-- Nụ cười tự tin -->\n    <path d=\"M 180 145 Q 200 170 220 145\" stroke=\"#BF360C\" stroke-width=\"5\" stroke-linecap=\"round\" fill=\"#D32F2F\"/>\n  </g>\n</svg>\n","Description":"Tạo sprite Bé Bin Áo Xanh ĐÃ CÀ