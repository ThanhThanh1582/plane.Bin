\" fill=\"#E53935\" stroke=\"#B71C1C\" stroke-width=\"3\"/>\n    <!-- Tay cầm & Bánh xe xoay 360 độ -->\n    <rect x=\"90\" y=\"118\" width=\"40\" height=\"8\" rx=\"4\" fill=\"#424242\"/>\n    <circle cx=\"30\" cy=\"124\" r=\"8\" fill=\"#212121\"/>\n    <circle cx=\"190\" cy=\"124\" r=\"8\" fill=\"#212121\"/>\n    <!-- Đồ vật mẫu đã xếp gọn trong vali: Chú gấu bông nhỏ xinh & áo thun vàng -->\n    <g transform=\"translate(30, 48) scale(0.6)\">\n      <!-- Gấu bông -->\n      <circle cx=\"30\" cy=\"30\" r=\"22\" fill=\"#8D6E63\"/>\n      <circle cx=\"16\" cy=\"14\" r=\"9\" fill=\"#8D6E63\"/>\n      <circle cx=\"44\" cy=\"14\" r=\"9\" fill=\"#8D6E63\"/>\n      <ellipse cx=\"30\" cy=\"36\" rx=\"10\" ry=\"7\" fill=\"#D7CCC8\"/>\n      <circle cx=\"30\" cy=\"33\" r=\"3\" fill=\"#3E2723\"/>\n      <circle cx=\"23\" cy=\"26\" r=\"3\" fill=\"#212121\"/>\n      <circle cx=\"37\" cy=\"26\" r=\"3\" fill=\"#212121\"/>\n    </g>\n    <g transform=\"translate(100, 52) scale(0.55)\">\n      <!-- Áo thun gấp gọn -->\n      <rect x=\"0\" y=\"0\" width=\"70\" height=\"55\" rx=\"6\" fill=\"#FDD835\" stroke=\"#F57F17\" stroke-width=\"2\"/>\n      <polygon points=\"20,35 45,15 55,40 30,32\" fill=\"none\" stroke=\"#F57F17\" stroke-width=\"2\"/>\n    </g>\n  </g>\n\n  <!-- 3. BÉ BIN VÀ BỐ ĐANG CHUẨN BỊ ĐỒ -->\n  <!-- Bé Bin đứng háo hức bên cạnh vali -->\n  <g transform=\"translate(450, 170)\" filter=\"url(#shadow)\">\n    <!-- Chân & Giày -->\n    <rect x=\"35\" y=\"180\" width=\"16\" height=\"50\" rx=\"6\" fill=\"#FCD0B4\"/>\n    <rect x=\"65\" y=\"180\" width=\"16\" height=\"50\" rx=\"6\" fill=\"#FCD0B4\"/>\n    <!-- Giày xanh dán xé -->\n    <rect x=\"28\" y=\"222\" width=\"28\" height=\"14\" rx=\"5\" fill=\"#0288D1\" stroke=\"#01579B\" stroke-width=\"2\"/>\n    <rect x=\"62\" y=\"222\" width=\"28\" height=\"14\" rx=\"5\" fill=\"#0288D1\" stroke=\"#01579B\" stroke-width=\"2\"/>\n\n    <!-- Quần thun xanh -->\n    <path d=\"M 28 135 L 88 135 L 85 185 L 62 185 L 58 150 L 54 185 L 31 185 Z\" fill=\"#4FC3F7\" stroke=\"#0288D1\" stroke-width=\"3\"/>\n\n    <!-- Áo thun vàng in hình máy bay -->\n    <path d=\"M 20 65 Q 58 55 96 65 L 90 142 Q 58 148 26 142 Z\" fill=\"#FDD835\" stroke=\"#F57F17\" stroke-width=\"3\"/>\n    <g transform=\"translate(56, 85) rotate(-10) scale(0.45)\">\n      <polygon points=\"10,40 55,10 70,55 35,45\" fill=\"none\" stroke=\"#F57F17\" stroke-width=\"3\"/>\n    </g>\n\n    <!-- Tay trái chỉ vào vali, tay phải xòe tự tin -->\n    <path d=\"M 22 68 L -5 105 Q -10 115 2 118 L 18 85 Z\" fill=\"#FCD0B4\" stroke=\"#FFA726\" stroke-width=\"2\"/>\n    <circle cx=\"-5\" cy=\"115\" r=\"8\" fill=\"#FCD0B4\"/>\n    <path d=\"M 94 68 L 115 105 Q 125 115 118 120 L 92 85 Z\" fill=\"#FCD0B4\" stroke=\"#FFA726\" stroke-width=\"2\"/>\n    <circle cx=\"120\" cy=\"115\" r=\"8\" fill=\"#FCD0B4\"/>\n\n    <!-- Đầu & Khuôn mặt Bé Bin -->\n    <ellipse cx=\"58\" cy=\"25\" rx=\"36\" ry=\"33\" fill=\"#FCD0B4\" stroke=\"#FFA726\" stroke-width=\"2\"/>\n    <!-- Mái tóc đen có lọn tóc cong -->\n    <path d=\"M 24 20 C 24 -20, 92 -20, 92 20 C 88 0, 75 -10, 65 -5 C 55 -15, 45 -10, 38 0 C 30 0, 26 10, 24 20 Z\" fill=\"#4E342E\"/>\n    <path d=\"M 68 -15 Q 75 -35 70 -38 Q 62 -30 64 -15 Z\" fill=\"#4E342E\"/>\n    <!-- Mắt to long lanh & Má hồng -->\n    <ellipse cx=\"44\" cy=\"20\" rx=\"5\" ry=\"6\" fill=\"#212121\"/>\n    <circle cx=\"42\" cy=\"18\" r=\"2\" fill=\"#FFFFFF\"/>\n    <ellipse cx=\"72\" cy=\"20\" rx=\"5\" ry=\"6\" fill=\"#212121\"/>\n    <circle cx=\"70\" cy=\"18\" r=\"2\" fill=\"#FFFFFF\"/>\n    <ellipse cx=\"34\" cy=\"28\" rx=\"8\" ry=\"5\" fill=\"#FF8A80\" opacity=\"0.6\"/>\n    <ellipse cx=\"82\" cy=\"28\" rx=\"8\" ry=\"5\" fill=\"#FF8A80\" opacity=\"0.6\"/>\n    <path d=\"M 50 32 Q 58 42 66 32\" stroke=\"#BF360C\" stroke-width=\"3\" stroke-linecap=\"round\" fill=\"none\"/>\n  </g>\n</svg>\n","Description":"Tạo intro_act2_packing.svg chuẩn 2D Storybook cho Hoạt động 2","Overwrite":true,"TargetFile":"c:\\Demo.plane\\assets\\scenes\\intro_act