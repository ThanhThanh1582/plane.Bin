Ố 03 🧳</text>\n  </g>\n\n  <!-- Đèn chiếu sáng trần nhà sân bay -->\n  <rect x=\"80\" y=\"0\" width=\"100\" height=\"8\" fill=\"#FFF59D\"/>\n  <rect x=\"620\" y=\"0\" width=\"100\" height=\"8\" fill=\"#FFF59D\"/>\n\n  <!-- 2. BĂNG CHUYỀN HÀNH LÝ LƯỢN OVAL HOÀNH TRÁNG -->\n  <g transform=\"translate(100, 220)\" filter=\"url(#shadow)\">\n    <!-- Đế kim loại của băng chuyền -->\n    <ellipse cx=\"300\" cy=\"110\" rx=\"280\" ry=\"80\" fill=\"#78909C\" stroke=\"#37474F\" stroke-width=\"4\"/>\n    <!-- Vành đai băng tải cao su màu đen nhám -->\n    <ellipse cx=\"300\" cy=\"105\" rx=\"250\" ry=\"65\" fill=\"url(#beltGrad)\" stroke=\"#455A64\" stroke-width=\"4\"/>\n    <!-- Lõi giữa băng chuyền mạ inox sáng bóng -->\n    <ellipse cx=\"300\" cy=\"105\" rx=\"140\" ry=\"35\" fill=\"#B0BEC5\" stroke=\"#90A4AE\" stroke-width=\"3\"/>\n    <text x=\"300\" y=\"112\" font-family=\"sans-serif\" font-size=\"13\" font-weight=\"bold\" fill=\"#37474F\" text-anchor=\"middle\">CAROUSEL 03</text>\n\n    <!-- CÁC CHIẾC VALI ĐẦY MÀU SẮC ĐANG CHẠY TRÊN BĂNG CHUYỀN -->\n    <!-- Vali 1: Vali Đỏ của Bé Bin (Có hình chú gấu nâu dễ thương) -->\n    <g transform=\"translate(380, 50) rotate(15)\">\n      <rect x=\"0\" y=\"0\" width=\"70\" height=\"48\" rx=\"8\" fill=\"#E53935\" stroke=\"#B71C1C\" stroke-width=\"2\"/>\n      <rect x=\"6\" y=\"6\" width=\"58\" height=\"36\" rx=\"4\" fill=\"#EF5350\"/>\n      <!-- Hình chú gấu nâu trên thân vali -->\n      <circle cx=\"35\" cy=\"24\" r=\"12\" fill=\"#8D6E63\"/>\n      <circle cx=\"27\" cy=\"16\" r=\"4\" fill=\"#8D6E63\"/>\n      <circle cx=\"43\" cy=\"16\" r=\"4\" fill=\"#8D6E63\"/>\n      <ellipse cx=\"35\" cy=\"27\" rx=\"5\" ry=\"3.5\" fill=\"#D7CCC8\"/>\n      <!-- Thẻ hành lý màu vàng -->\n      <rect x=\"64\" y=\"20\" width=\"12\" height=\"7\" fill=\"#FDD835\" stroke=\"#F57F17\" stroke-width=\"1\"/>\n    </g>\n\n    <!-- Vali 2: Vali Xanh Dương tên lửa -->\n    <g transform=\"translate(180, 70) rotate(-10)\">\n      <rect x=\"0\" y=\"0\" width=\"