idth=\"24\" height=\"60\" rx=\"12\" fill=\"url(#skinGrad)\"/>\n    <ellipse cx=\"72\" cy=\"295\" rx=\"18\" ry=\"10\" fill=\"#ECEFF1\" stroke=\"#CFD8DC\" stroke-width=\"2\"/>\n    <ellipse cx=\"128\" cy=\"295\" rx=\"18\" ry=\"10\" fill=\"#ECEFF1\" stroke=\"#CFD8DC\" stroke-width=\"2\"/>\n\n    <!-- Quần short thun mềm mộc -->\n    <path d=\"M 55 185 L 145 185 L 138 245 L 105 245 L 100 215 L 95 245 L 62 245 Z\" fill=\"#FFFFFF\" stroke=\"#CFD8DC\" stroke-width=\"3\"/>\n\n    <!-- Áo ba lỗ lót trắng mộc -->\n    <rect x=\"55\" y=\"105\" width=\"90\" height=\"85\" rx=\"16\" fill=\"#FFFFFF\" stroke=\"#CFD8DC\" stroke-width=\"3\"/>\n    <path d=\"M 75 105 Q 100 120 125 105\" stroke=\"#CFD8DC\" stroke-width=\"3\" fill=\"none\"/>\n\n    <!-- Cánh tay trái chạm cằm suy nghĩ dễ thương -->\n    <path d=\"M 55 125 Q 30 160 55 180\" stroke=\"#FFA726\" stroke-width=\"18\" stroke-linecap=\"round\" fill=\"none\"/>\n    <circle cx=\"55\" cy=\"180\" r=\"11\" fill=\"url(#skinGrad)\"/>\n\n    <!-- Cánh tay phải chống hông -->\n    <path d=\"M 145 125 Q 170 150 150 175\" stroke=\"#FFA726\" stroke-width=\"18\" stroke-linecap=\"round\" fill=\"none\"/>\n    <circle cx=\"148\" cy=\"175\" r=\"11\" fill=\"url(#skinGrad)\"/>\n\n    <!-- Khuôn mặt tròn trịa Bé Bin -->\n    <circle cx=\"100\" cy=\"55\" r=\"48\" fill=\"url(#skinGrad)\" stroke=\"#FFA726\" stroke-width=\"3\"/>\n    <!-- Đôi tai -->\n    <circle cx=\"52\" cy=\"58\" r=\"10\" fill=\"url(#skinGrad)\"/>\n    <circle cx=\"148\" cy=\"58\" r=\"10\" fill=\"url(#skinGrad)\"/>\n\n    <!-- Mái tóc đen tròn ngộ nghĩnh có lọn tóc nhỏ trên đỉnh -->\n    <path d=\"M 52 45 C 52 5, 148 5, 148 45 C 142 30, 115 25, 100 32 C 85 25, 58 30, 52 45 Z\" fill=\"#212121\"/>\n    <path d=\"M 100 8 Q 108 -2 105 -5 Q 98 -2 100 8\" fill=\"#212121\"/>\n\n    <!-- Đôi mắt to tròn đen láy -->\n    <circle cx=\"80\" cy=\"52\" r=\"6\" fill=\"#212121\"/>\n    <circle cx=\"78\" cy=\"50\" r=\"2\" fill=\"#FFFFFF\"/>\n    <circle cx=\"120\" cy=\"52\" r=\"6\" fill=\"#212121\