on>\n                            <!-- 3. Vali vàng quả cherry -->\n                            <button class=\"real-suitcase-card\" data-is-bin=\"false\">\n                                <img src=\"assets/suitcases/suitcase_yellow_cherry.svg\" alt=\"Vali vàng cherry\">\n                            </button>\n                            <!-- 4. Vali xanh lá quả bóng -->\n                            <button class=\"real-suitcase-card\" data-is-bin=\"false\">\n                                <img src=\"assets/suitcases/suitcase_green_ball.svg\" alt=\"Vali xanh bóng\">\n                            </button>\n                            <!-- 5. Vali tím ngôi sao -->\n                            <button class=\"real-suitcase-card\" data-is-bin=\"false\">\n                                <img src=\"assets/suitcases/suitcase_purple_star.svg\" alt=\"Vali tím sao\">\n                            </button>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- MÀN THƯỞNG CUỐI CÙNG -->\n                <div id=\"golden-medal-modal\" class=\"golden-medal-modal\">\n                    <div style=\"display: flex; justify-content: center; margin-bottom: 6px;\">\n                        <img src=\"assets/characters/bin/bin_holding_badge.svg\" style=\"width: 160px; height: 200px; object-fit: contain;\" alt=\"Bin nhận huy hiệu\">\n                    </div>\n                    <h2 style=\"font-size: 22px; font-weight: 900; color: #E65100; margin: 4px 0;\">HÀNH KHÁCH NHÍ XUẤT SẮC</h2>\n                    <p style=\"font-size: 14px; font-weight: 800; color: #37474F; margin: 4px 0;\">Bé Bin đã hoàn thành chuyến bay đầu tiên!</p>\n                    <div style=\"background: #E1F5FE; color: #0288D1; padding: 4px 14px; border-radius: 999px; font-weight: 900; font-size: 13px; display: inline-block; margin: 6px 0;\">\n                        ✈️ Đã nhận Mô hình Máy Bay vào bộ sưu tập của Bin!\n                    </div>\n\n                    <button id=\"btn-replay-adventure\" class=\"tycoon-btn tycoon-btn-primary\" style=\"font-size: 17px; padding: 8px 24px; margin-top: 10px;\">\n                        🔄 CHƠI LẠI CÙNG BIN\n                    </button>\n                </div>\n            </section>\n\n        </main>\n\n        <!-- CỔNG BA MẸ (P0.1: FIXED OVERLAY, DISPLAY: NONE MẶC ĐỊNH) -->\n        <div id=\"parent-modal\" class=\"parent-modal-overlay\">\n            <div class=\"parent-control-card\">\n                <h2 style=\"color: #D84315; font-size: 20px; margin-bottom: 8px;\">🛡️ Cổng Dành Cho Ba Mẹ</h2>\n                \n                <div class=\"parent-tip-box\">\n                    <strong>💡 Giúp tai bé dễ chịu khi máy bay lên/xuống:</strong> Khi cất cánh hoặc hạ cánh, cho bé ngồi thẳng và uống từng ngụm nước nhỏ để khuyến khích động tác nuốt, giúp tai dễ chịu hơn.\n                </div>\n\n                <div style=\"margin: 8px 0;\">\n                    <strong style=\"font-size: 13px; color: #37474F;\">Chọn nhanh hoạt động:</strong>\n                    <div class=\"level-jump-grid\">\n                        <button class=\"jump-btn\" data-act=\"1\">1. Mặc đồ</button>\n                        <button class=\"jump-btn\" data-act=\"2\">2. Xếp vali</button>\n                        <button class=\"jump-btn\" data-act=\"3\">3. Kiểm tra vé</button>\n                        <button class=\"jump-btn\" data-act=\"4\">4. Soi hành lý</button>\n                        <button class=\"jump-btn\" data-act=\"5\">5. Cổng an ninh</button>\n                        <button class=\"jump-btn\" data-act=\"6\">6. Cổng 03</button>\n                        <button class=\"jump-btn\" data-act=\"7\">7. Cài đai</button>\n                        <button class=\"jump-btn\" data-act=\"8\">8. Uống nước</button>\n                        <button class=\"jump-btn\" data-act=\"9\">9. Ngắm mây</button>\n                        <button class=\"jump-btn\" data-act=\"10\">10. Nói nhỏ</button>\n                        <button class=\"jump-btn\" data-act=\"11\">11. Ngồi gọn</button>\n                        <button class=\"jump-btn\" data-act=\"12\">12. Mở đai</button>\n                        <button class=\"jump-btn\" data-act=\"13\">13. Nhận vali</button>\n                    </div>\n                </div>\n\n                <div style=\"display: flex; justify-content: space-between; align-items: center; margin: 6px 0; font-weight: 800; font-size: 13px;\">\n                    <span>Âm lượng hiệu ứng:</span>\n                    <input id=\"setting-volume\" type=\"range\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.85\" style=\"width: 120px; height: 22px;\">\n                </div>\n\n                <div style=\"display: flex; justify-content: space-between; align-items: center; margin: 6px 0; font-weight: 800; font-size: 13px;\">\n                    <span>Giảm hiệu ứng chuyển động:</span>\n                    <input id=\"setting-reduced-motion\" type=\"checkbox\" style=\"width: 20px; height: 20px;\">\n                </div>\n\n                <div style=\"display: flex; gap: 8px; margin-top: 10px;\">\n                    <button id=\"btn-reset-app\" class=\"tycoon-btn\" style=\"flex: 1; font-size: 14px;\">\n                        🔄 Chơi lại từ đầu\n                    </button>\n                    <button id=\"btn-close-parent\" class=\"tycoon-btn tycoon-btn-primary\" style=\"flex: 1; font-size: 14px;\">\n                        Đóng Bảng Cài Đặt ✓\n                    </button>\n                </div>\n            </div>\n        </div>\n\n    </div>\n\n    <!-- Scripts: audio -> effects -> character-renderer -> app -->\n\n<script id=\"runtime-hotfix-js\">\n(() => {\n  'use strict';\n\n  const ACTIVITY_META = {\n    1:{stage:1,label:'Chọn trang phục',speaker:'Mẹ',prompt:'Bin sắp đi máy bay rồi. Con chọn bộ đồ nào giúp Bin dễ vận động nhé!'},\n    2:{stage:2,label:'Xếp hành lý',speaker:'Bố',prompt:'Bin mang gì đi máy bay nhỉ? Con xếp vali giúp Bin nhé!'},\n    3:{stage:3,label:'Kiểm tra vé',speaker:'Mẹ',prompt:'Đến quầy kiểm tra rồi. Con giúp Bin đưa vé nhé!'},\n    4:{stage:3,label:'Soi hành lý',speaker:'Bố',prompt:'Bây giờ vali của Bin sẽ đi qua máy soi. Con xem bên trong có gì nhé!'},\n    5:{stage:3,label:'Cổng an ninh',speaker:'Mẹ',prompt:'Đến cổng an ninh rồi. Con giúp Bin đi qua nhé!'},\n    6:{stage:4,label:'Tìm Cổng 03',speaker:'Bố',prompt:'Vé của Bin ghi số 03. Con tìm cổng số 03 nhé!'},\n    7:{stage:5,label:'Cài dây an toàn',speaker:'Mẹ',prompt:'Bin ngồi vào ghế rồi. Con giúp Bin cài dây an toàn nhé!'},\n    8:{stage:5,label:'Giúp tai dễ chịu',speaker:'Mẹ',prompt:'Tai Bin hơi khó chịu. Bin uống một ngụm nước nhé.'},\n    9:{stage:6,label:'Ngắm mây',speaker:'Bin',prompt:'Bin thấy đám mây giống hình gì nhỉ? Con nhìn cùng Bin nhé!'},\n    10:{stage:7,label:'Nói nhỏ',speaker:'Mẹ',prompt:'Trên máy bay mình nói nhỏ vừa đủ nghe nhé.'},\n    11:{stage:7,label:'Ngồi gọn',speaker:'Bố',prompt:'Bin thu chân gọn lại để không chạm ghế phía trước nhé!'},\n    12:{stage:8,label:'Mở dây sau khi dừng',speaker:'Bố',prompt:'Máy bay đang chạy vào chỗ đỗ. Bin vẫn ngồi yên và giữ dây an toàn nhé!'},\n    13:{stage:8,label:'Nhận vali',speaker:'Bố',prompt:'Con tìm chiếc vali đỏ có hình gấu của Bin nhé!'}\n  };\n\n  const SPEAKER_ICON = { 'Mẹ':'👩', 'Bố':'👨', 'Bin':'🧒', 'Tiếp viên':'👩‍✈️' };\n  const state = {\n    currentAct: 1,\n    completedActs: new Set(),\n    unlockedStages: new Set([1]),\n    initialized: false,\n    activity12Timer: null,\n    outfit: {shirt:null,pants:null,shoes:null},\n    packed: new Set(),\n    xrayChecked: new Set(),\n    clouds: new Set(),\n    reducedMotion: false\n  };\n\n  function el(id){ return document.getElementById(id); }\n\n  function showPrompt(speaker, text) {\n    const p = el('parent-prompt-text');\n    const a = el('parent-prompt-avatar');\n    if (p) p.textContent = `“${text}”`;\n    if (a) a.textContent = SPEAKER_ICON[speaker] || '🌟';\n  }\n\n  function showFeedback(act) {\n    const f = el(`feedback-act-${act}`);\n    if (f) f.classList.remove('hidden');\n  }\n\n  function updateProgress(act) {\n    const meta = ACTIVITY_META[act];\n    const sub = el('sub-progress-text');\n    if (sub && meta) sub.textContent = `Chặng ${meta.stage} — Hoạt động ${act}: ${meta.label}`;\n\n    document.querySelectorAll('.stage-dot').forEach(dot => {\n      const st = Number(dot.dataset.stage);\n      dot.classList.toggle('active', st === meta.stage);\n      dot.classList.toggle('completed', st < meta.stage || state.unlockedStages.has(st) && st !== meta.stage);\n      const unlocked = state.unlockedStages.has(st) || st === meta.stage;\n      dot.classList.toggle('locked', !unlocked);\n      dot.disabled = !unlocked;\n    });\n  }\n\n  function resetActivityView(act) {\n    const intro = el(`intro-act-${act}`);\n    const game = el(`gameplay-act-${act}`);\n    const feedback = el(`feedback-act-${act}`);\n    if (intro) intro.classList.remove('hidden');\n    if (game) game.classList.add('hidden');\n    if (feedback) feedback.classList.add('hidden');\n  }\n\n  function showActivity(act, {force=false}={}) {\n    if (!ACTIVITY_META[act]) return;\n    const targetStage = ACTIVITY_META[act].stage;\n    if (!force && !state.unlockedStages.has(targetStage)) return;\n\n    if (state.activity12Timer) {\n      clearTimeout(state.activity12Timer);\n      state.activity12Timer = null;\n    }\n\n    document.querySelectorAll('.activity-container').forEach(s => s.classList.remove('active'));\n    const target = el(`act-${act}`);\n    if (!target) {\n      console.error('[ACTIVITY MISSING]', act);\n      return;\n    }\n    target.classList.add('active');\n    state.currentAct = act;\n    resetActivityView(act);\n    updateProgress(act);\n    const meta = ACTIVITY_META[act];\n    showPrompt(meta.speaker, meta.prompt);\n    window.scrollTo({top:0, behavior:'instant'});\n  }\n\n  function startActivity(act) {\n    const intro = el(`intro-act-${act}`);\n    const game = el(`gameplay-act-${act}`);\n    if (intro) intro.classList.add('hidden');\n    if (game) game.classList.remove('hidden');\n\n    if (act === 1) ensureBinRenderer();\n    if (act === 12) armLandingWait();\n  }\n\n  function completeActivity(act) {\n    state.completedActs.add(act);\n    const nextAct = act + 1;\n    if (ACTIVITY_META[nextAct]) {\n      state.unlockedStages.add(ACTIVITY_META[nextAct].stage);\n    }\n    updateProgress(act);\n  }\n\n  function nextActivity(next) {\n    const current = state.currentAct;\n    completeActivity(current);\n    showActivity(next, {force:true});\n  }\n\n  // ---- tiny SFX manager: no SpeechSynthesis ----\n  const AudioCtx = window.AudioContext || window.webkitAudioContext;\n  let audioCtx = null;\n  let volume = .7;\n  function tone(freq=700, duration=.12, type='sine') {\n    try {\n      audioCtx ||= new AudioCtx();\n      if (audioCtx.state === 'suspended') audioCtx.resume();\n      const o = audioCtx.createOscillator();\n      const g = audioCtx.createGain();\n      const now = audioCtx.currentTime;\n      o.type = type;\n      o.frequency.setValueAtTime(freq, now);\n      g.gain.setValueAtTime(.18 * volume, now);\n      g.gain.exponentialRampToValueAtTime(.001, now+duration);\n      o.connect(g); g.connect(audioCtx.destination);\n      o.start(now); o.stop(now+duration+.02);\n    } catch(e) {}\n  }\n  const sfx = {\n    good(){ tone(1046,.15); setTimeout(()=>tone(1318,.22),90); },\n    bad(){ tone(220,.12,'triangle'); },\n    clack(){ tone(260,.08,'square'); },\n    stamp(){ tone(520,.07,'square'); },\n    pop(){ tone(620,.08); }\n  };\n\n  // ---- image diagnostics ----\n  function attachImageDiagnostics() {\n    document.querySelectorAll('img').forEach(img => {\n      img.addEventListener('error', () => {\n        console.error('[IMAGE LOAD FAILED]', img.getAttribute('src'), 'resolved=', img.src);\n        img.dataset.loadFailed = '1';\n      });\n      img.addEventListener('load', () => {\n        console.log('[IMAGE OK]', img.getAttribute('src'));\n      }, {once:true});\n    });\n  }\n\n  // ---- Level 1 character renderer ----\n  const baseCandidates = [\n    'assets/characters/bin/bin_base_neutral.svg',\n    'assets/characters/bin/bin_base.svg',\n    'assets/characters/bin_base.svg'\n  ];\n  function loadFirstWorking(img, candidates, idx=0) {\n    if (idx >= candidates.length) {\n      const box = document.createElement('div');\n      box.className = 'asset-load-error';\n      box.textContent = 'Thiếu artwork Bé Bin trong assets/characters/bin/. App vẫn mở được nhưng cần bổ sung asset nhân vật.';\n      img.replaceWith(box);\n      return;\n    }\n    img.onerror = () => loadFirstWorking(img, candidates, idx+1);\n    img.src = candidates[idx];\n  }\n  function ensureBinRenderer() {\n    const mount = el('bin-character-mount-lvl1');\n    if (!mount || mount.dataset.runtimeReady === '1') return;\n    mount.dataset.runtimeReady = '1';\n    mount.innerHTML = '';\n\n    const base = document.createElement('img');\n    base.className = 'bin-runtime-base';\n    base.alt = 'Bé Bin';\n    mount.appendChild(base);\n    loadFirstWorking(base, baseCandidates);\n\n    ['shirt','pants','shoes'].forEach(type => {\n      const layer = document.createElement('img');\n      layer.id = `runtime-bin-${type}`;\n      layer.className = `bin-runtime-layer ${type}`;\n      layer.alt = '';\n      layer.style.display = 'none';\n      mount.appendChild(layer);\n    });\n  }\n  function setOutfitLayer(type, src) {\n    const layer = el(`runtime-bin-${type}`);\n    if (!layer) return;\n    layer.src = src;\n    layer.style.display = 'block';\n    state.outfit[type] = src;\n  }\n\n  // ---- Activity 1 ----\n  function bindActivity1() {\n    document.querySelectorAll('#act-1 [data-clothing-item=\"true\"]').forEach(btn => {\n      btn.addEventListener('click', () => {\n        const fit = btn.dataset.fit;\n        const typeRaw = btn.dataset.type;\n        if (fit !== 'soft') {\n          sfx.bad();\n          showPrompt('Mẹ', 'Món này hơi bất tiện. Con thử món khác nhé!');\n          return;\n        }\n        const type = typeRaw === 'shirt' ? 'shirt' : typeRaw === 'pants' ? 'pants' : typeRaw === 'shoes' ? 'shoes' : null;\n        if (!type) return;\n        const img = btn.querySelector('img');\n        if (!img) return;\n        setOutfitLayer(type, img.getAttribute('src'));\n        btn.classList.add('runtime-selected');\n        sfx.good();\n        showPrompt('Mẹ', 'Đúng rồi! Món này mềm và dễ vận động.');\n        if (state.outfit.shirt && state.outfit.pants && state.outfit.shoes) {\n          completeActivity(1);\n          showFeedback(1);\n        }\n      });\n    });\n  }\n\n  // ---- Activity 2 ----\n  function bindActivity2() {\n    const packButtons = [...document.querySelectorAll('#act-2 [data-luggage-item=\"true\"]')];\n    const requiredPack = packButtons.filter(b => b.dataset.category === 'PACK').length;\n    packButtons.forEach(btn => {\n      btn.addEventListener('click', () => {\n        const cat = btn.dataset.category;\n        if (cat === 'PACK') {\n          if (btn.classList.contains('runtime-packed')) return;\n          btn.classList.add('runtime-packed');\n          state.packed.add(btn);\n          sfx.good();\n          showPrompt('Bố', 'Ừ! Món này mình xếp vào vali nhé.');\n          const inner = el('suitcase-inner-lvl2');\n          const im = btn.querySelector('img');\n          if (inner && im) {\n            const clone = im.cloneNode(true);\n            clone.style.width='58px'; clone.style.height='58px'; clone.style.objectFit='contain';\n            inner.appendChild(clone);\n          }\n          if (state.packed.size >= requiredPack) {\n            completeActivity(2); showFeedback(2);\n          }\n        } else if (cat === 'ASK_PARENT') {\n          sfx.pop(); showPrompt('Bố', 'Món này mình hỏi Ba Mẹ trước nhé!');\n        } else {\n          sfx.bad(); showPrompt('Bố', 'Món này để Ba Mẹ giúp mình xử lý nhé.');\n        }\n      });\n    });\n  }\n\n  function bindSimpleActivities() {\n    // Act 3\n    el('btn-show-ticket-3')?.addEventListener('click', () => {\n      sfx.stamp();\n      showPrompt('Mẹ', 'Vé của Bin đã được kiểm tra rồi!');\n      completeActivity(3); showFeedback(3);\n    });\n\n    // Act 4\n    document.querySelectorAll('#act-4 .xray-item-tile').forEach((tile, i) => {\n      tile.addEventListener('click', () => {\n        if (tile.classList.contains('runtime-checked')) return;\n        tile.classList.add('runtime-checked');\n        state.xrayChecked.add(i);\n        sfx.good();\n        if (state.xrayChecked.size >= 3) { completeActivity(4); showFeedback(4); }\n      });\n    });\n\n    // Act 5\n    el('btn-walk-gate-5')?.addEventListener('click', () => {\n      sfx.good(); completeActivity(5); showFeedback(5);\n    });\n\n    // Act 6\n    document.querySelectorAll('#act-6 .gate-hud-btn').forEach(btn => {\n      btn.addEventListener('click', () => {\n        if (btn.dataset.gate === '03') {\n          btn.classList.add('runtime-correct');\n          sfx.good(); showPrompt('Bố','Đúng rồi! Cổng 03 đây rồi!');\n          completeActivity(6); showFeedback(6);\n        } else {\n          sfx.bad(); showPrompt('Bố','Con nhìn lại số trên vé nhé!');\n        }\n      });\n    });\n\n    // Act 7\n    el('btn-buckle-action-7')?.addEventListener('click', () => {\n      const img = el('scene-img-act-7');\n      if (img) img.src = 'assets/scenes/scene_act7_buckled.svg';\n      sfx.clack(); completeActivity(7); showFeedback(7);\n    });\n\n    // Act 8\n    el('btn-drink-action-8')?.addEventListener('click', () => {\n      sfx.good(); showPrompt('Bin','Tai Bin dễ chịu hơn rồi!');\n      completeActivity(8); showFeedback(8);\n    });\n\n    // Act 9\n    document.querySelectorAll('#act-9 .morph-cloud-btn').forEach((btn,i) => {\n      btn.addEventListener('click', () => {\n        state.clouds.add(i);\n        btn.classList.add('runtime-selected');\n        sfx.good();\n        showPrompt('Bin', `Bin thấy giống ${btn.dataset.name || 'một hình thật vui'}! Còn con thấy giống gì?`);\n        if (state.clouds.size >= 3) { completeActivity(9); showFeedback(9); }\n      });\n    });\n\n    // Act 10\n    document.querySelectorAll('#act-10 .volume-act-btn').forEach(btn => {\n      btn.addEventListener('click', () => {\n        if (btn.dataset.level === 'whisper') {\n          sfx.good(); completeActivity(10); showFeedback(10);\n        } else if (btn.dataset.level === 'medium') {\n          sfx.pop(); showPrompt('Mẹ','Nhỏ hơn một chút nữa nhé!');\n        } else {\n          sfx.bad(); showPrompt('Mẹ','Ơ, hơi to rồi. Con thử nhỏ hơn nhé!');\n        }\n      });\n    });\n\n    // Act 11\n    el('btn-tuck-feet')?.addEventListener('click', () => {\n      const img = el('scene-img-act-11');\n      if (img) img.src = 'assets/scenes/scene_act11_feet.svg';\n      sfx.good(); completeActivity(11); showFeedback(11);\n    });\n\n    // Act 13\n    document.querySelectorAll('#act-13 .real-suitcase-card').forEach(btn => {\n      btn.addEventListener('click', () => {\n        if (btn.dataset.isBin === 'true') {\n          sfx.good(); completeActivity(13);\n          el('golden-medal-modal')?.classList.add('show');\n        } else {\n          btn.classList.remove('runtime-wrong');\n          void btn.offsetWidth;\n          btn.classList.add('runtime-wrong');\n          sfx.bad(); showPrompt('Bố','Vali này của bạn khác rồi. Con tìm lại nhé!');\n        }\n      });\n    });\n  }\n\n  function armLandingWait() {\n    const btn = el('unbuckle-latch-btn');\n    if (!btn) return;\n    btn.disabled = true;\n    btn.style.opacity = '.6';\n    btn.innerHTML = '<span>⏳ Máy bay đang chạy vào bãi đỗ...</span>';\n    showPrompt('Bố','Máy bay đang chạy vào chỗ đỗ. Bin vẫn ngồi yên và giữ dây an toàn nhé!');\n    if (state.activity12Timer) clearTimeout(state.activity12Timer);\n    state.activity12Timer = setTimeout(() => {\n      btn.disabled = false;\n      btn.style.opacity = '1';\n      btn.innerHTML = '<span>🔓 Máy bay đã dừng hẳn — mở dây an toàn</span>';\n      showPrompt('Mẹ','Máy bay dừng hẳn rồi. Bây giờ mình mới mở dây nhé!');\n    }, state.reducedMotion ? 700 : 2500);\n\n    btn.onclick = () => {\n      if (btn.disabled) return;\n      sfx.clack();\n      completeActivity(12); showFeedback(12);\n    };\n  }\n\n  function bindNavigation() {\n    document.querySelectorAll('.btn-start-activity').forEach(btn => {\n      btn.addEventListener('click', () => startActivity(Number(btn.dataset.act)));\n    });\n    document.querySelectorAll('.btn-next-activity').forEach(btn => {\n      btn.addEventListener('click', () => nextActivity(Number(btn.dataset.next)));\n    });\n\n    document.querySelectorAll('.stage-dot').forEach(dot => {\n      dot.addEventListener('click', () => {\n        if (dot.classList.contains('locked')) return;\n        const stage = Number(dot.dataset.stage);\n        const first = Object.entries(ACTIVITY_META).find(([,m]) => m.stage === stage);\n        if (first) showActivity(Number(first[0]), {force:true});\n      });\n    });\n  }\n\n  function bindParentGate() {\n    const gate = el('btn-parent-gate');\n    const modal = el('parent-modal');\n    const circle = el('parent-ring-circle');\n   