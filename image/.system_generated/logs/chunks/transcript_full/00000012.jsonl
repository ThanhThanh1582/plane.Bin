{"step_index":205,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-08-26T04:46:52Z","thinking":"**Reviewing Implementation**\n\nI'm currently focused on ensuring `js/app.js` integrates smoothly with the new bin slot elements and `.clothes-tile-art`. I'm going through the `tryDressItem(tile)` function to make sure the dressing logic accounts for the changes in the HTML structure. I'm verifying that items are being correctly assigned to the intended slots.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"/**\n * app.js - Main Controller for \"Cùng Bé Bin Đi Máy Bay\" (8 Levels)\n * Đồng bộ toàn diện 100% với HTML/CSS/Audio/Effects & Golden Sample Level 1\n */\n\nclass KidFlightApp {\n    constructor() {\n        this.currentScreen = 1;\n        this.totalScreens = 8;\n        this.maxUnlockedLevel = 1;\n        \n        // Ngăn chặn duplicate event listeners khi quay lại màn\n        this.levelInitialized = {\n            1: false, 2: false, 3: false, 4: false,\n            5: false, 6: false, 7: false, 8: false\n        };\n\n        // Trạng thái các Level\n        this.level1Dressed = { shirt: false, pants: false, shoes: false };\n        this.level2Packed = 0;\n        this.level3Steps = { checkin: false, xrayCount: 0, gate: false };\n        this.level4Completed = false;\n        this.level5Belt = { inserted: false, earRelieved: false };\n        this.level6Clouds = { c1: false, c2: false, c3: false, c4: false };\n        this.level7Tasks = { volume: false, leg: false };\n        this.level8State = { planeStopped: false, unbuckled: false, baggage: false };\n\n        this.parentHoldStart = 0;\n        this.parentHoldReqId = null;\n\n        this.init();\n    }\n\n    init() {\n        this.bindGlobalEvents();\n        this.initLevel(1);\n        this.showScreen(1);\n    }\n\n    // --- PARENT PROMPT API (HIỂN THỊ CÂU THOẠI TRÊN BIỂN BÁO BA MẸ ĐỌC) ---\n    showParentPrompt(speaker, text, avatarEmojiOrImg = null) {\n        if (window.dialogueMgr) {\n            window.dialogueMgr.show(speaker, text, avatarEmojiOrImg);\n        }\n    }\n\n    // --- NAVIGATION & STAGE LOCKING CONTROLLER ---\n    unlockLevel(levelNum) {\n        if (levelNum > this.maxUnlockedLevel && levelNum <= this.totalScreens) {\n            this.maxUnlockedLevel = levelNum;\n            const dot = document.querySelector(`.stage-dot[data-screen=\"${levelNum}\"]`);\n            if (dot) {\n                dot.classList.remove('locked');\n            }\n        }\n    }\n\n    showScreen(screenNum) {\n        if (screenNum < 1 || screenNum > this.totalScreens) return;\n\n        // Dừng động cơ máy bay nếu rời Level 5\n        if (this.currentScreen === 5 && screenNum !== 5) {\n            if (window.audioMgr) window.audioMgr.stopEngineSound();\n        }\n\n        this.currentScreen = screenNum;\n        this.unlockLevel(screenNum);\n\n        // Cập nhật DOM screen\n        document.querySelectorAll('.screen').forEach((scr, idx) => {\n            if (idx + 1 === screenNum) {\n                scr.classList.add('active');\n            } else {\n                scr.classList.remove('active');\n            }\n        });\n\n        // Cập nhật Stage dots (chỉ mở khóa màn đã chơi hoặc hiện tại)\n        document.querySelectorAll('.stage-dot').forEach((dot, idx) => {\n            const level = idx + 1;\n            dot.classList.remove('active', 'completed', 'locked');\n\n            if (level === screenNum) {\n                dot.classList.add('active');\n            } else if (level < screenNum || level <= this.maxUnlockedLevel) {\n                dot.classList.add('completed');\n            } else {\n                dot.classList.add('locked');\n            }\n        });\n\n        // Khởi tạo sự kiện màn nếu chưa khởi tạo\n        this.initLevel(screenNum);\n\n        // Hiển thị lời thoại ban đầu chuẩn của màn chơi\n        this.setInitialScreenDialogue(screenNum);\n    }\n\n    setInitialScreenDialogue(screenNum) {\n        switch (screenNum) {\n            case 1:\n                this.showParentPrompt('Mẹ', '“Bin sắp đi máy bay rồi. Con chọn bộ đồ nào giúp Bin dễ vận động nhé!”', '👩');\n                break;\n            case 2:\n                this.showParentPrompt('Bố', '“Bin mang gì đi máy bay nhỉ? Con xếp vali giúp Bin nhé!”', '👨');\n                break;\n            case 3:\n                this.showParentPrompt('Mẹ', '“Đến chỗ kiểm tra an ninh rồi. Bin đi cùng Ba Mẹ và làm theo hướng dẫn nhé!”', '👩');\n                break;\n            case 4:\n                this.showParentPrompt('Bố', '“Vé của Bin ghi số 03. Con tìm cổng số 03 nhé!”', '👨');\n                break;\n            case 5:\n                this.showParentPrompt('Mẹ', '“Con giúp Bin cài dây an toàn nhé!”', '👩');\n                break;\n            case 6:\n                this.showParentPrompt('Bin', '“Bin thấy đám mây giống hình gì nhỉ? Con nhìn cùng Bin nhé!”', '🧒');\n                break;\n            case 7:\n                this.showParentPrompt('Mẹ', '“Trên máy bay mình nói nhỏ vừa đủ nghe nhé. Con giúp Bin nào!”', '👩');\n                break;\n            case 8:\n                // Level 8: SAFETY BLOCKER - Máy bay chạy vào chỗ đỗ trước\n                this.level8State.planeStopped = false;\n                this.level8State.unbuckled = false;\n                this.showParentPrompt('Bố', '“Máy bay đang chạy vào chỗ đỗ. Bin vẫn ngồi yên và giữ dây an toàn nhé!”', '👨');\n                \n                const unbuckleBtn = document.getElementById('unbuckle-latch-btn');\n                if (unbuckleBtn) {\n                    unbuckleBtn.setAttribute('disabled', 'true');\n                    unbuckleBtn.style.opacity = '0.6';\n                    unbuckleBtn.style.borderColor = '#FF5252';\n                    unbuckleBtn.innerHTML = '<span>⏳ Máy bay đang chạy vào bãi đỗ...</span>';\n                }\n\n                setTimeout(() => {\n                    this.level8State.planeStopped = true;\n                    if (unbuckleBtn) {\n                        unbuckleBtn.removeAttribute('disabled');\n                        unbuckleBtn.style.opacity = '1';\n                        unbuckleBtn.style.borderColor = '#00E676';\n                        unbuckleBtn.innerHTML = '<span>🔓 Máy bay đã dừng hẳn — Mở dây an toàn</span>';\n                    }\n                    this.showParentPrompt('Mẹ', '“Máy bay dừng hẳn rồi. Bây giờ mình mới mở dây nhé!”', '👩');\n                }, 2600);\n                break;\n        }\n    }\n\n    // --- GLOBAL EVENTS & CỔNG BA MẸ CONTROLLER ---\n    bindGlobalEvents() {\n        const parentBtn = document.getElementById('btn-parent-gate');\n        const holdCircle = document.getElementById('parent-ring-circle');\n        const modal = document.getElementById('parent-modal');\n        const closeModalBtn = document.getElementById('btn-close-parent');\n\n        // Cổng Ba Mẹ: Giữ 3 giây\n        if (parentBtn && holdCircle) {\n            const startHold = (e) => {\n                e.preventDefault();\n                this.parentHoldStart = Date.now();\n                const totalHold = 3000;\n\n                const updateRing = () => {\n                    const elapsed = Date.now() - this.parentHoldStart;\n                    const progress = Math.min(1, elapsed / totalHold);\n                    const offset = 175 - (175 * progress);\n                    holdCircle.style.strokeDashoffset = offset;\n\n                    if (progress >= 1) {\n                        if (window.audioMgr) window.audioMgr.playTing();\n                        modal.classList.add('open');\n                        resetHold();\n                    } else {\n                        this.parentHoldReqId = requestAnimationFrame(updateRing);\n                    }\n                };\n\n                this.parentHoldReqId = requestAnimationFrame(updateRing);\n            };\n\n            const resetHold = () => {\n                if (this.parentHoldReqId) cancelAnimationFrame(this.parentHoldReqId);\n                holdCircle.style.strokeDashoffset = 175;\n            };\n\n            parentBtn.addEventListener('pointerdown', startHold);\n            parentBtn.addEventListener('pointerup', resetHold);\n            parentBtn.addEventListener('pointerleave', resetHold);\n            parentBtn.addEventListener('pointercancel', resetHold);\n        }\n\n        if (closeModalBtn && modal) {\n            closeModalBtn.addEventListener('click', () => {\n                if (window.audioMgr) window.audioMgr.playPop();\n                modal.classList.remove('open');\n            });\n        }\n\n        // Tùy chỉnh trong Cổng Ba Mẹ\n        const volSlider = document.getElementById('setting-volume');\n        if (volSlider) {\n            volSlider.addEventListener('input', (e) => {\n                if (window.audioMgr) window.audioMgr.volume = parseFloat(e.target.value);\n            });\n        }\n\n        const motionToggle = document.getElementById('setting-reduced-motion');\n        if (motionToggle) {\n            motionToggle.addEventListener('change', (e) => {\n                if (window.effectsMgr) window.effectsMgr.reducedMotion = e.target.checked;\n            });\n        }\n\n        const resetBtn = document.getElementById('btn-reset-app');\n        if (resetBtn) {\n            resetBtn.addEventListener('click', () => {\n                window.location.reload();\n            });\n        }\n\n        // Nút chọn nhanh màn chơi trong Cổng Ba Mẹ (Ba Mẹ được quyền nhảy tự do)\n        document.querySelectorAll('.jump-btn').forEach(btn => {\n            btn.addEventListener('click', () => {\n                const target = parseInt(btn.getAttribute('data-level'), 10);\n                if (target) {\n                    if (window.audioMgr) window.audioMgr.playPop();\n                    modal.classList.remove('open');\n                    this.unlockLevel(target);\n                    this.showScreen(target);\n                }\n            });\n        });\n\n        // Stage dots điều hướng: Chỉ cho phép click màn hiện tại và màn đã mở khóa\n        document.querySelectorAll('.stage-dot').forEach((dot) => {\n            dot.addEventListener('click', () => {\n                const targetScreen = parseInt(dot.getAttribute('data-screen'), 10);\n                if (!dot.classList.contains('locked') && targetScreen && targetScreen <= this.maxUnlockedLevel) {\n                    if (window.audioMgr) window.audioMgr.playPop();\n                    this.showScreen(targetScreen);\n                }\n            });\n        });\n    }\n\n    initLevel(levelNum) {\n        if (this.levelInitialized[levelNum]) return;\n        this.levelInitialized[levelNum] = true;\n\n        switch (levelNum) {\n            case 1: this.initLevel1(); break;\n            case 2: this.initLevel2(); break;\n            case 3: this.initLevel3(); break;\n            case 4: this.initLevel4(); break;\n            case 5: this.initLevel5(); break;\n            case 6: this.initLevel6(); break;\n            case 7: this.initLevel7(); break;\n            case 8: this.initLevel8(); break;\n        }\n    }\n\n    // ==========================================================================\n    // LEVEL 1: TRANG PHỤC THOẢI MÁI (#screen-1 [data-clothing-item=\"true\"])\n    // ==========================================================================\n    initLevel1() {\n        const clothesTiles = document.querySelectorAll('#screen-1 [data-clothing-item=\"true\"]');\n        const binAvatar = document.getElementById('bin-dress-target');\n        const binMainImg = document.getElementById('bin-main-art');\n        const btnNext1 = document.getElementById('btn-next-level-1');\n\n        const tryDressItem = (tile) => {\n            if (tile.classList.contains('worn')) return;\n            const isFit = tile.getAttribute('data-fit') === 'soft';\n            const type = tile.getAttribute('data-type');\n            const binRect = binAvatar.getBoundingClientRect();\n\n            if (isFit) {\n                tile.classList.add('worn');\n                tile.style.display = 'none';\n\n                if (type === 'shirt') {\n                    const badge = document.getElementById('bin-slot-shirt');\n                    if (badge) {\n                        badge.textContent = 'Áo ✓';\n                        badge.classList.add('checked');\n                    }\n                    this.level1Dressed.shirt = true;\n                } else if (type === 'pants') {\n                    const badge = document.getElementById('bin-slot-pants');\n                    if (badge) {\n                        badge.textContent = 'Quần ✓';\n                        badge.classList.add('checked');\n                    }\n                    this.level1Dressed.pants = true;\n                } else if (type === 'shoes') {\n                    const badge = document.getElementById('bin-slot-shoes');\n                    if (badge) {\n                        badge.textContent = 'Giày ✓';\n                        badge.classList.add('checked');\n                    }\n                    this.level1Dressed.shoes = true;\n                }\n\n                if (window.effectsMgr) {\n                    window.effectsMgr.burstStarsAt(binRect.left + binRect.width / 2, binRect.top + binRect.height / 2);\n                }\n                if (window.audioMgr) window.audioMgr.playTing();\n\n                this.showParentPrompt('Mẹ', '“Đúng rồi! Bộ này mềm và dễ vận động.”', '👩');\n\n                if (this.level1Dressed.shirt && this.level1Dressed.pants && this.level1Dressed.shoes) {\n                    if (binMainImg) {\n                        binMainImg.style.transform = 'scale(1.1) translateY(-6px)';\n                    }\n                    binAvatar.classList.add('gentle-bounce');\n                    this.showParentPrompt('Mẹ', '“Bin mặc đồ xong rồi, cùng đi xếp vali nào!”', '👩');\n                    this.unlockLevel(2);\n                    if (btnNext1) {\n                        btnNext1.classList.remove('hidden');\n                        btnNext1.classList.add('pop-in');\n                    }\n                }\n            } else {\n                tile.style.transition = 'transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1)';\n                tile.style.transform = 'translate(0px, 0px)';\n                if (window.audioMgr) window.audioMgr.playBoing();\n                this.showParentPrompt('Bố', '“Món này hơi bất tiện. Con thử món khác nhé!”', '👨');\n            }\n        };\n\n        clothesTiles.forEach(tile => {\n            let startX = 0, startY = 0;\n            let isDragging = false;\n\n            const onDown = (e) => {\n                if (tile.classList.contains('worn')) return;\n                isDragging = true;\n                tile.setPointerCapture(e.pointerId);\n                startX = e.clientX;\n                startY = e.clientY;\n                tile.style.zIndex = '999';\n            };\n\n            const onMove = (e) => {\n                if (!isDragging) return;\n                const dx = e.clientX - startX;\n                const dy = e.clientY - startY;\n                tile.style.transform = `translate(${dx}px, ${dy}px) scale(1.18)`;\n            };\n\n            const onUp = (e) => {\n                if (!isDragging) return;\n                isDragging = false;\n                tile.releasePointerCapture(e.pointerId);\n\n                const tileRect = tile.getBoundingClientRect();\n                const binRect = binAvatar.getBoundingClientRect();\n\n                const isOver = !(\n                    tileRect.right < binRect.left ||\n                    tileRect.left > binRect.right ||\n                    tileRect.bottom < binRect.top ||\n                    tileRect.top > binRect.bottom\n                );\n\n                if (isOver) {\n                    tryDressItem(tile);\n                } else {\n                    tile.style.transition = 'transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1)';\n                    tile.style.transform = 'translate(0px, 0px)';\n                }\n            };\n\n            tile.addEventListener('pointerdown', onDown);\n            tile.addEventListener('pointermove', onMove);\n            tile.addEventListener('pointerup', onUp);\n            tile.addEventListener('pointercancel', onUp);\n\n            tile.addEventListener('click', () => {\n                if (!tile.classList.contains('worn')) {\n                    tryDressItem(tile);\n                }\n            });\n        });\n\n        if (btnNext1) {\n            btnNext1.onclick = () => {\n                if (window.audioMgr) window.audioMgr.playPop();\n                this.showScreen(2);\n            };\n        }\n    }\n\n    // ==========================================================================\n    // LEVEL 2: CHIẾC VALI KỲ DIỆU (#screen-2 [data-luggage-item=\"true\"])\n    // ==========================================================================\n    initLevel2() {\n        const luggageItems = document.querySelectorAll('#screen-2 [data-luggage-item=\"true\"]');\n        const suitcase = document.getElementById('suitcase-target-lvl2');\n        const suitcaseInner = document.getElementById('suitcase-inner-lvl2');\n        const btnNext2 = document.getElementById('btn-next-level-2');\n\n        const tryPackLuggage = (item) => {\n            if (item.classList.contains('packed')) return;\n            const category = item.getAttribute('data-category');\n            const suitcaseRect = suitcase.getBoundingClientRect();\n\n            if (category === 'PACK') {\n                item.classList.add('packed');\n                item.style.display = 'none';\n\n                const icon = item.querySelector('.item-icon');\n                if (icon.tagName === 'IMG') {\n                    const imgClone = document.createElement('img');\n                    imgClone.src = icon.src;\n                    imgClone.style.width = '48px';\n                    imgClone.style.height = '48px';\n                    imgClone.style.objectFit = 'contain';\n                    imgClone.className = 'pop-in';\n                    suitcaseInner.appendChild(imgClone);\n                } else {\n                    const iconSpan = document.createElement('span');\n                    iconSpan.textContent = icon.textContent;\n                    iconSpan.style.fontSize = '34px';\n                    iconSpan.className = 'pop-in';\n                    suitcaseInner.appendChild(iconSpan);\n                }\n\n                this.level2Packed++;\n\n                if (window.effectsMgr) {\n                    window.effectsMgr.burstStarsAt(suitcaseRect.left + suitcaseRect.width / 2, suitcaseRect.top + suitcaseRect.height / 2);\n                }\n                if (window.audioMgr) window.audioMgr.playTing();\n\n                this.showParentPrompt('Mẹ', '“Ừ! Món này mình xếp vào vali nhé.”', '👩');\n\n                if (this.level2Packed >= 3) {\n                    this.showParentPrompt('Mẹ', '“Vali của Bin đã sẵn sàng rồi! Cùng đến sân bay thôi!”', '👩');\n                    this.unlockLevel(3);\n                    if (btnNext2) {\n                        btnNext2.classList.remove('hidden');\n                        btnNext2.classList.add('pop-in');\n                    }\n                }\n            } else if (category === 'ASK_PARENT') {\n                item.style.transition = 'transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1)';\n                item.style.transform = 'translate(0px, 0px)';\n                if (window.audioMgr) window.audioMgr.playPop();\n                this.showParentPrompt('Bố', '“Món này mình hỏi Ba Mẹ trước nhé!”', '👨');\n            } else {\n                // LEAVE_HOME\n                item.style.transition = 'transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1)';\n                item.style.transform = 'translate(0px, 0px)';\n                if (window.audioMgr) window.audioMgr.playBoing();\n                this.showParentPrompt('Bố', '“Món này để Ba Mẹ giúp mình xử lý nhé.”', '👨');\n            }\n        };\n\n        luggageItems.forEach(item => {\n            let startX = 0, startY = 0;\n            let isDragging = false;\n\n            const onDown = (e) => {\n                if (item.classList.contains('packed')) return;\n                isDragging = true;\n                item.setPointerCapture(e.pointerId);\n                startX = e.clientX;\n                startY = e.clientY;\n                item.style.zIndex = '999';\n            };\n\n            const onMove = (e) => {\n                if (!isDragging) return;\n                const dx = e.clientX - startX;\n                const dy = e.clientY - startY;\n                item.style.transform = `translate(${dx}px, ${dy}px) scale(1.18)`;\n            };\n\n            const onUp = (e) => {\n                if (!isDragging) return;\n                isDragging = false;\n                item.releasePointerCapture(e.pointerId);\n\n                const itemRect = item.getBoundingClientRect();\n                const suitcaseRect = suitcase.getBoundingClientRect();\n\n                const isOver = !(\n                    itemRect.right < suitcaseRect.left ||\n                    itemRect.left > suitcaseRect.right ||\n                    itemRect.bottom < suitcaseRect.top ||\n                    itemRect.top > suitcaseRect.bottom\n                );\n\n                if (isOver) {\n                    tryPackLuggage(item);\n                } else {\n                    item.style.transition = 'transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1)';\n                    item.style.transform = 'translate(0px, 0px)';\n                }\n            };\n\n            item.addEventListener('pointerdown', onDown);\n            item.addEventListener('pointermove', onMove);\n            item.addEventListener('pointerup', onUp);\n            item.addEventListener('pointercancel', onUp);\n\n            item.addEventListener('click', () => {\n                if (!item.classList.contains('packed')) {\n                    tryPackLuggage(item);\n                }\n            });\n        });\n\n        if (btnNext2) {\n            btnNext2.onclick = () => {\n                if (window.audioMgr) window.audioMgr.playPop();\n                this.showScreen(3);\n            };\n        }\n    }\n\n    // ==========================================================================\n    // LEVEL 3: KIỂM TRA AN NINH\n    // ==========================================================================\n    initLevel3() {\n        const passCard = document.getElementById('pass-card-lvl3');\n        const stampBadge = document.getElementById('stamp-badge-lvl3');\n        const xrayBoxes = document.querySelectorAll('#screen-3 .xray-tap-box');\n        const gate = document.getElementById('gate-detector-lvl3');\n        const lamps = document.querySelectorAll('#screen-3 .gate-lamp-led');\n        const binWalker = document.getElementById('bin-walker-lvl3');\n        const btnNext3 = document.getElementById('btn-next-level-3');\n\n        if (passCard) {\n            passCard.onclick = () => {\n                if (this.level3Steps.checkin) return;\n                this.level3Steps.checkin = true;\n                if (stampBadge) stampBadge.classList.add('stamped');\n                if (window.audioMgr) window.audioMgr.playStamp();\n                this.showParentPrompt('Tiếp viên', '“Vé của Bin xong rồi! Giờ soi chiếu vali nhé.”', '👩‍✈️');\n                this.checkLevel3Completion();\n            };\n        }\n\n        xrayBoxes.forEach(box => {\n            box.onclick = () => {\n                if (box.getAttribute('data-revealed') === 'true') return;\n                box.setAttribute('data-revealed', 'true');\n                box.textContent = box.getAttribute('data-item');\n                box.style.background = '#FFF9C4';\n                this.level3Steps.xrayCount++;\n\n                if (window.audioMgr) window.audioMgr.playTing();\n                if (window.effectsMgr) {\n                    const r = box.getBoundingClientRect();\n                    window.effectsMgr.burstStarsAt(r.left + r.width / 2, r.top + r.height / 2);\n                }\n\n                if (this.level3Steps.xrayCount >= 3) {\n                    this.showParentPrompt('Mẹ', '“Vali của Bin an toàn rồi! Chạm để Bin qua cổng nhé.”', '👩');\n                    this.checkLevel3Completion();\n                }\n            };\n        });\n\n        if (gate) {\n            gate.onclick = () => {\n                if (this.level3Steps.gate) return;\n                this.level3Steps.gate = true;\n\n                lamps.forEach(l => l.classList.add('green-flash'));\n                if (binWalker) binWalker.style.transform = 'translateY(-18px) scale(1.15)';\n\n                if (window.audioMgr) window.audioMgr.playBeepBoop();\n                this.showParentPrompt('Mẹ', '“Bíp boong! Bin qua cửa an toàn rồi!”', '👩');\n                this.checkLevel3Completion();\n            };\n        }\n\n        if (btnNext3) {\n            btnNext3.onclick = () => {\n                if (window.audioMgr) window.audioMgr.playPop();\n                this.showScreen(4);\n            };\n        }\n    }\n\n    checkLevel3Completion() {\n        const btnNext3 = document.getElementById('btn-next-level-3');\n        if (this.level3Steps.checkin && this.level3Steps.xrayCount >= 3 && this.level3Steps.gate) {\n            this.unlockLevel(4);\n            if (btnNext3) {\n                btnNext3.classList.remove('hidden');\n                btnNext3.classList.add('pop-in');\n            }\n        }\n    }\n\n    // ==========================================================================\n    // LEVEL 4: RA CỔNG BAY (TẬP TRUNG TÌM CỔNG 03)\n    // ==========================================================================\n    initLevel4() {\n        const gatePillars = document.querySelectorAll('#screen-4 .gate-pillar');\n        const btnNext4 = document.getElementById('btn-next-level-4');\n\n        gatePillars.forEach(pillar => {\n            pillar.onclick = () => {\n                const targetGate = pillar.getAttribute('data-gate');\n\n                if (targetGate === '03') {\n                    this.level4Completed = true;\n                    pillar.classList.add('matched');\n\n                    if (window.effectsMgr) {\n                        const r = pillar.getBoundingClientRect();\n                        window.effectsMgr.burstStarsAt(r.left + r.width / 2, r.top + r.height / 2);\n                    }\n                    if (window.audioMgr) window.audioMgr.playConnect();\n\n                    this.showParentPrompt('Tiếp viên', '“Đúng Cổng 03 rồi! Chào mừng Bin lên máy bay!”', '👩‍✈️');\n                    this.unlockLevel(5);\n\n                    if (btnNext4) {\n                        btnNext4.classList.remove('hidden');\n                        btnNext4.classList.add('pop-in');\n                    }\n                } else {\n                    if (window.audioMgr) window.audioMgr.playBoing();\n                    this.showParentPrompt('Bố', '“Chưa đúng số trên vé rồi, con tìm lại nhé!”', '👨');\n                }\n            };\n        });\n\n        if (btnNext4) {\n            btnNext4.onclick = () => {\n                if (window.audioMgr) window.audioMgr.playPop();\n                this.showScreen(5);\n            };\n        }\n    }\n\n    // ==========================================================================\n    // LEVEL 5: HIỆP SĨ ĐAI AN TOÀN & UỐNG NƯỚC\n    // ==========================================================================\n    initLevel5() {\n        const strapLeft = document.getElementById('seatbelt-strap-lvl5');\n        const puzzleBox = document.getElementById('seatbelt-puzzle-lvl5');\n        const safetySign = document.getElementById('safety-sign-lvl5');\n        const knightCape = document.getElementById('bin-knight-cape');\n        const btnWater = doc