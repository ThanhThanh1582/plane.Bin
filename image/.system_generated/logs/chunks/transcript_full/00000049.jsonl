 Con chọn bộ đồ nào giúp Bin dễ vận động nhé!'},\n    2:{stage:2,label:'Xếp hành lý',speaker:'Bố',prompt:'Bin mang gì đi máy bay nhỉ? Con xếp vali giúp Bin nhé!'},\n    3:{stage:3,label:'Kiểm tra vé',speaker:'Mẹ',prompt:'Đến quầy kiểm tra rồi. Con giúp Bin đưa vé nhé!'},\n    4:{stage:3,label:'Soi hành lý',speaker:'Bố',prompt:'Bây giờ vali của Bin sẽ đi qua máy soi. Con xem bên trong có gì nhé!'},\n    5:{stage:3,label:'Cổng an ninh',speaker:'Mẹ',prompt:'Đến cổng an ninh rồi. Con giúp Bin đi qua nhé!'},\n    6:{stage:4,label:'Tìm Cổng 03',speaker:'Bố',prompt:'Vé của Bin ghi số 03. Con tìm cổng số 03 nhé!'},\n    7:{stage:5,label:'Cài dây an toàn',speaker:'Mẹ',prompt:'Bin ngồi vào ghế rồi. Con giúp Bin cài dây an toàn nhé!'},\n    8:{stage:5,label:'Giúp tai dễ chịu',speaker:'Mẹ',prompt:'Tai Bin hơi khó chịu. Bin uống một ngụm nước nhé.'},\n    9:{stage:6,label:'Ngắm mây',speaker:'Bin',prompt:'Bin thấy đám mây giống hình gì nhỉ? Con nhìn cùng Bin nhé!'},\n    10:{stage:7,label:'Nói nhỏ',speaker:'Mẹ',prompt:'Trên máy bay mình nói nhỏ vừa đủ nghe nhé.'},\n    11:{stage:7,label:'Ngồi gọn',speaker:'Bố',prompt:'Bin thu chân gọn lại để không chạm ghế phía trước nhé!'},\n    12:{stage:8,label:'Mở dây sau khi dừng',speaker:'Bố',prompt:'Máy bay đang chạy vào chỗ đỗ. Bin vẫn ngồi yên và giữ dây an toàn nhé!'},\n    13:{stage:8,label:'Nhận vali',speaker:'Bố',prompt:'Con tìm chiếc vali đỏ có hình gấu của Bin nhé!'}\n  };\n\n  const SPEAKER_ICON = { 'Mẹ':'👩', 'Bố':'👨', 'Bin':'🧒', 'Tiếp viên':'👩‍✈️' };\n\n  const state = {\n    currentAct: 1,\n    completedActs: new Set(),\n    unlockedStages: new Set([1]),\n    initialized: false,\n    activity12Timer: null,\n    outfit: {shirt:false, pants:false, shoes:false},\n    packed: new Set(),\n    xrayChecked: new Set(),\n    clouds: new Set(),\n    reducedMotion: false\n  };\n\n  function el(id) { return document.getElementById(id); }\n\n  // ---- Pure Web Audio API Synth Engine ----\n  let audioCtx = null;\n  let volume = 0.85;\n\n  function tone(freq, duration=0.12, type='sine') {\n    try {\n      const AudioCtx = window.AudioContext || window.webkitAudioContext;\n      if (!AudioCtx) return;\n      audioCtx ||= new AudioCtx();\n      if (audioCtx.state === 'suspended') audioCtx.resume();\n      const o = audioCtx.createOscillator();\n      const g = audioCtx.createGain();\n      const now = audioCtx.currentTime;\n      o.type = type;\n      o.frequency.setValueAtTime(freq, now);\n      g.gain.setValueAtTime(0.18 * volume, now);\n      g.gain.exponentialRampToValueAtTime(0.001, now + duration);\n      o.connect(g);\n      g.connect(audioCtx.destination);\n      o.start(now);\n      o.stop(now + duration + 0.02);\n    } catch(e) {}\n  }\n\n  const sfx = {\n    good() { tone(1046, 0.15); setTimeout(() => tone(1318, 0.22), 90); },\n    bad() { tone(220, 0.12, 'triangle'); },\n    clack() { tone(260, 0.08, 'square'); },\n    stamp() { tone(520, 0.07, 'square'); },\n    pop() { tone(620, 0.08); }\n  };\n\n  function showPrompt(speaker, text) {\n    const p = el('parent-prompt-text');\n    const a = el('parent-prompt-avatar');\n    if (p) p.textContent = `“${text}”`;\n    if (a) a.textContent = SPEAKER_ICON[speaker] || '🌟';\n  }\n\n  function showFeedback(act) {\n    const f = el(`feedback-act-${act}`);\n    if (f) f.classList.remove('hidden');\n  }\n\n  function completeActivity(act) {\n    state.completedActs.add(act);\n    const meta = ACTIVITY_META[act];\n    if (meta) {\n      const nextAct = act + 1;\n      if (ACTIVITY_META[nextAct]) {\n        const nextStage = ACTIVITY_META[nextAct].stage;\n        state.unlockedStages.add(nextStage);\n        document.querySelectorAll('.stage-dot').forEach(dot => {\n          if (Number(dot.dataset.stage) <= nextStage) dot.classList.remove('locked');\n        });\n      }\n    }\n  }\n\n  function updateProgress(act) {\n    const meta = ACTIVITY_META[act];\n    const sub = el('sub-progress-text');\n    if (sub && meta) {\n      sub.textContent = `Chặng ${meta.stage} — Hoạt động ${act}: ${meta.label}`;\n    }\n    if (meta) {\n      document.querySelectorAll('.stage-dot').forEach(dot => {\n        const s = Number(dot.dataset.stage);\n        dot.classList.remove('active');\n        if (s === meta.stage) dot.classList.add('active');\n        if (s < meta.stage || state.completedActs.has(act)) dot.classList.add('completed');\n      });\n    }\n  }\n\n  function showActivity(act) {\n    if (!ACTIVITY_META[act]) return;\n    document.querySelectorAll('.activity-container').forEach(s => s.classList.remove('active'));\n    \n    const actContainer = el(`act-${act}`);\n    if (actContainer) {\n      actContainer.classList.add('active');\n      // Show intro view by default\n      const intro = el(`intro-act-${act}`);\n      const gameplay = el(`gameplay-act-${act}`);\n      const feedback = el(`feedback-act-${act}`);\n      if (intro) intro.classList.remove('hidden');\n      if (gameplay) gameplay.classList.add('hidden');\n      if (feedback) feedback.classList.add('hidden');\n    }\n\n    state.currentAct = act;\n    updateProgress(act);\n    showPrompt(ACTIVITY_META[act].speaker, ACTIVITY_META[act].prompt);\n    window.scrollTo({top: 0, behavior: 'instant'});\n\n    if (window.binRenderer) {\n      window.binRenderer.mountAll();\n    }\n  }\n\n  function startActivity(act) {\n    const intro = el(`intro-act-${act}`);\n    const gameplay = el(`gameplay-act-${act}`);\n    if (intro) intro.classList.add('hidden');\n    if (gameplay) gameplay.classList.remove('hidden');\n\n    if (act === 12) {\n      armLandingWait();\n    }\n\n    if (window.binRenderer) {\n      window.binRenderer.mountAll();\n    }\n  }\n\n  function nextActivity(nextAct) {\n    showActivity(nextAct);\n  }\n\n  function bindActivity1() {\n    document.querySelectorAll('#act-1 [data-clothing-item=\"true\"]').forEach(btn => {\n      btn.addEventListener('click', () => {\n        const fit = btn.dataset.fit;\n        const typeRaw = btn.dataset.type;\n        if (fit !== 'soft') {\n          sfx.bad();\n          showPrompt('Mẹ', 'Món này hơi bất tiện. Con thử món khác nhé!');\n          return;\n        }\n        const type = typeRaw === 'shirt' ? 'shirt' : typeRaw === 'pants' ? 'pants' : typeRaw === 'shoes' ? 'shoes' : null;\n        if (!type) return;\n\n        if (window.binRenderer) {\n          if (type === 'shirt') window.binRenderer.setShirt('yellow');\n          if (type === 'pants') window.binRenderer.setPants('blue');\n          if (type === 'shoes') window.binRenderer.setShoes('velcro');\n        }\n\n        state.outfit[type] = true;\n        btn.classList.add('runtime-selected');\n        sfx.good();\n        showPrompt('Mẹ', 'Đúng rồi! Món này mềm và dễ vận động.');\n\n        if (state.outfit.shirt && state.outfit.pants && state.outfit.shoes) {\n          completeActivity(1);\n          showFeedback(1);\n        }\n      });\n    });\n  }\n\n  function bindActivity2() {\n    document.querySelectorAll('#act-2 [data-luggage-item=\"true\"]').forEach(btn => {\n      btn.addEventListener('click', () => {\n        if (btn.dataset.category === 'PACK') {\n          btn.classList.add('runtime-packed');\n          state.packed.add(btn);\n          sfx.good();\n          showPrompt('Bố', 'Ừ! Món này mình xếp vào vali nhé.');\n          if (state.packed.size >= 3) {\n            completeActivity(2);\n            showFeedback(2);\n          }\n        } else {\n          sfx.pop();\n          showPrompt('Bố', 'Món này mình hỏi Ba Mẹ trước nhé!');\n        }\n      });\n    });\n  }\n\n  function bindSimpleActivities() {\n    // Act 3: Kiểm tra vé\n    el('btn-show-ticket-3')?.addEventListener('click', () => {\n      sfx.stamp();\n      showPrompt('Mẹ', 'Vé của Bin đã được kiểm tra rồi!');\n      completeActivity(3);\n      showFeedback(3);\n    });\n\n    // Act 4: Soi hành lý\n    document.querySelectorAll('#act-4 .xray-item-tile').forEach((tile, i) => {\n      tile.addEventListener('click', () => {\n        state.xrayChecked.add(i);\n        tile.classList.add('runtime-checked');\n        sfx.good();\n        if (state.xrayChecked.size >= 3) {\n          completeActivity(4);\n          showFeedback(4);\n        }\n      });\n    });\n\n    // Act 5: Cổng an ninh\n    el('btn-walk-gate-5')?.addEventListener('click', () => {\n      sfx.good();\n      showPrompt('Mẹ', 'Bíp boong! Bin qua cửa an toàn rồi!');\n      completeActivity(5);\n      showFeedback(5);\n    });\n\n    // Act 6: Tìm Cổng 03\n    document.querySelectorAll('#act-6 .gate-hud-btn').forEach(btn => {\n      btn.addEventListener('click', () => {\n        if (btn.dataset.gate === '03') {\n          btn.classList.add('runtime-correct');\n          sfx.good();\n          showPrompt('Bố', 'Đúng rồi! Cổng 03 đây rồi!');\n          completeActivity(6);\n          showFeedback(6);\n        } else {\n          sfx.bad();\n          showPrompt('Bố', 'Con nhìn lại số trên vé nhé!');\n        }\n      });\n    });\n\n    // Act 7: Cài dây an toàn\n    el('btn-buckle-action-7')?.addEventListener('click', () => {\n      if (window.binRenderer) window.binRenderer.setSeatbelt('fastened');\n      sfx.clack();\n      showPrompt('Mẹ', 'CẠCH! Dây an toàn chắc chắn rồi!');\n      completeActivity(7);\n      showFeedback(7);\n    });\n\n    // Act 8: Uống nước\n    el('btn-drink-action-8')?.addEventListener('click', () => {\n      sfx.good();\n      showPrompt('Bin', 'Tai Bin dễ chịu hơn rồi!');\n      completeActivity(8);\n      showFeedback(8);\n    });\n\n    // Act 9: Ngắm mây\n    document.querySelectorAll('#act-9 .morph-cloud-btn').forEach((btn, i) => {\n      btn.addEventListener('click', () => {\n        state.clouds.add(i);\n        btn.classList.add('runtime-selected');\n        sfx.good();\n        showPrompt('Bin', `Bin thấy giống ${btn.dataset.name || 'một hình thật vui'}! Còn con thấy giống gì?`);\n        if (state.clouds.size >= 3) {\n          completeActivity(9);\n          showFeedback(9);\n        }\n      });\n    });\n\n    // Act 10: Nói nhỏ\n    document.querySelectorAll('#act-10 .volume-act-btn').forEach(btn => {\n      btn.addEventListener('click', () => {\n        if (btn.dataset.level === 'whisper') {\n          sfx.good();\n          showPrompt('Bin', 'Đúng rồi! Mình nói nhỏ vừa đủ nghe nhé.');\n          completeActivity(10);\n          showFeedback(10);\n        } else if (btn.dataset.level === 'medium') {\n          sfx.pop();\n          showPrompt('Mẹ', 'Nhỏ hơn một chút nữa nhé!');\n        } else {\n          sfx.bad();\n          showPrompt('Mẹ', 'Ơ, hơi to rồi. Con thử nhỏ hơn nhé!');\n        }\n      });\n    });\n\n    // Act 11: Ngồi gọn\n    el('btn-tuck-feet')?.addEventListener('click', () => {\n      sfx.good();\n      showPrompt('Bố', 'Giỏi lắm! Bin ngồi gọn rồi, không đạp ghế trước!');\n      completeActivity(11);\n      showFeedback(11);\n    });\n\n    // Act 13: Tìm vali\n    document.querySelectorAll('#act-13 .real-suitcase-card').forEach(btn => {\n      btn.addEventListener('click', () => {\n        if (btn.dataset.isBin === 'true') {\n          sfx.good();\n          completeActivity(13);\n          el('golden-medal-modal')?.classList.add('show');\n        } else {\n          btn.classList.remove('runtime-wrong');\n          void btn.offsetWidth;\n          btn.classList.add('runtime-wrong');\n          sfx.bad();\n          showPrompt('Bố', 'Vali này của bạn khác rồi. Con tìm lại nhé!');\n        }\n      });\n    });\n\n    // Replay\n    el('btn-replay-adventure')?.addEventListener('click', () => {\n      el('golden-medal-modal')?.classList.remove('show');\n      state.completedActs.clear();\n      state.outfit = {shirt:false, pants:false, shoes:false};\n      state.packed.clear();\n      state.xrayChecked.clear();\n      state.clouds.clear();\n      if (window.binRenderer) window.binRenderer.reset();\n      showActivity(1);\n    });\n  }\n\n  function armLandingWait() {\n    const btn = el('unbuckle-latch-btn');\n    if (!btn) return;\n    btn.disabled = true;\n    btn.style.opacity = '0.6';\n    btn.innerHTML = '<span>⏳ Máy bay đang chạy vào bãi đỗ...</span>';\n    showPrompt('Bố', 'Máy bay đang chạy vào chỗ đỗ. Bin vẫn ngồi yên và giữ dây an toàn nhé!');\n\n    if (state.activity12Timer) clearTimeout(state.activity12Timer);\n    state.activity12Timer = setTimeout(() => {\n      btn.disabled = false;\n      btn.style.opacity = '1';\n      btn.classList.add('tycoon-btn-primary');\n      btn.innerHTML = '<span>🔓 Máy bay đã dừng hẳn — Mở dây an toàn (CẠCH!)</span>';\n      showPrompt('Mẹ', 'Máy bay dừng hẳn rồi. Bây giờ mình mới mở dây nhé!');\n    }, state.reducedMotion ? 700 : 2500);\n\n    btn.onclick = () => {\n      if (btn.disabled) return;\n      if (window.binRenderer) window.binRenderer.setSeatbelt('none');\n      sfx.clack();\n      completeActivity(12);\n      showFeedback(12);\n    };\n  }\n\n  function bindNavigation() {\n    document.querySelectorAll('.btn-start-activity').forEach(btn => {\n      btn.addEventListener('click', () => startActivity(Number(btn.dataset.act)));\n    });\n    document.querySelectorAll('.btn-next-activity').forEach(btn => {\n      btn.addEventListener('click', () => nextActivity(Number(btn.dataset.next)));\n    });\n\n    document.querySelectorAll('.stage-dot').forEach(dot => {\n      dot.addEventListener('click', () => {\n        if (dot.classList.contains('locked')) return;\n        const stage = Number(dot.dataset.stage);\n        const first = Object.entries(ACTIVITY_META).find(([,m]) => m.stage === stage);\n        if (first) showActivity(Number(first[0]));\n      });\n    });\n  }\n\n  function bindParentGate() {\n    const gate = el('btn-parent-gate');\n    const modal = el('parent-modal');\n    const circle = el('parent-ring-circle');\n    let started = 0, raf = null;\n\n    function reset() {\n      if (raf) cancelAnimationFrame(raf);\n      raf = null;\n      started = 0;\n      if (circle) circle.style.strokeDashoffset = '175';\n    }\n\n    function tick() {\n      const elapsed = performance.now() - started;\n      const progress = Math.min(1, elapsed / 3000);\n      if (circle) circle.style.strokeDashoffset = String(175 - 175 * progress);\n      if (progress >= 1) {\n        modal?.classList.add('open');\n        reset();\n        return;\n      }\n      raf = requestAnimationFrame(tick);\n    }\n\n    gate?.addEventListener('pointerdown', e => {\n      e.preventDefault();\n      started = performance.now();\n      raf = requestAnimationFrame(tick);\n    });\n\n    ['pointerup', 'pointerleave', 'pointercancel'].forEach(ev => gate?.addEventListener(ev, reset));\n    el('btn-close-parent')?.addEventListener('click', () => modal?.classList.remove('open'));\n\n    document.querySelectorAll('.jump-btn').forEach(btn => {\n      btn.addEventListener('click', () => {\n        modal?.classList.remove('open');\n        showActivity(Number(btn.dataset.act));\n      });\n    });\n\n    el('btn-reset-app')?.addEventListener('click', () => location.reload());\n\n    el('setting-volume')?.addEventListener('input', e => volume = Number(e.target.value));\n    el('setting-reduced-motion')?.addEventListener('change', e => {\n      state.reducedMotion = e.target.checked;\n      document.documentElement.classList.toggle('reduced-motion', state.reducedMotion);\n    });\n  }\n\n  function init() {\n    if (state.initialized) return;\n    state.initialized = true;\n    bindNavigation();\n    bindParentGate();\n    bindActivity1();\n    bindActivity2();\n    bindSimpleActivities();\n    showActivity(1);\n    console.log('[APP READY] 13-activity controller loaded successfully');\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', init);\n  } else {\n    init();\n  }\n})();\n</script>","StartLine":779,"TargetContent":"<script id=\"runtime-hotfix-js\">\n(() => {\n  'use strict';\n\n  const ACTIVITY_META = {\n    1:{stage:1,label:'Chọn trang phục',speaker:'Mẹ',prompt:'Bin sắp đi máy bay rồi. Con chọn bộ đồ nào giúp Bin dễ vận động nhé!'},\n    2:{stage:2,label:'Xếp hành lý',speaker:'Bố',prompt:'Bin mang gì đi máy bay nhỉ? Con xếp vali giúp Bin nhé!'},\n    3:{stage:3,label:'Kiểm tra vé',speaker:'Mẹ',prompt:'Đến quầy kiểm tra rồi. Con giúp Bin đưa vé nhé!'},\n    4:{stage:3,label:'Soi hành lý',speaker:'Bố',prompt:'Bây giờ vali của Bin sẽ đi qua máy soi. Con xem bên trong có gì nhé!'},\n    5:{stage:3,label:'Cổng an ninh',speaker:'Mẹ',prompt:'Đến cổng an ninh rồi. Con giúp Bin đi qua nhé!'},\n    6:{stage:4,label:'Tìm Cổng 03',speaker:'Bố',prompt:'Vé của Bin ghi số 03. Con tìm cổng số 03 nhé!'},\n    7:{stage:5,label:'Cài dây an toàn',speaker:'Mẹ',prompt:'Bin ngồi vào ghế rồi. Con giúp Bin cài dây an toàn nhé!'},\n    8:{stage:5,label:'Giúp tai dễ chịu',speaker:'Mẹ',prompt:'Tai Bin hơi khó chịu. Bin uống một ngụm nước nhé.'},\n    9:{stage:6,label:'Ngắm mây',speaker:'Bin',prompt:'Bin thấy đám mây giống hình gì nhỉ? Con nhìn cùng Bin nhé!'},\n    10:{stage:7,label:'Nói nhỏ',speaker:'Mẹ',prompt:'Trên máy bay mình nói nhỏ vừa đủ nghe nhé.'},\n    11:{stage:7,label:'Ngồi gọn',speaker:'Bố',prompt:'Bin thu chân gọn lại để không chạm ghế phía trước nhé!'},\n    12:{stage:8,label:'Mở dây sau khi dừng',speaker:'Bố',prompt:'Máy bay đang chạy vào chỗ đỗ. Bin vẫn ngồi yên và giữ dây an toàn nhé!'},\n    13:{stage:8,label:'Nhận vali',speaker:'Bố',prompt:'Con tìm chiếc vali đỏ có hình gấu của Bin nhé!'}\n  };\n\n  const SPEAKER_ICON = { 'Mẹ':'👩', 'Bố':'👨', 'Bin':'🧒', 'Tiếp viên':'👩‍✈️' };\n  const state = {\n    currentAct: 1,\n    completedActs: new Set(),\n    unlockedStages: new Set([1]),\n    initialized: false,\n    activity12Timer: null,\n    outfit: {shirt:null,pants:null,shoes:null},\n    packed: new Set(),\n    xrayChecked: new Set(),\n    clouds: new Set(),\n    reducedMotion: false\n  };\n\n  function el(id){ return document.getElementById(id); }\n\n  function showPrompt(speaker, text) {\n    const p = el('parent-prompt-text');\n    const a = el('parent-prompt-avatar');\n    if (p) p.textContent = `“${text}”`;\n    if (a) a.textContent = SPEAKER_ICON[speaker] || '🌟';\n  }\n\n  function showFeedback(act) {\n    const f = el(`feedback-act-${act}`);\n    if (f) f.classList.remove('hidden');\n  }\n\n  function updateProgress(act) {\n    const meta = ACTIVITY_META[act];\n    reducedMotion: false,\n    initialized: false\n  };\n\n  const el = id => document.getElementById(id);\n\n  // ---- Pure Web Audio API Synth Engine ----\n  let audioCtx = null;\n  let volume = 0.8;\n  function tone(freq, duration=.12, type='sine') {\n    try {\n      const AudioCtx = window.AudioContext || window.webkitAudioContext;\n      if (!AudioCtx) return;\n      audioCtx ||= new AudioCtx();\n      if (audioCtx.state === 'suspended') audioCtx.resume();\n      const o = audioCtx.createOscillator();\n      const g = audioCtx.createGain();\n      const now = audioCtx.currentTime;\n      o.type = type;\n      o.frequency.setValueAtTime(freq, now);\n      g.gain.setValueAtTime(.18 * volume, now);\n      g.gain.exponentialRampToValueAtTime(.001, now+duration);\n      o.connect(g); g.connect(audioCtx.destination);\n      o.start(now); o.stop(now+duration+.02);\n    } catch(e) {}\n  }\n  const sfx = {\n    good(){ tone(1046,.15); setTimeout(()=>tone(1318,.22),90); },\n    bad(){ tone(220,.12,'triangle'); },\n    clack(){ tone(260,.08,'square'); },\n    stamp(){ tone(520,.07,'square'); },\n    pop(){ tone(620,.08); }\n  };\n\n  function showPrompt(speaker, text) {\n    const p = el('parent-prompt-text');\n    const a = el('parent-prompt-avatar');\n    if (p) p.textContent = `“${text}”`;\n    if (a) a.textContent = { 'Mẹ':'👩', 'Bố':'👨', 'Bin':'🧒', 'Tiếp viên':'👩‍✈️' }[speaker] || '🌟';\n  }\n\n  function showFeedback(act) {\n    el(`feedback-act-${act}`)?.classList.remove('hidden');\n  }\n\n  function completeActivity(act) {\n    state.completed.add(act);\n    const nextAct = act + 1;\n    if (ACTIVITY_META[nextAct]) {\n      document.querySelectorAll('.stage-dot').forEach(dot => {\n        if(Number(dot.dataset.stage) <= ACTIVITY_META[nextAct].stage) dot.classList.remove('locked');\n      });\n    }\n  }\n\n  function updateProgress(act) {\n    const meta = ACTIVITY_META[act];\n    const sub = el('sub-progress-text');\n    if (sub && meta) sub.textContent = `Chặng ${meta.stage} — Hoạt động ${act}: ${meta.label}`;\n  }\n\n  function showActivity(act) {\n    if (!ACTIVITY_META[act]) return;\n    document.querySelectorAll('.activity-container').forEach(s => s.classList.remove('active'));\n    el(`act-${act}`)?.classList.add('active');\n    state.currentAct = act;\n    updateProgress(act);\n    showPrompt(ACTIVITY_META[act].speaker, ACTIVITY_META[act].prompt);\n    window.scrollTo({top:0, behavior:'instant'});\n  }\n\n  function startActivity(act) {\n    el(`intro-act-${act}`)?.classList.add('hidden');\n    el(`gameplay-act-${act}`)?.classList.remove('hidden');\n  }\n\n  function ensureBinRenderer() {\n    if (window.binRenderer) {\n      window.binRenderer.mountAll();\n    }\n  }\n\n  function bindActivity1() {\n    document.querySelectorAll('#act-1 [data-clothing-item=\"true\"]').forEach(btn => {\n      btn.addEventListener('click', () => {\n        const fit = btn.dataset.fit;\n        const typeRaw = btn.dataset.type;\n        if (fit !== 'soft') {\n          sfx.bad();\n          showPrompt('Mẹ', 'Món này hơi bất tiện. Con thử món khác nhé!');\n          return;\n        }\n        const type = typeRaw === 'shirt' ? 'shirt' : typeRaw === 'pants' ? 'pants' : typeRaw === 'shoes' ? 'shoes' : null;\n        if (!type) return;\n\n        if (window.binRenderer) {\n          if (type === 'shirt') window.binRenderer.setShirt('yellow');\n          if (type === 'pants') window.binRenderer.setPants('blue');\n          if (type === 'shoes') window.binRenderer.setShoes('velcro');\n        }\n\n        state.outfit[type] = true;\n        btn.classList.add('runtime-selected');\n        sfx.good();\n        showPrompt('Mẹ', 'Đúng rồi! Món này mềm và dễ vận động.');\n        if (state.outfit.shirt && state.outfit.pants && state.outfit.shoes) {\n          completeActivity(1);\n          showFeedback(1);\n        }\n      });\n    });\n  }\n\n  function bindActivity2() {\n    document.querySelectorAll('#act-2 [data-luggage-item=\"true\"]').forEach(btn => {\n      btn.addEventListener('click', () => {\n        if (btn.dataset.category === 'PACK') {\n          btn.classList.add('runtime-packed');\n          state.packed.add(btn);\n          sfx.good();\n          showPrompt('Bố', 'Ừ! Món này mình xếp vào vali nhé.');\n          if (state.packed.size >= 3) { completeActivity(2); showFeedback(2); }\n        } else {\n          sfx.pop();\n          showPrompt('Bố', 'Món này mình hỏi Ba Mẹ trước nhé!');\n        }\n      });\n    });\n  }\n\n  function bindSimpleActivities() {\n    // Act 3\n    el('btn-show-ticket-3')?.addEventListener('click', () => {\n      sfx.stamp();\n      showPrompt('Mẹ', 'Vé của Bin đã được kiểm tra rồi!');\n      completeActivity(3);\n      showFeedback(3);\n    });\n\n    // Act 4\n    document.querySelectorAll('#act-4 .xray-item-tile').forEach((tile, i) => {\n      tile.addEventListener('click', () => {\n        state.xrayChecked.add(i);\n        sfx.good();\n        if (state.xrayChecked.size >= 3) { completeActivity(4); showFeedback(4); }\n      });\n    });\n\n    // Act 5\n    el('btn-walk-gate-5')?.addEventListener('click', () => {\n      sfx.good();\n      completeActivity(5);\n      showFeedback(5);\n    });\n\n    // Act 6\n    document.querySelectorAll('#act-6 .gate-hud-btn').forEach(btn => {\n      btn.addEventListener('click', () => {\n        if (btn.dataset.gate === '03') {\n          sfx.good();\n          showPrompt('Bố', 'Đúng rồi! Cổng 03 đây rồi!');\n          completeActivity(6);\n          showFeedback(6);\n        } else {\n          sfx.bad();\n          showPrompt('Bố', 'Con nhìn lại số trên vé nhé!');\n        }\n      });\n    });\n\n    // Act 7: Cài dây an toàn (Canonical Bé Bin + Seatbelt Layer)\n    el('btn-buckle-action-7')?.addEventListener('click', () => {\n      if (window.binRenderer) window.binRenderer.setSeatbelt('fastened');\n      sfx.clack();\n      completeActivity(7);\n      showFeedback(7);\n    });\n\n    // Act 8: Uống nước\n    el('btn-drink-action-8')?.addEventListener('click', () => {\n      sfx.good();\n      showPrompt('Bin', 'Tai Bin dễ chịu hơn rồi!');\n      completeActivity(8);\n      showFeedback(8);\n    });\n\n    // Act 9: Ngắm mây\n    document.querySelectorAll('#act-9 .morph-cloud-btn').forEach((btn, i) => {\n      btn.addEventListener('click', () => {\n        state.clouds.add(i);\n        btn.classList.add('runtime-selected');\n        sfx.good();\n        showPrompt('Bin', `Bin thấy giống ${btn.dataset.name || 'một hình thật vui'}! Còn con thấy giống gì?`);\n        if (state.clouds.size >= 3) { completeActivity(9); showFeedback(9); }\n      });\n    });\n\n    // Act 10: Nói nhỏ\n    document.querySelectorAll('#act-10 .volume-act-btn').forEach(btn => {\n      btn.addEventListener('click', () => {\n        if (btn.dataset.level === 'whisper') {\n          sfx.good();\n          showPrompt('Bin', 'Đúng rồi! Mình nói nhỏ vừa đủ nghe nhé.');\n          completeActivity(10);\n          showFeedback(10);\n        } else if (btn.dataset.level === 'medium') {\n          sfx.pop();\n          showPrompt('Mẹ', 'Nhỏ hơn một chút nữa nhé!');\n        } else {\n          sfx.bad();\n          showPrompt('Mẹ', 'Ơ, hơi to rồi. Con thử nhỏ hơn nhé!');\n        }\n      });\n    });\n\n    // Act 11: Ngồi gọn\n    el('btn-tuck-feet')?.addEventListener('click', () => {\n      sfx.good();\n      showPrompt('Bố', 'Giỏi lắm! Bin ngồi gọn rồi, không đạp ghế trước!');\n      completeActivity(11);\n      showFeedback(11);\n    });\n\n    // Act 13: Tìm vali\n    document.querySelectorAll('#act-13 .real-suitcase-card').forEach(btn => {\n      btn.addEventListener('click', () => {\n        if (btn.dataset.isBin === 'true') {\n          sfx.good();\n          completeActivity(13);\n          el('golden-medal-modal')?.classList.add('show');\n        } else {\n          btn.classList.remove('runtime-wrong');\n          void btn.offsetWidth;\n          btn.classList.add('runtime-wrong');\n          sfx.bad();\n          showPrompt('Bố', 'Vali này của bạn khác rồi. Con tìm lại nhé!');\n        }\n      });\n    });\n  }\n\n  function armLandingWait() {\n    const btn = el('unbuckle-latch-btn');\n    if (!btn) return;\n    btn.disabled = true;\n    btn.style.opacity = '.6';\n    btn.innerHTML = '<span>⏳ Máy bay đang chạy vào bãi đỗ...</span>';\n    showPrompt('Bố', 'Máy bay đang chạy vào chỗ đỗ. Bin vẫn ngồi yên và giữ dây an toàn nhé!');\n    if (state.activity12Timer) clearTimeout(state.activity12Timer);\n    state.activity12Timer = setTimeout(() => {\n      btn.disabled = false;\n      btn.style.opacity = '1';\n      btn.innerHTML = '<span>🔓 Máy bay đã dừng hẳn — mở dây an toàn</span>';\n      showPrompt('Mẹ', 'Máy bay dừng hẳn rồi. Bây giờ mình mới mở dây nhé!');\n    }, state.reducedMotion ? 700 : 2500);\n\n    btn.onclick = () => {\n      if (btn.disabled) return;\n      if (window.binRenderer) window.binRenderer.setSeatbelt('none');\n      sfx.clack();\n      completeActivity(12);\n      showFeedback(12);\n    };\n  }\n\n  function bindNavigation() {\n    document.querySelectorAll('.btn-start-activity').forEach(btn => {\n      btn.addEventListener('click', () => startActivity(Number(btn.dataset.act)));\n    });\n    document.querySelectorAll('.btn-next-activity').forEach(btn => {\n      btn.addEventListener('click', () => nextActivity(Number(btn.dataset.next)));\n    });\n\n    document.querySelectorAll('.stage-dot').forEach(dot => {\n      dot.addEventListener('click', () => {\n        if (dot.classList.contains('locked')) return;\n        const stage = Number(dot.dataset.stage);\n        const first = Object.entries(ACTIVITY_META).find(([,m]) => m.stage === stage);\n        if (first) showActivity(Number(first[0]), {force:true});\n      });\n    });\n  }\n\n  function bindParentGate() {\n    const gate = el('btn-parent-gate');\n    const modal = el('parent-modal');\n    const circle = el('parent-ring-circle');\n    let started = 0, raf = null;\n\n    function reset() {\n      if (raf) cancelAnimationFrame(raf);\n      raf = null; started = 0;\n      if (circle) circle.style.strokeDashoffset = '175';\n    }\n    function tick() {\n      const elapsed = performance.now() - started;\n      const progress = Math.min(1, elapsed/3000);\n      if (circle) circle.style.strokeDashoffset = String(175 - 175*progress);\n      if (progress >= 1) {\n        modal?.classList.add('open'); reset(); return;\n      }\n      raf = requestAnimationFrame(tick);\n    }\n    gate?.addEventListener('pointerdown', e => {\n      e.preventDefault(); started = performance.now(); raf = requestAnimationFrame(tick);\n    });\n    ['pointerup','pointerleave','pointercancel'].forEach(ev => gate?.addEventListener(ev, reset));\n    el('btn-close-parent')?.addEventListener('click', () => modal?.classList.remove('open'));\n\n    document.querySelectorAll('.jump-btn').forEach(btn => {\n      btn.addEventListener('click', () => {\n        modal?.classList.remove('open');\n        showActivity(Number(btn.dataset.act), {force:true});\n      });\n    });\n\n    el('btn-reset-app')?.addEventListener('click', () => location.reload());\n\n    el('setting-volume')?.addEventListener('input', e => volume = Number(e.target.value));\n    el('setting-reduced-motion')?.addEventListener('change', e => {\n      state.reducedMotion = e.target.checked;\n      document.documentElement.classList.toggle('reduced-motion', state.reducedMotion);\n    });\n  }\n\n  function bindImageFallbackForAppOpening() {\n    document.querySelectorAll('img').forEach(img => {\n      img.addEventListener('error', () => {\n        const parent = img.parentElement;\n        if (!parent || parent.querySelector(':scope > .asset-load-error')) return;\n        const msg = document.createElement('div');\n        msg.className = 'asset-load-error';\n        msg.textContent = `Thiếu ảnh: ${img.getAttribute('src')}`;\n        parent.appendChild(msg);\n        img.style.display = 'none';\n      });\n    });\n  }\n\n  function init() {\n    if (state.initialized) return;\n    state.initialized = true;\n    attachImageDiagnostics();\n    bindImageFallbackForAppOpening();\n    bindNavigation();\n    bindParentGate();\n    bindActivity1();\n    bindActivity2();\n    bindSimpleActivities();\n    ensureBinRenderer();\n    showActivity(1, {force:true});\n    console.log('[APP READY] 13-activity controller loaded');\n  }\n\n  document.addEventListener('DOMContentLoaded', init);\n})();\n</script>","TargetFile":"c:\\Demo.plane\\index.html","toolAction":"Editing file","toolSummary":"Rewrite runtime controller script in index.html"}}]}
