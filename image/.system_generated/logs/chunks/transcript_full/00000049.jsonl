entById(containerOrId) : containerOrId;\n41:         if (!container) return;\n42: \n43:         this.containers.add(container);\n44:         this.updateImage(container);\n45:     }\n46: \n47:     getCurrentImageSrc() {\n48:         if (this.currentOutfit.shirt && this.currentOutfit.pants && this.currentOutfit.shoes) {\n49:             return this.sprites.fullOutfit;\n50:         } else if (this.currentOutfit.shirt && this.currentOutfit.pants) {\n51:             return this.sprites.shirtPants;\n52:         } else if (this.currentOutfit.shirt) {\n53:             return this.sprites.shirtOnly;\n54:         } else if (this.currentOutfit.pants) {\n55:             return this.sprites.shirtPants;\n56:         } else if (this.currentOutfit.shoes) {\n57:             return this.sprites.fullOutfit;\n58:         }\n59:         return this.sprites.base;\n60:     }\n61: \n62:     updateImage(container) {\n63:         if (!container) return;\n64:         const src = this.getCurrentImageSrc();\n65:         container.innerHTML = `\n66:             <div style=\"position: relative; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 16px;\">\n67:                 <img src=\"${src}\" alt=\"Bé Bin\" style=\"width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 8px 16px rgba(0,0,0,0.12));\">\n68:             </div>\n69:         `;\n70:     }\n71: \n72:     setShirt(shirtKey) {\n73:         this.currentOutfit.shirt = shirtKey;\n74:         this.refreshAll();\n75:     }\n76: \n77:     setPants(pantsKey) {\n78:         this.currentOutfit.pants = pantsKey;\n79:         this.refreshAll();\n80:     }\n81: \n82:     setShoes(shoesKey) {\n83:         this.currentOutfit.shoes = shoesKey;\n84:         this.refreshAll();\n85:     }\n86: \n87:     setSeatbelt(seatbeltKey) {\n88:         this.currentOutfit.seatbelt = seatbeltKey;\n89:         this.refreshAll();\n90:     }\n91: \n92:     reset() {\n93:         this.cu