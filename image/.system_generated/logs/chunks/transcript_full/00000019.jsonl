'\n            expression: 'normal',\n            seatbelt: 'none',         // 'none' | 'open' | 'fastened'\n            holding: null\n        };\n\n        // Bảng ánh xạ Artwork chuẩn Style BIN_SOFT_STORYBOOK_2D_V1\n        this.assetManifest = {\n            baseBody: 'assets/characters/bin/dress/bin_base.svg',\n            shirts: {\n                yellow: 'assets/characters/bin/dress/shirts/shirt_yellow.svg',\n                blue: 'assets/characters/bin/dress/shirts/shirt_blue.svg'\n            },\n            pants: {\n                orange: 'assets/characters/bin/dress/pants/pants_orange.svg',\n                blue: 'assets/characters/bin/dress/pants/pants_blue.svg'\n            },\n            shoes: {\n                blue_velcro: 'assets/characters/bin/dress/shoes/shoes_blue_velcro.svg',\n                white_laces: 'assets/characters/bin/dress/shoes/shoes_white_laces.svg'\n            },\n            seatbelts: {\n                open: 'assets/characters/bin/layers/seatbelt_open.svg',\n                fastened: 'assets/characters/bin/layers/seatbelt_fastened.svg'\n            },\n            // Các Pose Artwork 2D Storybook chuẩn từ AI Model\n            storybookPoses: {\n                standing: 'file:///C:/Users/USER/.gemini/antigravity/brain/6f49409f-fe23-4490-984d-4f0e771339c6/bin_point_right_1787725750609.jpg',\n                pointing: 'file:///C:/Users/USER/.gemini/antigravity/brain/6f49409f-fe23-4490-984d-4f0e771339c6/bin_point_right_1787725750609.jpg',\n                seated_open: 'file:///C:/Users/USER/.gemini/antigravity/brain/6f49409f-fe23-4490-984d-4f0e771339c6/bin_seated_plane_1787725580022.jpg',\n                seated_fastened: 'file:///C:/Users/USER/.gemini/antigravity/brain/6f49409f-fe23-4490-984d-4f0e771339c6/bin_seatbelt_fastened_1787725612313.jpg',\n                drinking_water: 'file:///C:/Users/USER/.gemini/antigravity/brain/6f49409f-fe23-4490-984d-4f0e771339c6/bin_drink_water_1787725639196.jpg',\n                looking_window: 'file:///C:/Users/USER/.gemini/antigravity/brain/6f49409f-fe23-4490-984d-4f0e771339c6/bin_looking_window_1787725671427.jpg',\n                whispering: 'file:///C:/Users/USER/.gemini/antigravity/brain/6f49409f-fe23-4490-984d-4f0e771339c6/bin_whisper_sitting_1787725691994.jpg',\n                sitting_neat: 'file:///C:/Users/USER/.gemini/antigravity/brain/6f49409f-fe23-4490-984d-4f0e771339c6/bin_whisper_sitting_1787725691994.jpg',\n                holding_badge: 'file:///C:/Users/USER/.gemini/antigravity/brain/6f49409f-fe23-4490-984d-4f0e771339c6/bin_holding_badge_1787725718575.jpg'\n            },\n            palette: {\n                shirt: { yellow: '#F8D978', blue: '#73C7E8' },\n                pants: { orange: '#F5A45D', blue: '#82C99A' },\n                shoes: { blue_velcro: '#73C7E8', white_laces: '#FFFFFF' }\n            }\n        };\n\n        this.init();\n    }\n\n    init() {\n        this.syncThemeVariables();\n    }\n\n    syncThemeVariables() {\n        const root = document.documentElement;\n        const shirtHex = this.assetManifest.palette.shirt[this.characterState.outfit.shirt] || '#73C7E8';\n        const pantsHex = this.assetManifest.palette.pants[this.characterState.outfit.pants] || '#F5A45D';\n        const shoesHex = this.assetManifest.palette.shoes[this.characterState.outfit.shoes] || '#73C7E8';\n\n        root.style.setProperty('--bin-shirt-color', shirtHex);\n        root.style.setProperty('--bin-pants-color', pantsHex);\n        root.style.setProperty('--bin-shoes-color', shoesHex);\n    }\n\n    // ==========================================================================\n    // PUBLIC STATE API\n    // ==========================================================================\n\n    setShirt(value) {\n        if (!this.assetManifest.shirts[value]) return;\n        this.characterState.outfit.shirt = value;\n        this.syncThemeVariables();\n        this.updateAll();\n    }\n\n    setPants(value) {\n        if (!this.assetManifest.pants[value]) return;\n        this.characterState.outfit.pants = value;\n        this.syncThemeVariables();\n        this.updateAll();\n    }\n\n    setShoes(value) {\n        if (!this.assetManifest.shoes[value]) return;\n        this.characterState.outfit.shoes = value;\n        this.syncThemeVariables();\n        this.updateAll();\n    }\n\n    setOutfit(outfitObj) {\n        if (!outfitObj) return;\n        if (outfitObj.shirt && this.assetManifest.shirts[outfitObj.shirt]) {\n            this.characterState.outfit.shirt = outfitObj.shirt;\n        }\n        if (outfitObj.pants && this.assetManifest.pants[outfitObj.pants]) {\n            this.characterState.outfit.pants = outfitObj.pants;\n        }\n        if (outfitObj.shoes && this.assetManifest.shoes[outfitObj.shoes]) {\n            this.characterState.outfit.shoes = outfitObj.shoes;\n        }\n        this.syncThemeVariables();\n        this.updateAll();\n    }\n\n    setPose(poseName) {\n        this.characterState.pose = poseName;\n        this.updateAll();\n    }\n\n    setExpression(expressionName) {\n        this.characterState.expression = expressionName;\n        this.updateAll();\n    }\n\n    setSeatbelt(seatbeltState) {\n        this.characterState.seatbelt = seatbeltState; // 'none' | 'open' | 'fastened'\n        this.updateAll();\n    }\n\n    setHolding(item) {\n        this.characterState.holding = item;\n        if (item === 'water') {\n            this.setPose('drinking_water');\n        } else if (item === 'badge') {\n            this.setPose('holding_badge');\n        } else {\n            this.updateAll();\n        }\n    }\n\n    reset() {\n        this.characterState = {\n            outfit: {\n                shirt: 'blue',\n                pants: 'orange',\n                shoes: 'blue_velcro'\n            },\n            pose: 'standing',\n            expression: 'normal',\n            seatbelt: 'none',\n            holding: null\n        };\n        this.syncThemeVariables();\n        this.updateAll();\n    }\n\n    // ==========================================================================\n    // RENDER ENGINE: TẠO VÀ CẬP NHẬT CÁC LAYER / STORYBOOK ARTWORK\n    // ==========================================================================\n\n    renderTo(containerEl, customPose = null, customSeatbelt = null) {\n        if (!containerEl) return;\n\n        const effectivePose = customPose || this.characterState.pose;\n        const effectiveSeatbelt = customSeatbelt !== null ? customSeatbelt : this.characterState.seatbelt;\n        const isLevel1Dress = effectivePose === 'standing_layers';\n\n        containerEl.innerHTML = '';\n        containerEl.classList.add('bin-character-frame');\n\n        if (isLevel1Dress) {\n            // HỆ LAYER LEVEL 1: Base Body + Shoes + Pants + Shirt\n            const wrapper = document.createElement('div');\n            wrapper.className = 'bin-layered-stack';\n\n            const baseImg = document.createElement('img');\n            baseImg.className = 'bin-layer bin-layer-base';\n            baseImg.src = this.assetManifest.baseBody;\n            baseImg.alt = 'Bé Bin Base Body';\n            wrapper.appendChild(baseImg);\n\n            if (this.characterState.outfit.shoes && this.assetManifest.shoes[this.characterState.outfit.shoes]) {\n                const shoesImg = document.createElement('img');\n                shoesImg.className = 'bin-layer bin-layer-shoes pop-in-soft';\n                shoesImg.src = this.assetManifest.shoes[this.characterState.outfit.shoes];\n                shoesImg.alt = 'Giày của Bin';\n                wrapper.appendChild(shoesImg);\n            }\n\n            if (this.characterState.outfit.pants && this.assetManifest.pants[this.characterState.outfit.pants]) {\n                const pantsImg = document.createElement('img');\n                pantsImg.className = 'bin-layer bin-layer-pants pop-in-soft';\n                pantsImg.src = this.assetManifest.pants[this.characterState.outfit.pants];\n                pantsImg.alt = 'Quần của Bin';\n                wrapper.appendChild(pantsImg);\n            }\n\n            if (this.characterState.outfit.shirt && this.assetManifest.shirts[this.characterState.outfit.shirt]) {\n                const shirtImg = document.createElement('img');\n                shirtImg.className = 'bin-layer bin-layer-shirt pop-in-soft';\n                shirtImg.src = this.assetManifest.shirts[this.characterState.outfit.shirt];\n                shirtImg.alt = 'Áo của Bin';\n                wrapper.appendChild(shirtImg);\n            }\n\n            containerEl.appendChild(wrapper);\n        } else {\n            // POSE 2D STORYBOOK ARTWORK CHUẨN ĐỒNG NHẤT\n            let poseKey = effectivePose;\n            if (effectivePose === 'seated') {\n                poseKey = effectiveSeatbelt === 'fastened' ? 'seated_fastened' : 'seated_open';\n            }\n\n            const poseSrc = this.assetManifest.storybookPoses[poseKey] || this.assetManifest.storybookPoses.standing;\n            const wrapper = document.createElement('div');\n            wrapper.className = 'bin-layered-stack';\n\n            const poseImg = document.createElement('img');\n            poseImg.className = 'bin-layer bin-layer-pose pop-in-soft';\n            poseImg.src = poseSrc;\n            poseImg.style.borderRadius = '24px';\n            poseImg.alt = `Bé Bin ${effectivePose}`;\n            wrapper.appendChild(poseImg);\n\n            containerEl.appendChild(wrapper);\n        }\n    }\n\n    updateAll() {\n        // 1. Mount point Level 1\n        const lvl1Mount = document.getElementById('bin-character-mount-lvl1');\n        if (lvl1Mount) this.renderTo(lvl1Mount, 'standing_layers');\n\n        // 2. Mount point Level 3 Cổng An Ninh\n        const lvl3Mount = document.getElementById('bin-character-mount-lvl3');\n        if (lvl3Mount) this.renderTo(lvl3Mount, 'pointing');\n\n        // 3. Mount point Level 5 Ghế Ngồi Khoang Bay (Đai an toàn & Uống nước)\n        const lvl5Mount = document.getElementById('bin-character-mount-lvl5');\n        if (lvl5Mount) {\n            const pose5 = this.characterState.pose === 'drinking_water' ? 'drinking_water' : 'seated';\n            this.renderTo(lvl5Mount, pose5, this.characterState.seatbelt);\n        }\n\n        // 4. Mount point Level 6 Nhìn Cửa Sổ\n        const lvl6Mount = document.getElementById('bin-character-mount-lvl6');\n        if (lvl6Mount) this.renderTo(lvl6Mount, 'looking_window');\n\n        // 5. Mount point Level 7 Lịch Sự\n        const lvl7Mount = document.getElementById('bin-character-mount-lvl7');\n        if (lvl7Mount) {\n            const pose7 = this.characterState.pose === 'whispering' ? 'whispering' : (this.characterState.pose === 'sitting_neat' ? 'sitting_neat' : 'seated');\n            this.renderTo(lvl7Mount, pose7, 'fastened');\n        }\n\n        // 6. Mount point Level 8 Nhận Thưởng\n        const lvl8Mount = document.getElementById('bin-character-mount-lvl8');\n        if (lvl8Mount) {\n            const pose8 = this.characterState.pose === 'holding_badge' ? 'holding_badge' : 'standing';\n            this.renderTo(lvl8Mount, pose8);\n        }\n    }\n}\n\n// Khởi tạo instance toàn cục\nwindow.binRenderer = new CharacterRenderer();\n","Description":"Cập nhật character-renderer.js tích hợp bộ Storybook 2D Artwork mới","Overwrite":true,"TargetFile":"c:\\Demo.plane\\js\\character-renderer.js","toolAction":"Writing file","toolSummary":"Update character-renderer.js with 2D Storybook poses"}}]}
