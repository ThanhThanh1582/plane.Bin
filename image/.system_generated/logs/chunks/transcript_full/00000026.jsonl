====================================\n                 CHẶNG 8 — HOẠT ĐỘNG 12: CHỜ DỪNG HẲN RỒI MỚI MỞ DÂY (GOLDEN SAMPLE 4)\n                 ========================================================================== -->\n            <section id=\"act-12\" class=\"activity-container\" data-act=\"12\" data-stage=\"8\" style=\"background-image: url('file:///C:/Users/USER/.gemini/antigravity/brain/6f49409f-fe23-4490-984d-4f0e771339c6/bg_cabin_1787718301171.jpg');\">\n                <!-- 12A. Màn Giới Thiệu (Intro) -->\n                <div class=\"activity-intro-view\" id=\"intro-act-12\">\n                    <span class=\"intro-header-badge\">CHẶNG 8 — HOẠT ĐỘNG 12</span>\n                    <h2 class=\"intro-activity-title\">CHỜ MÁY BAY DỪNG HẲN RỒI MỚI MỞ DÂY</h2>\n                    <div class=\"intro-art-frame\">\n                        <img src=\"file:///C:/Users/USER/.gemini/antigravity/brain/6f49409f-fe23-4490-984d-4f0e771339c6/intro_act12_landing_1787729676186.jpg\" alt=\"Máy bay hạ cánh\">\n                    </div>\n                    <p class=\"intro-prompt-quote\">Bố: “Máy bay đang chạy vào chỗ đỗ. Bin vẫn ngồi yên và giữ dây an toàn nhé!”</p>\n                    <button class=\"tycoon-btn tycoon-btn-primary btn-start-activity\" data-act=\"12\" style=\"font-size: 18px; padding: 10px 32px;\">\n                        BẮT ĐẦU HOẠT ĐỘNG 🚀\n                    </button>\n                </div>\n\n                <!-- 12B. Màn Thực Hiện (Gameplay) -->\n                <div class=\"activity-gameplay-view hidden\" id=\"gameplay-act-12\">\n                    <div class=\"unbuckle-focused-arena\">\n                        <div class=\"seat-plush-box\">\n                            <div id=\"bin-character-mount-act12\" class=\"bin-mount-lvl5\"></div>\n                        </div>\n\n                        <div class=\"unbuckle-status-card\">\n                            <button id=\"unbuckle-latch-btn\" class=\"tycoon-btn\" disabled style=\"font-size: 18px; padding: 14px 28px; opacity: 0.6;\">\n                                <span>⏳ Máy bay đang chạy vào bãi đỗ...</span>\n                            </button>\n                            <span style=\"font-size: 13px; font-weight: 800; color: #546E7A;\">Chỉ mở dây an toàn khi máy bay dừng hẳn và đèn báo tắt</span>\n                        </div>\n                    </div>\n\n                    <!-- 12C. Phản Hồi Hoàn Thành (Feedback Overlay) -->\n                    <div class=\"activity-feedback-overlay hidden\" id=\"feedback-act-12\">\n                        <span class=\"feedback-text\">Mẹ: “Máy bay dừng hẳn rồi. Bây giờ mình mới mở dây nhé!”</span>\n                        <button class=\"tycoon-btn tycoon-btn-green btn-next-activity\" data-next=\"13\">\n                            TÌM VALI CỦA BIN 🧳 ➡️\n                        </button>\n                    </div>\n                </div>\n            </section>\n\n            <!-- ==========================================================================\n                 CHẶNG 8 — HOẠT ĐỘNG 13: TÌM ĐÚNG VALI CỦA BIN\n                 ========================================================================== -->\n            <section id=\"act-13\" class=\"activity-container\" data-act=\"13\" data-stage=\"8\" style=\"background-image: url('file:///C:/Users/USER/.gemini/antigravity/brain/6f49409f-fe23-4490-984d-4f0e771339c6/bg_baggage_1787718391144.jpg');\">\n                <div class=\"activity-intro-view\" id=\"intro-act-13\">\n                    <span class=\"intro-header-badge\">CHẶNG 8 — HOẠT ĐỘNG 13</span>\n                    <h2 class=\"intro-activity-title\">TÌM ĐÚNG VALI CỦA BIN</h2>\n                    <div class=\"intro-art-frame\">\n                        <img src=\"file:///C:/Users/USER/.gemini/antigravity/brain/6f49409f-fe23-4490-984d-4f0e771339c6/bg_baggage_1787718391144.jpg\" alt=\"Băng chuyền hành lý\">\n                    </div>\n                    <p class=\"intro-prompt-quote\">Bố: “Con tìm chiếc vali đỏ có hình gấu của Bin nhé!”</p>\n                    <button class=\"tycoon-btn tycoon-btn-primary btn-start-activity\" data-act=\"13\" style=\"font-size: 18px; padding: 10px 32px;\">\n                        BẮT ĐẦU HOẠT ĐỘNG 🚀\n                    </button>\n                </div>\n\n                <div class=\"activity-gameplay-view hidden\" id=\"gameplay-act-13\">\n                    <div class=\"carousel-track-chunky\">\n                        <div class=\"carousel-suitcases-track\">\n                            <button class=\"carousel-bag-tile\" style=\"background: linear-gradient(180deg, #FF5252 0%, #D50000 100%); border: 3px solid #FFD54F;\" data-is-bin=\"true\">\n                                <span>🐻</span>\n                            </button>\n                            <button class=\"carousel-bag-tile\" style=\"background: linear-gradient(180deg, #29B6F6 0%, #0288D1 100%); border: 3px solid #FFF;\" data-is-bin=\"false\">\n                                <span>🚀</span>\n                            </button>\n                            <button class=\"carousel-bag-tile\" style=\"background: linear-gradient(180deg, #FFEE58 0%, #FDD835 100%); border: 3px solid #FFF;\" data-is-bin=\"false\">\n                                <span>🍒</span>\n                            </button>\n                            <button class=\"carousel-bag-tile\" style=\"background: linear-gradient(180deg, #ECEFF1 0%, #B0BEC5 100%); border: 3px solid #FFF;\" data-is-bin=\"false\">\n                                <span>⚽</span>\n                            </button>\n                            <button class=\"carousel-bag-tile\" style=\"background: linear-gradient(180deg, #BA68C8 0%, #7B1FA2 100%); border: 3px solid #FFF;\" data-is-bin=\"false\">\n                                <span>⭐</span>\n                            </button>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- MÀN THƯỞNG CUỐI CÙNG -->\n                <div id=\"golden-medal-modal\" class=\"golden-medal-modal\">\n                    <div style=\"display: flex; justify-content: center; margin-bottom: 6px;\">\n                        <div id=\"bin-character-mount-lvl8\" style=\"width: 190px; height: 250px;\"></div>\n                    </div>\n                    <h2 style=\"font-size: 24px; font-weight: 900; color: #E65100; margin: 4px 0;\">HÀNH KHÁCH NHÍ XUẤT SẮC</h2>\n                    <p style=\"font-size: 15px; font-weight: 800; color: #37474F; margin: 4px 0;\">Bé Bin đã hoàn thành chuyến bay đầu tiên!</p>\n                    <div style=\"background: #E1F5FE; color: #0277BD; padding: 6px 16px; border-radius: 999px; font-weight: 900; font-size: 14px; display: inline-block; margin: 6px 0;\">\n                        ✈️ Đã nhận Mô hình Máy Bay vào bộ sưu tập của Bin!\n                    </div>\n\n                    <button id=\"btn-replay-adventure\" class=\"tycoon-btn tycoon-btn-primary\" style=\"font-size: 18px; padding: 10px 28px; margin-top: 12px;\">\n                        🔄 CHƠI LẠI CÙNG BIN\n                    </button>\n                </div>\n            </section>\n\n        </main>\n\n        <!-- CỔNG BA MẸ (PARENT CONTROL HUB) -->\n        <div id=\"parent-modal\" class=\"parent-modal-overlay\">\n            <div class=\"parent-control-card\">\n                <h2 style=\"color: #D84315; font-size: 21px; margin-bottom: 10px;\">🛡️ Cổng Dành Cho Ba Mẹ</h2>\n                \n                <div class=\"parent-tip-box\">\n                    <strong>💡 Giúp tai bé dễ chịu khi máy bay lên/xuống:</strong> Khi cất cánh hoặc hạ cánh, cho bé ngồi thẳng và uống từng ngụm nước nhỏ để khuyến khích động tác nuốt, giúp tai dễ chịu hơn.\n                </div>\n\n                <div style=\"margin: 10px 0;\">\n                    <strong style=\"font-size: 14px; color: #37474F;\">Chọn nhanh hoạt động:</strong>\n                    <div class=\"level-jump-grid\">\n                        <button class=\"jump-btn\" data-act=\"1\">1. Mặc đồ</button>\n                        <button class=\"jump-btn\" data-act=\"2\">2. Xếp vali</button>\n                        <button class=\"jump-btn\" data-act=\"3\">3. Kiểm tra vé</button>\n                        <button class=\"jump-btn\" data-act=\"4\">4. Soi hành lý</button>\n                        <button class=\"jump-btn\" data-act=\"5\">5. Cổng an ninh</button>\n                        <button class=\"jump-btn\" data-act=\"6\">6. Cổng 03</button>\n                        <button class=\"jump-btn\" data-act=\"7\">7. Cài đai</button>\n                        <button class=\"jump-btn\" data-act=\"8\">8. Uống nước</button>\n                        <button class=\"jump-btn\" data-act=\"9\">9. Ngắm mây</button>\n                        <button class=\"jump-btn\" data-act=\"10\">10. Nói nhỏ</button>\n                        <button class=\"jump-btn\" data-act=\"11\">11. Ngồi gọn</button>\n                        <button class=\"jump-btn\" data-act=\"12\">12. Mở đai</button>\n                        <button class=\"jump-btn\" data-act=\"13\">13. Nhận vali</button>\n                    </div>\n                </div>\n\n                <div style=\"display: flex; justify-content: space-between; align-items: center; margin: 8px 0; font-weight: 800; font-size: 14px;\">\n                    <span>Âm lượng hiệu ứng:</span>\n                    <input id=\"setting-volume\" type=\"range\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.85\" style=\"width: 130px; height: 24px;\">\n                </div>\n\n                <div style=\"display: flex; justify-content: space-between; align-items: center; margin: 8px 0; font-weight: 800; font-size: 14px;\">\n                    <span>Giảm hiệu ứng chuyển động:</span>\n                    <input id=\"setting-reduced-motion\" type=\"checkbox\" style=\"width: 22px; height: 22px;\">\n                </div>\n\n                <div style=\"display: flex; gap: 10px; margin-top: 12px;\">\n                    <button id=\"btn-reset-app\" class=\"tycoon-btn\" style=\"flex: 1; font-size: 15px;\">\n                        🔄 Chơi lại từ đầu\n                    </button>\n                    <button id=\"btn-close-parent\" class=\"tycoon-btn tycoon-btn-primary\" style=\"flex: 1; font-size: 15px;\">\n                        Đóng Bảng Cài Đặt ✓\n                    </button>\n                </div>\n            </div>\n        </div>\n\n    </div>\n\n    <!-- Scripts: audio -> effects -> character-renderer -> app -->\n    <script src=\"js/audio.js\"></script>\n    <script src=\"js/effects.js\"></script>\n    <script src=\"js/character-renderer.js\"></script>\n    <script src=\"js/app.js\"></script>\n</body>\n</html>\n","Description":"Cập nhật index.html tái cấu trúc 13 hoạt động độc lập (Intro View + Gameplay View + Feedback Overlay)","Overwrite":true,"TargetFile":"c:\\Demo.plane\\index.html","toolAction":"Writing file","toolSummary":"Update index.html for 13 independent activities"}}]}
