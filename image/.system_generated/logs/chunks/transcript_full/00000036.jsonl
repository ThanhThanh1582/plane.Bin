0 40 180)\" fill=\"url(#skinGradG)\"/>\n    <rect x=\"75\" y=\"180\" width=\"22\" height=\"55\" rx=\"10\" transform=\"rotate(15 75 180)\" fill=\"url(#skinGradG)\"/>\n    <ellipse cx=\"32\" cy=\"235\" rx=\"18\" ry=\"10\" fill=\"#0288D1\"/>\n    <ellipse cx=\"92\" cy=\"235\" rx=\"18\" ry=\"10\" fill=\"#0288D1\"/>\n\n    <!-- Quần short thun xanh -->\n    <path d=\"M 35 140 L 105 140 L 100 190 L 72 190 L 70 165 L 68 190 L 40 190 Z\" fill=\"#42A5F5\" stroke=\"#1976D2\" stroke-width=\"3\"/>\n\n    <!-- Áo thun vàng máy bay -->\n    <rect x=\"35\" y=\"75\" width=\"70\" height=\"70\" rx=\"16\" fill=\"#FDD835\" stroke=\"#F57F17\" stroke-width=\"4\"/>\n    <polygon points=\"60,110 72,100 78,112 68,110\" fill=\"#FFFFFF\"/>\n\n    <!-- Hai cánh tay vẫy chào vui vẻ -->\n    <path d=\"M 35 90 Q 15 110 20 130\" stroke=\"#FDD835\" stroke-width=\"14\" stroke-linecap=\"round\" fill=\"none\"/>\n    <circle cx=\"20\" cy=\"130\" r=\"8\" fill=\"url(#skinGradG)\"/>\n    \n    <path d=\"M 105 90 Q 125 110 120 130\" stroke=\"#FDD835\" stroke-width=\"14\" stroke-linecap=\"round\" fill=\"none\"/>\n    <circle cx=\"120\" cy=\"130\" r=\"8\" fill=\"url(#skinGradG)\"/>\n\n    <!-- Đầu & khuôn mặt Bé Bin -->\n    <circle cx=\"70\" cy=\"38\" r=\"38\" fill=\"url(#skinGradG)\" stroke=\"#FFA726\" stroke-width=\"3\"/>\n    <circle cx=\"32\" cy=\"40\" r=\"8\" fill=\"url(#skinGradG)\"/>\n    <circle cx=\"108\" cy=\"40\" r=\"8\" fill=\"url(#skinGradG)\"/>\n\n    <!-- Tóc đen tròn ngộ nghĩnh có chỏm tóc -->\n    <path d=\"M 32 30 C 32 -2, 108 -2, 108 30 C 100 18, 80 14, 70 20 C 60 14, 40 18, 32 30 Z\" fill=\"#212121\"/>\n    <path d=\"M 70 2 Q 76 -6 74 -8 Q 68 -6 70 2\" fill=\"#212121\"/>\n\n    <!-- Mắt, má hồng, nụ cười -->\n    <circle cx=\"55\" cy=\"35\" r=\"5\" fill=\"#212121\"/>\n    <circle cx=\"53\" cy=\"33\" r=\"2\" fill=\"#FFFFFF\"/>\n    <circle cx=\"85\" cy=\"35\" r=\"5\" fill=\"#212121\"/>\n    <circle cx=\"83\" cy=\"33\" r=\"2\" fill=\"#FFFFFF\"/>\n    <circle cx=\"47\" cy=\"45\" r=\"7\" fil