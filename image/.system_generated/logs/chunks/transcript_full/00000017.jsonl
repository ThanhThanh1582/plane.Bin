lothes-tile-art\" data-clothing-item=\"true\" data-fit=\"soft\" data-type=\"pants\" data-val=\"blue\" aria-label=\"Quần short xanh\">\n                            <img src=\"assets/characters/bin/dress/pants/pants_blue.svg\" class=\"item-img-art\" alt=\"Quần short xanh\">\n                            <span class=\"item-label-tag\">Quần xanh</span>\n                        </button>\n\n                        <!-- 5. Giày dán xé (Soft) -->\n                        <button class=\"clothes-tile-art\" data-clothing-item=\"true\" data-fit=\"soft\" data-type=\"shoes\" data-val=\"blue_velcro\" aria-label=\"Giày dán xé\">\n                            <img src=\"assets/characters/bin/dress/shoes/shoes_blue_velcro.svg\" class=\"item-img-art\" alt=\"Giày dán xé\">\n                            <span class=\"item-label-tag\">Giày dán</span>\n                        </button>\n\n                        <!-- 6. Giày trắng (Soft) -->\n                        <button class=\"clothes-tile-art\" data-clothing-item=\"true\" data-fit=\"soft\" data-type=\"shoes\" data-val=\"white_laces\" aria-label=\"Giày trắng\">\n                            <img src=\"assets/characters/bin/dress/shoes/shoes_white_laces.svg\" class=\"item-img-art\" alt=\"Giày trắng\">\n                            <span class=\"item-label-tag\">Giày trắng</span>\n                        </button>\n                    </div>\n\n                    <!-- Nhân vật Bé Bin Phản Hồi Trực Tiếp Theo Hệ Thống Layer -->\n                    <div class=\"bin-character-stage\">\n                        <div id=\"bin-dress-target\" class=\"bin-stage-pedestal\">\n                            <!-- Mount point cho CharacterRenderer -->\n                            <div id=\"bin-character-mount-lvl1\" class=\"bin-mount-lvl1\"></div>\n                            \n                            <!-- Các huy hiệu trạng thái trang phục -->\n                            <div class=\"dressed-badges-overlay\">\n                                <div i