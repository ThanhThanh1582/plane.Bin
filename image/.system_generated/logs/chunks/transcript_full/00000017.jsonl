\" stroke-width=\"3\"/>\n    <rect x=\"280\" y=\"200\" width=\"40\" height=\"100\" rx=\"20\" transform=\"rotate(30 280 200)\" fill=\"var(--bin-shirt-color, #FDD835)\" stroke=\"#F57F17\" stroke-width=\"3\"/>\n    <circle cx=\"120\" cy=\"180\" r=\"16\" fill=\"url(#skinHB)\"/>\n    <circle cx=\"280\" cy=\"180\" r=\"16\" fill=\"url(#skinHB)\"/>\n\n    <!-- Mô Hình Máy Bay Vàng Óng Ánh & Huy Hiệu -->\n    <g transform=\"translate(140, 130) scale(1.2)\" filter=\"url(#goldGlow)\">\n      <!-- Thân máy bay đồ chơi vàng -->\n      <path d=\"M 0 30 Q 50 15 100 30 Q 80 45 0 30 Z\" fill=\"url(#goldTrophy)\" stroke=\"#E65100\" stroke-width=\"3\"/>\n      <!-- Cánh máy bay -->\n      <polygon points=\"40,20 60,0 70,22\" fill=\"url(#goldTrophy)\" stroke=\"#E65100\" stroke-width=\"2\"/>\n      <polygon points=\"40,35 60,55 70,33\" fill=\"url(#goldTrophy)\" stroke=\"#E65100\" stroke-width=\"2\"/>\n      <!-- Đuôi máy bay -->\n      <polygon points=\"10,24 0,8 18,24\" fill=\"url(#goldTrophy)\" stroke=\"#E65100\" stroke-width=\"2\"/>\n      <circle cx=\"50\" cy=\"28\" r=\"14\" fill=\"#E8F5E9\" stroke=\"#00E676\" stroke-width=\"2\"/>\n      <text x=\"44\" y=\"33\" font-size=\"14\" font-weight=\"bold\" fill=\"#00796B\">★</text>\n    </g>\n\n    <!-- Đầu & Mặt Bé Bin Hân Hoan Tột Đỉnh -->\n    <circle cx=\"200\" cy=\"130\" r=\"85\" fill=\"url(#skinHB)\" stroke=\"#FFA726\" stroke-width=\"4\"/>\n    <circle cx=\"115\" cy=\"135\" r=\"18\" fill=\"url(#skinHB)\"/>\n    <circle cx=\"285\" cy=\"135\" r=\"18\" fill=\"url(#skinHB)\"/>\n    \n    <!-- Tóc nâu đen -->\n    <path d=\"M 115 110 C 115 40, 285 40, 285 110 C 275 85, 230 75, 200 90 C 170 75, 125 85, 115 110 Z\" fill=\"#3E2723\"/>\n    <path d=\"M 195 50 Q 210 20 225 35 Q 215 50 205 55 Z\" fill=\"#3E2723\"/>\n    \n    <!-- Mắt cười tít vui vẻ -->\n    <path d=\"M 155 125 Q 165 115 175 125\" stroke=\"#212121\" stroke-width=\"4\" fill=\"none\" stroke-linecap=\"round\"/>\n    <path d=\"M 225 125 Q 235 115 245 125\" stroke=\"#212121\" stroke-width=\"4\" fill=\"none\" stroke-linecap=\"round\"/>\n\n    <circle cx=\"145\" cy=\"145\" r=\"14\" fill=\"#FF8A80\" opacity=\"0.6\"/>\n    <circle cx=\"255\" cy=\"145\" r=\"14\" fill=\"#FF8A80\" opacity=\"0.6\"/>\n\n    <!-- Miệng cười to hạnh phúc -->\n    <path d=\"M 175 145 Q 200 180 225 145 Z\" fill=\"#D32F2F\" stroke=\"#BF360C\" stroke-width=\"4\"/>\n  </g>\n</svg>\n","Description":"Tạo pose Bé Bin cầm mô hình máy bay vàng nhận thưởng (holding_badge.svg)","Overwrite":true,"TargetFile":"c:\\Demo.plane\\assets\\characters\\bin\\poses\\holding_badge.svg","toolAction":"Writing file","toolSummary":"Create holding_badge.svg pose"}}]}
