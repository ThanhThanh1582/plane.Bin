le=\"font-size: 26px; text-align: center;\">🎟️</div>\n                            <div id=\"stamp-badge-lvl3\" class=\"stamp-badge\">ĐÃ DUYỆT ✓</div>\n                        </div>\n                    </div>\n\n                    <div class=\"station-pod\">\n                        <span style=\"font-weight: 900; font-size: 16px; color: #00897B;\">2. Máy Soi Chiếu</span>\n                        <div class=\"xray-screen-neon\">\n                            <div class=\"xray-tap-box\" data-item=\"🧸\">?</div>\n                            <div class=\"xray-tap-box\" data-item=\"👕\">?</div>\n                            <div class=\"xray-tap-box\" data-item=\"👒\">?</div>\n                        </div>\n                        <div class=\"conveyor-belt\" style=\"width: 85%; margin-top: 6px;\"></div>\n                    </div>\n\n                    <div class=\"station-pod\">\n                        <span style=\"font-weight: 900; font-size: 16px; color: #5E35B1;\">3. Cổng An Ninh</span>\n                        <div id=\"gate-detector-lvl3\" class=\"gate-detector-chunky\">\n                            <div class=\"gate-lamps-row\">\n                                <div class=\"gate-lamp-led\"></div>\n                                <div class=\"gate-lamp-led\"></div>\n                            </div>\n                            <div id=\"bin-character-mount-lvl3\" style=\"width: 75px; height: 110px;\"></div>\n                        </div>\n                    </div>\n                </div>\n\n                <button id=\"btn-next-level-3\" class=\"tycoon-btn tycoon-btn-green hidden\" style=\"margin-top: 14px; font-size: 20px; padding: 12px 28px;\">\n                    Đi Tìm Cửa Bay Nào! 🚪 ➡️\n                </button>\n            </section>\n\n            <!-- ==========================================================================\n                 LEVEL 4: RA CỔNG BAY\n                 ========================================================================== -->\n            <section id=\"screen-4\" class=\"screen\">\n                <div class=\"boarding-hall-arena\">\n                    <div style=\"display: flex; justify-content: center; margin-bottom: 8px;\">\n                        <div class=\"boarding-pass-chunky\" style=\"width: 220px; height: 100px; background: #FFFDE7; border-color: #FFA000;\">\n                            <div style=\"font-size: 14px; font-weight: 900; color: #E65100;\">✈️ VÉ CỦA BÉ BIN</div>\n                            <div style=\"display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 26px;\">\n                                <div class=\"prompt-avatar-sprite speaker-bin\" style=\"width: 38px; height: 38px;\"></div> <strong>CỔNG 03</strong>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"gates-array-row\">\n                        <button class=\"gate-pillar\" data-gate=\"01\">\n                            <span style=\"font-size: 14px;\">CỔNG</span>\n                            <span style=\"font-size: 28px;\">01</span>\n                            <span style=\"font-size: 20px;\">🥕</span>\n                        </button>\n                        <button class=\"gate-pillar\" data-gate=\"02\">\n                            <span style=\"font-size: 14px;\">CỔNG</span>\n                            <span style=\"font-size: 28px;\">02</span>\n                            <span style=\"font-size: 20px;\">🍯</span>\n                        </button>\n                        <button class=\"gate-pillar\" data-gate=\"03\">\n                            <span style=\"font-size: 14px;\">CỔNG</span>\n                            <span style=\"font-size: 28px;\">03</span>\n                            <span style=\"font-size: 20px;\">✈️</span>\n                        </button>\n                        <button class=\"gate-pillar\" data-gate=\"05\">\n                            <span style=\"font-size: 14px;\">CỔNG</span>\n                            <span style=\"font-size: 28px;\">05</span>\n                            <span style=\"font-size: 20px;\">🌲</span>\n                        </button>\n                    </div>\n                </div>\n\n                <button id=\"btn-next-level-4\" class=\"tycoon-btn tycoon-btn-green hidden\" style=\"margin-top: 14px; font-size: 20px; padding: 12px 28px;\">\n                    Vào Ghế Ngồi Thôi! ✈️ ➡️\n                </button>\n            </section>\n\n            <!-- ==========================================================================\n                 LEVEL 5: HIỆP SĨ ĐAI AN TOÀN & UỐNG NƯỚC (LAYERED SEATBELT & DRINKING)\n                 ========================================================================== -->\n            <section id=\"screen-5\" class=\"screen\">\n                <div class=\"cabin-seat-arena\">\n                    <div class=\"seat-plush-box\">\n                        <div id=\"safety-sign-lvl5\" class=\"safety-sign-led\">ĐÈN BÁO CÀI ĐAI</div>\n                        <!-- Mount point cho Bé Bin Seated / Drinking -->\n                        <div id=\"bin-character-mount-lvl5\" class=\"bin-mount-lvl5\"></div>\n                        <div id=\"bin-knight-cape\" class=\"knight-cape-icon\">🦸‍♂️</div>\n                        <div class=\"ear-soundwave left hidden\">〰️</div>\n                        <div class=\"ear-soundwave right hidden\">〰️</div>\n                    </div>\n\n                    <div style=\"display: flex; flex-direction: column; gap: 14px;\">\n                        <div id=\"seatbelt-puzzle-lvl5\" class=\"seatbelt-puzzle\" style=\"background: rgba(255,255,255,0.95); border-radius: 28px; padding: 16px; box-shadow: 0 8px 0 #CFD8DC;\">\n                            <div class=\"seatbelt-straps-row\">\n                                <div id=\"seatbelt-strap-lvl5\" class=\"strap-left\">\n                                    <div class=\"buckle-insert\"></div>\n                                </div>\n                                <div class=\"strap-right\">\n                                    <div class=\"buckle-receiver\"></div>\n                                </div>\n                            </div>\n                        </div>\n\n                        <button id=\"btn-drink-water-lvl5\" class=\"tycoon-btn tycoon-btn-primary hidden\" style=\"font-size: 19px; padding: 14px;\">\n                            🥤 Uống một ngụm nước\n                        </button>\n                    </div>\n                </div>\n\n                <button id=\"btn-next-level-5\" class=\"tycoon-btn tycoon-btn-green hidden\" style=\"margin-top: 14px; font-size: 20px; padding: 12px 28px;\">\n                    Ngắm Mây Qua Cửa Sổ! ☁️ ➡️\n                </button>\n            </section>\n\n            <!-- ==========================================================================\n                 LEVEL 6: NGẮM MÂY BIẾN HÌNH (VỚI BIN LOOKING WINDOW)\n                 ========================================================================== -->\n            <section id=\"screen-6\" class=\"screen\">\n                <div class=\"cloud-stage-grid\">\n                    <div style=\"background: rgba(255,255,255,0.9); border-radius: 36px; padding: 12px; border: 4px solid #81D4FA; display: flex; justify-content: center; align-items: center;\">\n                        <div id=\"bin-character-mount-lvl6\" style=\"width: 150px; height: 220px;\"></div>\n                    </div>\n\n                    <div class=\"cloud-window-frame\">\n                        <button class=\"morph-cloud-tile\" data-morph=\"bunny\">\n                            <span class=\"cloud-icon\" style=\"font-size: 54px;\">☁️</span>\n                            <span class=\"cloud-label\" style=\"font-weight: 900; font-size: 15px; color: #0277BD;\">Mây số 1</span>\n                        </button>\n                        <button class=\"morph-cloud-tile\" data-morph=\"car\">\n                            <span class=\"cloud-icon\" style=\"font-size: 54px;\">☁️</span>\n                            <span class=\"cloud-label\" style=\"font-weight: 900; font-size: 15px; color: #0277BD;\">Mây số 2</span>\n                        </button>\n                        <button class=\"morph-cloud-tile\" data-morph=\"watermelon\">\n                            <span class=\"cloud-icon\" style=\"font-size: 54px;\">☁️</span>\n                            <span class=\"cloud-label\" style=\"font-weight: 900; font-size: 15px; color: #0277BD;\">Mây số 3</span>\n                        </button>\n                        <button class=\"morph-cloud-tile\" data-morph=\"bear\">\n                            <span class=\"cloud-icon\" style=\"font-size: 54px;\">☁️</span>\n                            <span class=\"cloud-label\" style=\"font-weight: 900; font-size: 15px; color: #0277BD;\">Mây số 4</span>\n                        </button>\n                    </div>\n                </div>\n\n                <button id=\"btn-next-level-6\" class=\"tycoon-btn tycoon-btn-green hidden\" style=\"margin-top: 14px; font-size: 20px; padding: 12px 28px;\">\n                    Học Nói Nhỏ Nhé! 🤫 ➡️\n                </button>\n            </section>\n\n            <!-- ==========================================================================\n                 LEVEL 7: MÓN QUÀ LỊCH SỰ (VỚI BIN WHISPERING & SITTING NEAT)\n                 ========================================================================== -->\n            <section id=\"screen-7\" class=\"screen\">\n                <div class=\"etiquette-arena\">\n                    <div class=\"etiquette-card-chunky\">\n                        <div id=\"bin-character-mount-lvl7\" style=\"width: 140px; height: 190px;\"></div>\n                        <span style=\"font-weight: 900; font-size: 19px;\">NÓI NHỎ VỪA ĐỦ NGHE</span>\n                        <div class=\"volume-emotion-options\">\n                            <button class=\"volume-emotion-btn\" data-level=\"loud\" aria-label=\"Nói to\">\n                                <span>😮</span>\n                                <small style=\"font-size: 12px; font-weight: 900; display: block;\">Nói to</small>\n                            </button>\n                            <button class=\"volume-emotion-btn\" data-level=\"medium\" aria-label=\"Nói vừa\">\n                                <span>🙂</span>\n                                <small style=\"font-size: 12px; font-weight: 900; display: block;\">Nói vừa</small>\n                            </button>\n                            <button class=\"volume-emotion-btn\" data-level=\"whisper\" aria-label=\"Nói nhỏ\">\n                                <span>🤫</span>\n                                <small style=\"font-size: 12px; font-weight: 900; display: block;\">Nói nhỏ</small>\n                            </button>\n                        </div>\n                    </div>\n\n                    <div class=\"etiquette-card-chunky\">\n                        <div style=\"font-size: 46px;\">💺</div>\n                        <span style=\"font-weight: 900; font-size: 19px;\">Không Đạp Lưng Ghế</span>\n                        <button id=\"bin-leg-target\" style=\"font-size: 50px; border: none; background: none; cursor: pointer;\" title=\"Chạm để thu chân\">\n                            👟🦶\n                        </button>\n                        <span id=\"leg-status-label\" style=\"font-size: 15px; font-weight: 800; color: #0277BD;\">Chạm để thu chân lại</span>\n                    </div>\n                </div>\n\n                <button id=\"btn-next-level-7\" class=\"tycoon-btn tycoon-btn-green hidden\" style=\"margin-top: 14px; font-size: 20px; padding: 12px 28px;\">\n                    Máy Bay Hạ Cánh Rồi! 🛬 ➡️\n                </button>\n            </section>\n\n            <!-- ==========================================================================\n                 LEVEL 8: LẤY VALI & NHẬN PHẦN THƯỞNG (HOLDING BADGE)\n                 ========================================================================== -->\n            <section id=\"screen-8\" class=\"screen\">\n                <div class=\"carousel-final-arena\">\n                    <button id=\"unbuckle-latch-btn\" class=\"tycoon-btn\" disabled style=\"border: 3px dashed #78909C; font-size: 19px; padding: 14px 28px; opacity: 0.6;\">\n                        <span>⏳ Máy bay đang chạy vào bãi đỗ...</span>\n                    </button>\n\n                    <div id=\"baggage-carousel-lvl8\" class=\"carousel-track-chunky hidden\">\n                        <div class=\"carousel-suitcases-track\">\n                            <button class=\"carousel-bag-tile\" style=\"background: linear-gradient(180deg, #FF5252 0%, #D50000 100%); border: 4px solid #FFD54F;\" data-is-bin=\"true\" aria-label=\"Vali đỏ hình gấu\">\n                                <span>🐻</span>\n                            </button>\n                            <button class=\"carousel-bag-tile\" style=\"background: linear-gradient(180deg, #29B6F6 0%, #0288D1 100%); border: 4px solid #FFF;\" data-is-bin=\"false\" aria-label=\"Vali xanh tên lửa\">\n                                <span>🚀</span>\n                            </button>\n                            <button class=\"carousel-bag-tile\" style=\"background: linear-gradient(180deg, #FFEE58 0%, #FDD835 100%); border: 4px solid #FFF;\" data-is-bin=\"false\" aria-label=\"Vali vàng quả cherry\">\n                                <span>🍒</span>\n                            </button>\n                            <button class=\"carousel-bag-tile\" style=\"background: linear-gradient(180deg, #ECEFF1 0%, #B0BEC5 100%); border: 4px solid #FFF;\" data-is-bin=\"false\" aria-label=\"Vali bạc bóng đá\">\n                                <span>⚽</span>\n                            </button>\n                            <button class=\"carousel-bag-tile\" style=\"background: linear-gradient(180deg, #BA68C8 0%, #7B1FA2 100%); border: 4px solid #FFF;\" data-is-bin=\"false\" aria-label=\"Vali tím ngôi sao\">\n                                <span>⭐</span>\n                            </button>\n                        </div>\n                    </div>\n                </div>\n\n                <div id=\"golden-medal-modal\" class=\"golden-medal-modal\">\n                    <div style=\"display: flex; justify-content: center; margin-bottom: 6px;\">\n                        <!-- Mount point cho Bé Bin Cầm Mô Hình Thưởng -->\n                        <div id=\"bin-character-mount-lvl8\" style=\"width: 140px; height: 190px;\"></div>\n                    </div>\n                    <h2 style=\"font-size: 26px; font-weight: 900; color: #E65100; margin: 6px 0;\">HÀNH KHÁCH NHÍ XUẤT SẮC</h2>\n                    <div style=\"background: #E1F5FE; color: #0277BD; padding: 6px 18px; border-radius: 999px; font-weight: 900; font-size: 15px; display: inline-block;\">\n                        🌟 BÉ BIN ĐÃ HOÀN THÀNH CHUYẾN BAY ĐẦU TIÊN 🌟\n                    </div>\n\n                    <button id=\"btn-replay-adventure\" class=\"tycoon-btn tycoon-btn-primary\" style=\"font-size: 19px; padding: 12px 30px; margin-top: 14px;\">\n                        🔄 Chơi Lại Cùng Bin\n                    </button>\n                </div>\n            </section>\n\n        </main>\n\n        <!-- MODAL CỔNG BA MẸ (3-SECOND PARENT CONTROL HUB) -->\n        <div id=\"parent-modal\" class=\"parent-modal-overlay\">\n            <div class=\"parent-control-card\">\n                <h2 style=\"color: #D84315; font-size: 23px; margin-bottom: 12px;\">🛡️ Cổng Dành Cho Ba Mẹ</h2>\n                \n                <div class=\"parent-tip-box\">\n                    <strong>💡 Giúp tai bé dễ chịu khi máy bay lên/xuống:</strong> Khi cất cánh hoặc hạ cánh, cho bé ngồi thẳng và uống từng ngụm nước nhỏ để khuyến khích động tác nuốt, giúp tai dễ chịu hơn. Nếu bé đau tai nhiều hoặc đang có bệnh lý tai mũi họng, ba mẹ nên tham khảo ý kiến bác sĩ trước chuyến bay.\n                </div>\n\n                <div class=\"parent-tip-box\">\n                    <strong>💡 Chuẩn bị tâm lý trước chuyến đi:</strong> Cùng bé xem trước các bước trong ứng dụng này để bé làm quen với không khí sân bay và các bước an toàn trước khi bay thực tế.\n                </div>\n\n                <div style=\"margin: 12px 0;\">\n                    <strong style=\"font-size: 15px; color: #37474F;\">Chọn nhanh màn chơi:</strong>\n                    <div class=\"level-jump-grid\">\n                        <button class=\"jump-btn\" data-level=\"1\">1. Mặc đồ</button>\n                        <button class=\"jump-btn\" data-level=\"2\">2. Xếp vali</button>\n                        <button class=\"jump-btn\" data-level=\"3\">3. An ninh</button>\n                        <button class=\"jump-btn\" data-level=\"4\">4. Cổng bay</button>\n                        <button class=\"jump-btn\" data-level=\"5\">5. Đai an toàn</button>\n                        <button class=\"jump-btn\" data-level=\"6\">6. Ngắm mây</button>\n                        <button class=\"jump-btn\" data-level=\"7\">7. Lịch sự</button>\n                        <button class=\"jump-btn\" data-level=\"8\">8. Nhận vali</button>\n                    </div>\n                </div>\n\n                <div style=\"display: flex; justify-content: space-between; align-items: center; margin: 10px 0; font-weight: 800;\">\n                    <span>Âm lượng hiệu ứng:</span>\n                    <input id=\"setting-volume\" type=\"range\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.85\" style=\"width: 140px; height: 26px;\">\n                </div>\n\n                <div style=\"display: flex; justify-content: space-between; align-items: center; margin: 10px 0; font-weight: 800;\">\n                    <span>Giảm hiệu ứng chuyển động:</span>\n                    <input id=\"setting-reduced-motion\" type=\"checkbox\" style=\"width: 24px; height: 24px;\">\n                </div>\n\n                <div style=\"display: flex; gap: 10px; margin-top: 14px;\">\n                    <button id=\"btn-reset-app\" class=\"tycoon-btn\" style=\"flex: 1; font-size: 16px;\">\n                        🔄 Chơi lại từ đầu\n                    </button>\n                    <button id=\"btn-close-parent\" class=\"tycoon-btn tycoon-btn-primary\" style=\"flex: 1; font-size: 16px;\">\n                        Đóng Bảng Cài Đặt ✓\n                    </button>\n                </div>\n            </div>\n        </div>\n\n    </div>\n\n    <!-- Scripts: character-renderer.js tải trước app.js -->\n    <script src=\"js/audio.js\"></script>\n    <script src=\"js/effects.js\"></script>\n    <script src=\"js/character-renderer.js\"></script>\n    <script src=\"js/app.js\"></script>\n</body>\n</html>\n","Description":"Cập nhật index.html tích hợp character-renderer.js và các mount point xuyên suốt 8 màn","Overwrite":true,"TargetFile":"c:\\Demo.plane\\index.html","toolAction":"Writing file","toolSummary":"Update index.html with character mount points"}}]}
