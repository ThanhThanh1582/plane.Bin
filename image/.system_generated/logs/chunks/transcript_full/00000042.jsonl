{"step_index":907,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-27T02:48:05Z","content":"Created At: 2026-08-27T09:48:05+07:00\nCompleted At: 2026-08-27T09:48:05+07:00\nFile Path: `file:///c:/Demo.plane/js/character-renderer.js`\nTotal Lines: 159\nTotal Bytes: 6232\nShowing lines 1 to 140\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: /**\n2:  * character-renderer.js\n3:  * Multi-layer Dynamic Character Renderer for Bé Bin (viewBox=\"0 0 400 600\")\n4:  * \n5:  * Quản lý đồng bộ toàn bộ các mount [data-bin-character] trên trang.\n6:  * Đảm bảo 100% nhân vật Bé Bin xuất phát từ 1 nguồn duy nhất (Multi-layer Overlay).\n7:  */\n8: \n9: class BinCharacterRenderer {\n10:     constructor() {\n11:         this.currentOutfit = {\n12:             shirt: null,\n13:             pants: null,\n14:             shoes: null,\n15:             seatbelt: null\n16:         };\n17: \n18:         this.assetMap = {\n19:             base: 'assets/characters/bin/dress/bin_base.svg',\n20:             shirts: {\n21:                 yellow: 'assets/characters/bin/dress/shirts/shirt_yellow.svg',\n22:                 soft: 'assets/characters/bin/dress/shirts/shirt_yellow.svg',\n23:                 blue: 'assets/characters/bin/dress/shirts/shirt_blue.svg'\n24:             },\n25:             pants: {\n26:                 blue: 'assets/characters/bin/dress/pants/pants_blue.svg',\n27:                 soft: 'assets/characters/bin/dress/pants/pants_blue.svg',\n28:                 orange: 'assets/characters/bin/dress/pants/pants_orange.svg'\n29:             },\n30:             shoes: {\n31:                 velcro: 'assets/characters/bin/dress/shoes/shoes_blue_velcro.svg',\n32:                 blue_velcro: 'assets/characters/bin/dress/shoes/shoes_blue_velcro.svg',\n33:                 white_laces: 'assets/characters/bin/dress/shoes/shoes_white_laces.svg'\n34:             },\n35:             seatbelt: {\n36:                 fastened: 'assets/characters/bin/layers/seatbelt_fastened.svg',\n37:                 none: null\n38:             }\n39:         };\n40: \n41:         this.containers = new Set();\n42: \n43:         // Tự động mount khi DOM sẵn sàng\n44:         if (document.readyState === 'loading') {\n45:             document.addEventListener('DOMContentLoaded', () => this.mountAll());\n46:         } else {\n47:             this.mountAll();\n48:         }\n49:     }\n50: \n51:     mountAll() {\n52:         document.querySelectorAll('[data-bin-character]').forEach(el => {\n53:             this.renderTo(el);\n54:         });\n55:     }\n56: \n57:     renderTo(containerOrId) {\n58:         const container = typeof containerOrId === 'string' ? document.getElementById(containerOrId) : containerOrId;\n59:         if (!container) return;\n60: \n61:         this.containers.add(container);\n62:         this.setupDOM(container);\n63:         this.updateLayers(container);\n64:     }\n65: \n66:     setupDOM(container) {\n67:         // Xóa hoàn toàn các thẻ sprite cũ hoặc text\n68:         container.innerHTML = '';\n69:         container.classList.add('bin-layered-character');\n70: \n71:         // Tạo cấu trúc 4+ layer chuẩn: Base (Relative) -> Pants -> Shirt -> Shoes -> Seatbelt (Absolute Overlays)\n72:         container.innerHTML = `\n73:             <div class=\"bin-layers-wrapper\" style=\"position: relative; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;\">\n74:                 <img class=\"bin-layer bin-base-layer\" src=\"${this.assetMap.base}\" alt=\"Bé Bin\" style=\"position: relative; width: 100%; height: 100%; object-fit: contain; z-index: 1;\">\n75:                 <img class=\"bin-layer bin-pants-layer\" style=\"position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; z-index: 2; display: none;\" alt=\"Quần Bé Bin\">\n76:                 <img class=\"bin-layer bin-shirt-layer\" style=\"position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; z-index: 3; display: none;\" alt=\"Áo Bé Bin\">\n77:                 <img class=\"bin-layer bin-shoes-layer\" style=\"position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; z-index: 4; display: none;\" alt=\"Giày Bé Bin\">\n78:                 <img class=\"bin-layer bin-seatbelt-layer\" style=\"position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; z-index: 5; display: none;\" alt=\"Dây an toàn\">\n79:             </div>\n80:         `;\n81:     }\n82: \n83:     updateLayers(container) {\n84:         if (!container) return;\n85:         const pantsImg = container.querySelector('.bin-pants-layer');\n86:         const shirtImg = container.querySelector('.bin-shirt-layer');\n87:         const shoesImg = container.querySelector('.bin-shoes-layer');\n88:         const seatbeltImg = container.querySelector('.bin-seatbelt-layer');\n89: \n90:         if (pantsImg) {\n91:             if (this.currentOutfit.pants && this.assetMap.pants[this.currentOutfit.pants]) {\n92:                 pantsImg.src = this.assetMap.pants[this.currentOutfit.pants];\n93:                 pantsImg.style.display = 'block';\n94:             } else {\n95:                 pantsImg.style.display = 'none';\n96:             }\n97:         }\n98: \n99:         if (shirtImg) {\n100:             if (this.currentOutfit.shirt && this.assetMap.shirts[this.currentOutfit.shirt]) {\n101:                 shirtImg.src = this.assetMap.shirts[this.currentOutfit.shirt];\n102:                 shirtImg.style.display = 'block';\n103:             } else {\n104:                 shirtImg.style.display = 'none';\n105:             }\n106:         }\n107: \n108:         if (shoesImg) {\n109:             if (this.currentOutfit.shoes && this.assetMap.shoes[this.currentOutfit.shoes]) {\n110:                 shoesImg.src = this.assetMap.shoes[this.currentOutfit.shoes];\n111:                 shoesImg.style.display = 'block';\n112:             } else {\n113:                 shoesImg.style.display = 'none';\n114:             }\n115:         }\n116: \n117:         if (seatbeltImg) {\n118:             if (this.currentOutfit.seatbelt && this.assetMap.seatbelt[this.currentOutfit.seatbelt]) {\n119:                 seatbeltImg.src = this.assetMap.seatbelt[this.currentOutfit.seatbelt];\n120:                 seatbeltImg.style.display = 'block';\n121:             } else {\n122:                 seatbeltImg.style.display = 'none';\n123:             }\n124:         }\n125:     }\n126: \n127:     setShirt(shirtKey) {\n128:         this.currentOutfit.shirt = shirtKey;\n129:         this.refreshAll();\n130:     }\n131: \n132:     setPants(pantsKey) {\n133:         this.currentOutfit.pants = pantsKey;\n134:         this.refreshAll();\n135:     }\n136: \n137:     setShoes(shoesKey) {\n138:         this.currentOutfit.shoes = shoesKey;\n139:         this.refreshAll();\n140:     }\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
