n+    font-weight: 900;\n+    color: #37474F;\n+    text-align: center;\n+    line-height: 1.1;\n+    pointer-events: none;\n+}\n+\n+.luggage-item-card.runtime-packed {\n+    opacity: 0.45;\n+    pointer-events: none;\n+    border-color: #81C784 !important;\n+    background: #F1F8E9 !important;\n+}\n+\n+.luggage-item-card.wobble-shake {\n+    animation: springShake 0.45s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;\n+    border-color: #E53935 !important;\n+    background: #FFEBEE !important;\n+}\n+\n+.packed-item-mini {\n+    background: rgba(255, 255, 255, 0.96);\n+    border: 2px solid #0288D1;\n+    border-radius: 12px;\n+    padding: 3px 8px;\n+    display: flex;\n+    align-items: center;\n+    gap: 6px;\n+    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.16);\n+    animation: popBounce 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);\n+}\n+\n+.packed-item-mini img {\n+    width: 26px;\n+    height: 26px;\n+    object-fit: contain;\n+}\n+\n+.packed-item-mini span {\n+    font-size: 11px;\n+    font-weight: 900;\n+    color: #01579B;\n+}\n+\n+/* ==========================================================================\n+   TRẮC NGHIỆM HÌNH ẢNH TƯƠNG TÁC (VISUAL CHOICE QUIZ) CHO CÁC CHẶNG\n+   ========================================================================== */\n+.visual-quiz-container {\n+    display: flex;\n+    gap: 16px;\n+    align-items: center;\n+    justify-content: center;\n+    width: 100%;\n+}\n+\n+.visual-quiz-card {\n+    background: #FFFFFF;\n+    border: 3px solid #FFE082;\n+    box-shadow: 0 6px 0 #FFCA28, 0 8px 20px rgba(0, 0, 0, 0.12);\n+    border-radius: 20px;\n+    padding: 10px 14px;\n+    display: flex;\n+    flex-direction: column;\n+    align-items: center;\n+    justify-content: center;\n+    gap: 8px;\n+    cursor: pointer;\n+    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease, border-color 0.2s ease;\n+    min-width: 150px;\n+    max-width: 180px;\n+    outline: none;\n+    user-select: none;\n+}\n+\n+.visual-quiz-card:hover {\n+    transform: translateY(-4px) scale(1.05);\n+    box-shadow: 0 10px 0 #FFB300, 0 12px 24px rgba(0, 0, 0, 0.16);\n+    border-color: #FFA000;\n+}\n+\n+.visual-quiz-card:active {\n+    transform: scale(0.96);\n+}\n+\n+.visual-quiz-card img {\n+    width: 80px;\n+    height: 80px;\n+    object-fit: contain;\n+    border-radius: 14px;\n+    pointer-events: none;\n+    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);\n+}\n+\n+.visual-quiz-card .quiz-label {\n+    font-size: 13px;\n+    font-weight: 900;\n+    color: #263238;\n+    text-align: center;\n+    line-height: 1.2;\n+}\n+\n+.visual-quiz-card.correct {\n+    border-color: #4CAF50 !important;\n+    box-shadow: 0 6px 0 #2E7D32, 0 8px 22px rgba(76, 175, 80, 0.35) !important;\n+    background: #E8F5E9 !important;\n+}\n+\n+.visual-quiz-card.incorrect {\n+    animation: springShake 0.45s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;\n+    border-color: #E53935 !important;\n+    box-shadow: 0 6px 0 #C62828, 0 8px 20px rgba(229, 57, 53, 0.25) !important;\n+    background: #FFEBEE !important;\n }\n \n[diff_block_end]\n\nPlease note that the above snippet only shows the MODIFIED lines from the last change. It shows up to 3 lines of unchanged lines before and after the modified lines. The actual file contents may have many more lines not shown."}
