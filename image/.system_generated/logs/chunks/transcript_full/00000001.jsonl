. For Screen 4, I'm working on a seatbelt puzzle with sound and visual feedback, a toggleable engine noise, and a takeoff sequence with dynamic window backgrounds. I'm focusing on user-friendly interactions. Finally, I've got a carousel animation ready for Screen 5.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"/**\n * app.js - Main Controller & Game Logic for \"Bé Đi Máy Bay\"\n * Tối ưu hóa phản xạ mầm non 3-4 tuổi (Tap, Drag, Audio, Visual cues)\n */\n\nclass KidFlightApp {\n    constructor() {\n        this.currentScreen = 1;\n        this.totalScreens = 5;\n        this.selectedSticker = '⭐';\n        this.packedCount = 0;\n        this.requiredPacked = 3;\n        this.screen2Steps = { pass: false, xray: false, gate: false };\n        this.seatbeltLocked = false;\n        this.isFlying = false;\n\n        // Parent Gate Hold Timer\n        this.parentHoldTimer = null;\n        this.parentHoldStart = 0;\n        this.parentHoldReqId = null;\n\n        this.init();\n    }\n\n    init() {\n        this.bindEvents();\n        this.initScreen1();\n        this.showScreen(1);\n    }\n\n    // --- NAVIGATION & SCREEN CONTROLLER ---\n    showScreen(screenNum) {\n        if (screenNum < 1 || screenNum > this.totalScreens) return;\n\n        // Dọn dẹp trạng thái màn hình cũ nếu cần\n        if (this.currentScreen === 4 && screenNum !== 4) {\n            if (window.audioMgr) window.audioMgr.stopEngineSound();\n        }\n\n        this.currentScreen = screenNum;\n\n        // Cập nhật DOM\n        document.querySelectorAll('.screen').forEach((scr, idx) => {\n            if (idx + 1 === screenNum) {\n                scr.classList.add('active');\n            } else {\n                scr.classList.remove('active');\n            }\n        });\n\n        // Cập nhật thanh chỉ thị tiến trình (Stage dots)\n        document.querySelectorAll('.stage-dot').forEach((dot, idx) => {\n            dot.classList.remove('active');\n            if (idx + 1 === screenNum) {\n                dot.classList.add('active');\n            }\n            if (idx + 1 < screenNum) {\n                dot.classList.add('completed');\n            }\n        });\n\n        // Kích hoạt kịch bản giọng đọc của màn hình tương ứng\n        this.triggerScreenVoice(screenNum);\n    }\n\n    triggerScreenVoice(screenNum) {\n        if (!window.audioMgr) return;\n\n        switch (screenNum) {\n            case 1:\n                window.audioMgr.speak('Bé ơi, cùng chuẩn bị vali đi chơi nhé! Kéo những món đồ ngoan vào vali nào!');\n                break;\n            case 2:\n                window.audioMgr.speak('Đến quầy làm thủ tục rồi! Bé chạm vào vé đưa cho chú gấu nhé!');\n                break;\n            case 3:\n                window.audioMgr.speak('Đang ở phòng chờ nè! Bé chạm vào các chiếc máy bay xem chúng bay lên nhé!');\n                break;\n            case 4:\n                window.audioMgr.speak('Chào mừng bé lên máy bay! Cùng thắt dây an toàn thật chắc chắn nào!');\n                break;\n            case 5:\n                window.audioMgr.speak('Máy bay hạ cánh rồi! Bé hãy tìm chiếc vali có dán sticker của mình trên băng chuyền nhé!');\n                break;\n        }\n    }\n\n    // --- GLOBAL EVENT BINDINGS ---\n    bindEvents() {\n        // Nút giọng nói nhắc lại\n        const btnVoice = document.getElementById('btn-repeat-voice');\n        if (btnVoice) {\n            btnVoice.addEventListener('click', () => {\n                if (window.audioMgr) {\n                    window.audioMgr.playPop();\n                    this.triggerScreenVoice(this.currentScreen);\n                }\n            });\n        }\n\n        // Mascot click để nói chuyện\n        const mascot = document.getElementById('mascot-guide');\n        if (mascot) {\n            mascot.addEventListener('click', () => {\n                if (window.audioMgr) {\n                    window.audioMgr.playPop();\n                    this.triggerScreenVoice(this.currentScreen);\n                }\n            });\n        }\n\n        // Nút Phụ Huynh: Cần giữ 3 giây\n        const parentBtn = document.getElementById('btn-parent-gate');\n        const holdCircle = document.getElementById('parent-ring-circle');\n        const modal = document.getElementById('parent-modal');\n        const closeModalBtn = document.getElementById('btn-close-parent');\n\n        if (parentBtn && holdCircle) {\n            const startHold = (e) => {\n                e.preventDefault();\n                this.parentHoldStart = Date.now();\n                const totalHold = 3000;\n\n                const updateRing = () => {\n                    const elapsed = Date.now() - this.parentHoldStart;\n                    const progress = Math.min(1, elapsed / totalHold);\n                    const offset = 175 - (175 * progress);\n                    holdCircle.style.strokeDashoffset = offset;\n\n                    if (progress >= 1) {\n                        // Mở cổng thành công\n                        if (window.audioMgr) window.audioMgr.playTing();\n                        modal.classList.add('open');\n                        resetHold();\n                    } else {\n                        this.parentHoldReqId = requestAnimationFrame(updateRing);\n                    }\n                };\n\n                this.parentHoldReqId = requestAnimationFrame(updateRing);\n            };\n\n            const resetHold = () => {\n                if (this.parentHoldReqId) cancelAnimationFrame(this.parentHoldReqId);\n                holdCircle.style.strokeDashoffset = 175;\n            };\n\n            parentBtn.addEventListener('pointerdown', startHold);\n            parentBtn.addEventListener('pointerup', resetHold);\n            parentBtn.addEventListener('pointerleave', resetHold);\n            parentBtn.addEventListener('pointercancel', resetHold);\n        }\n\n        if (closeModalBtn && modal) {\n            closeModalBtn.addEventListener('click', () => {\n                if (window.audioMgr) window.audioMgr.playPop();\n                modal.classList.remove('open');\n            });\n        }\n\n        // Cài đặt âm thanh trong Cổng Phụ Huynh\n        const volSlider = document.getElementById('setting-volume');\n        if (volSlider) {\n            volSlider.addEventListener('input', (e) => {\n                if (window.audioMgr) window.audioMgr.volume = parseFloat(e.target.value);\n            });\n        }\n\n        const voiceToggle = document.getElementById('setting-voice');\n        if (voiceToggle) {\n            voiceToggle.addEventListener('change', (e) => {\n                if (window.audioMgr) window.audioMgr.voiceEnabled = e.target.checked;\n            });\n        }\n\n        // Chuyển màn hình trực tiếp bằng Stage dots (hỗ trợ thử nghiệm/phụ huynh)\n        document.querySelectorAll('.stage-dot').forEach((dot) => {\n            dot.addEventListener('click', (e) => {\n                const targetScreen = parseInt(dot.getAttribute('data-screen'), 10);\n                if (targetScreen) {\n                    if (window.audioMgr) window.audioMgr.playPop();\n                    this.showScreen(targetScreen);\n                }\n            });\n        });\n    }\n\n    // ==========================================================================\n    // MÀN HÌNH 1: SOẠN VALI & KÉO THẢ (DRAG & DROP)\n    // ==========================================================================\n    initScreen1() {\n        const luggageItems = document.querySelectorAll('.luggage-item');\n        const suitcaseBox = document.getElementById('suitcase-drop-target');\n        const suitcaseInner = document.getElementById('suitcase-packed-items');\n        const btnNext1 = document.getElementById('btn-next-screen-1');\n\n        // Chọn Sticker\n        document.querySelectorAll('.sticker-btn').forEach(btn => {\n            btn.addEventListener('click', (e) => {\n                document.querySelectorAll('.sticker-btn').forEach(b => b.classList.remove('selected'));\n                btn.classList.add('selected');\n                this.selectedSticker = btn.getAttribute('data-sticker') || '⭐';\n                const badge = document.getElementById('suitcase-sticker-display');\n                if (badge) badge.textContent = this.selectedSticker;\n                if (window.audioMgr) {\n                    window.audioMgr.playPop();\n                    window.audioMgr.speak('Bé chọn hình ' + btn.getAttribute('data-name') + ' thật là đẹp!');\n                }\n            });\n        });\n\n        // Xử lý kéo thả bằng Pointer Events (chuẩn cho cả Touch & Mouse)\n        luggageItems.forEach(item => {\n            let startX = 0, startY = 0;\n            let initialX = 0, initialY = 0;\n            let isDragging = false;\n\n            const onPointerDown = (e) => {\n                if (item.classList.contains('packed')) return;\n                isDragging = true;\n                item.setPointerCapture(e.pointerId);\n                startX = e.clientX;\n                startY = e.clientY;\n                initialX = item.offsetLeft;\n                initialY = item.offsetTop;\n                item.style.zIndex = '999';\n                item.style.transition = 'none';\n            };\n\n            const onPointerMove = (e) => {\n                if (!isDragging) return;\n                const dx = e.clientX - startX;\n                const dy = e.clientY - startY;\n                item.style.transform = `translate(${dx}px, ${dy}px) scale(1.15) rotate(4deg)`;\n\n                // Kiểm tra va chạm với Vali\n                const itemRect = item.getBoundingClientRect();\n                const suitcaseRect = suitcaseBox.getBoundingClientRect();\n\n                const isOver = !(\n                    itemRect.right < suitcaseRect.left ||\n                    itemRect.left > suitcaseRect.right ||\n                    itemRect.bottom < suitcaseRect.top ||\n                    itemRect.top > suitcaseRect.bottom\n                );\n\n                if (isOver) {\n                    suitcaseBox.classList.add('drag-over');\n                } else {\n                    suitcaseBox.classList.remove('drag-over');\n                }\n            };\n\n            const onPointerUp = (e) => {\n                if (!isDragging) return;\n                isDragging = false;\n                item.releasePointerCapture(e.pointerId);\n                suitcaseBox.classList.remove('drag-over');\n\n                const itemRect = item.getBoundingClientRect();\n                const suitcaseRect = suitcaseBox.getBoundingClientRect();\n\n                const isOver = !(\n                    itemRect.right < suitcaseRect.left ||\n                    itemRect.left > suitcaseRect.right ||\n                    itemRect.bottom < suitcaseRect.top ||\n                    itemRect.top > suitcaseRect.bottom\n                );\n\n                const isForbidden = item.getAttribute('data-forbidden') === 'true';\n\n                if (isOver) {\n                    if (isForbidden) {\n                        // Vật bị cấm: Nảy ngược về kèm cảnh báo\n                        item.style.transition = 'transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1)';\n                        item.style.transform = 'translate(0px, 0px)';\n                        item.style.zIndex = '1';\n\n                        if (window.audioMgr) {\n                            window.audioMgr.playBoing();\n                            window.audioMgr.speak('Món này cất ở nhà nha con, máy bay không chở được đâu nè!');\n                        }\n\n                        // Hiệu ứng rung nảy cảnh báo\n                        item.style.boxShadow = '0 0 20px #FF5252';\n                        setTimeout(() => { item.style.boxShadow = ''; }, 600);\n                    } else {\n                        // Đúng vật phẩm được mang: Xếp vào vali\n                        item.classList.add('packed');\n                        item.style.display = 'none';\n\n                        // Thêm icon nhỏ vào bên trong vali\n                        const iconSpan = document.createElement('span');\n                        iconSpan.textContent = item.querySelector('.item-icon').textContent;\n                        iconSpan.style.fontSize = '32px';\n                        iconSpan.className = 'pop-in';\n                        suitcaseInner.appendChild(iconSpan);\n\n                        this.packedCount++;\n\n                        if (window.effectsMgr) {\n                            const rect = suitcaseBox.getBoundingClientRect();\n                            window.effectsMgr.burstStarsAt(rect.left + rect.width / 2, rect.top + rect.height / 2);\n                        }\n\n                        if (window.audioMgr) {\n                            window.audioMgr.playTing();\n                        }\n\n                        // Nếu đã đủ đồ, hiển thị nút tiếp theo\n                        if (this.packedCount >= this.requiredPacked) {\n                            btnNext1.classList.remove('hidden');\n                            btnNext1.classList.add('pop-in');\n                            if (window.audioMgr) {\n                                setTimeout(() => {\n                                    window.audioMgr.speak('Giỏi quá! Vali đã đầy đủ rồi, cùng đi đến sân bay nào!');\n                                }, 600);\n                            }\n                        }\n                    }\n                } else {\n                    // Thả bên ngoài: Trở về vị trí cũ\n                    item.style.transition = 'transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1)';\n                    item.style.transform = 'translate(0px, 0px)';\n                    item.style.zIndex = '1';\n                }\n            };\n\n            item.addEventListener('pointerdown', onPointerDown);\n            item.addEventListener('pointermove', onPointerMove);\n            item.addEventListener('pointerup', onPointerUp);\n            item.addEventListener('pointercancel', onPointerUp);\n        });\n\n        // Bấm nút qua Màn 2\n        if (btnNext1) {\n            btnNext1.addEventListener('click', () => {\n                if (window.audioMgr) window.audioMgr.playPop();\n                this.initScreen2();\n                this.showScreen(2);\n            });\n        }\n    }\n\n    // ==========================================================================\n    // MÀN HÌNH 2: CHECK-IN & SOI CHIẾU AN NINH\n    // ==========================================================================\n    initScreen2() {\n        const boardingPass = document.getElementById('checkin-boarding-pass');\n        const stampBadge = document.getElementById('stamp-passed');\n        const xrayMachine = document.getElementById('station-xray');\n        const securityGate = document.getElementById('station-security-gate');\n        const gateLamps = document.querySelectorAll('.gate-lamp');\n        const kidWalker = document.getElementById('security-kid-walker');\n        const btnNext2 = document.getElementById('btn-next-screen-2');\n\n        // Bước 1: Chạm vé máy bay đưa cho chú gấu\n        if (boardingPass) {\n            boardingPass.onclick = () => {\n                if (this.screen2Steps.pass) return;\n                this.screen2Steps.pass = true;\n\n                if (window.audioMgr) {\n                    window.audioMgr.playStamp();\n                    setTimeout(() => {\n                        window.audioMgr.speak('Chào bé! Vé hợp lệ rồi, mời bé cho vali qua máy soi nhé!');\n                    }, 400);\n                }\n\n                if (stampBadge) stampBadge.classList.add('stamped');\n                boardingPass.style.background = '#C8E6C9';\n                this.checkScreen2Completion();\n            };\n        }\n\n        // Bước 2: Chạm máy X-quang để soi vali\n        if (xrayMachine) {\n            xrayMachine.onclick = () => {\n                if (this.screen2Steps.xray) return;\n                this.screen2Steps.xray = true;\n\n                if (window.audioMgr) {\n                    window.audioMgr.playTing();\n                    window.audioMgr.speak('Vali an toàn! Không có đồ vật cấm, bé đi qua cổng từ nào!');\n                }\n\n                xrayMachine.style.boxShadow = '0 0 25px #00E676';\n                if (window.effectsMgr) {\n                    const rect = xrayMachine.getBoundingClientRect();\n                    window.effectsMgr.burstStarsAt(rect.left + rect.width / 2, rect.top + rect.height / 2);\n                }\n                this.checkScreen2Completion();\n            };\n        }\n\n        // Bước 3: Chạm cổng an ninh để bước qua\n        if (securityGate) {\n            securityGate.onclick = () => {\n                if (this.screen2Steps.gate) return;\n                this.screen2Steps.gate = true;\n\n                // Hiệu ứng đèn xanh nhấp nháy + tiếng bíp boong\n                gateLamps.forEach(lamp => lamp.classList.add('green-flash'));\n                if (kidWalker) {\n                    kidWalker.style.transform = 'translateY(-15px) scale(1.15)';\n                }\n\n                if (window.audioMgr) {\n                    window.audioMgr.playBeepBoop();\n                    setTimeout(() => {\n                        window.audioMgr.speak('Bíp boong! Bé đã qua cổng an ninh thành công rồi!');\n                    }, 400);\n                }\n\n                this.checkScreen2Completion();\n            };\n        }\n\n        if (btnNext2) {\n            btnNext2.addEventListener('click', () => {\n                if (window.audioMgr) window.audioMgr.playPop();\n                this.initScreen3();\n                this.showScreen(3);\n            });\n        }\n    }\n\n    checkScreen2Completion() {\n        const btnNext2 = document.getElementById('btn-next-screen-2');\n        if (this.screen2Steps.pass && this.screen2Steps.xray && this.screen2Steps.gate) {\n            if (btnNext2) {\n                btnNext2.classList.remove('hidden');\n                btnNext2.classList.add('pop-in');\n            }\n        }\n    }\n\n    // ==========================================================================\n    // MÀN HÌNH 3: PHÒNG CHỜ SÂN BAY (AIRPORT LOUNGE)\n    // ==========================================================================\n    initScreen3() {\n        const miniPlanes = document.querySelectorAll('.mini-plane-parked');\n        const fidsBoard = document.getElementById('fids-board-lounge');\n        const btnNext3 = document.getElementById('btn-next-screen-3');\n\n        // Chạm vào máy bay mini để cất cánh\n        miniPlanes.forEach(plane => {\n            plane.onclick = () => {\n                if (plane.classList.contains('mini-plane-flying')) return;\n\n                plane.classList.add('mini-plane-flying');\n                if (window.audioMgr) {\n                    window.audioMgr.playWhoosh();\n                }\n                if (window.effectsMgr) {\n                    const rect = plane.getBoundingClientRect();\n                    window.effectsMgr.burstStarsAt(rect.left, rect.top);\n                }\n\n                // Reset sau 3 giây để bé có thể chơi lại\n                setTimeout(() => {\n                    plane.classList.remove('mini-plane-flying');\n                }, 3000);\n            };\n        });\n\n        // Chạm vào bảng giờ bay phát thanh\n        if (fidsBoard) {\n            fidsBoard.onclick = () => {\n                if (window.audioMgr) {\n                    window.audioMgr.playCabinChime();\n                    setTimeout(() => {\n                        window.audioMgr.speak('Kính mời quý khách nhí đến cửa số 8, chuẩn bị lên máy bay cất cánh!');\n                    }, 500);\n                }\n                fidsBoard.style.boxShadow = '0 0 20px #FFD54F';\n                setTimeout(() => { fidsBoard.style.boxShadow = ''; }, 1000);\n            };\n        }\n\n        if (btnNext3) {\n            btnNext3.addEventListener('click', () => {\n                if (window.audioMgr) window.audioMgr.playPop();\n                this.initScreen4();\n                this.showScreen(4);\n            });\n        }\n    }\n\n    // ==========================================================================\n    // MÀN HÌNH 4: TRÊN KHOANG MÁY BAY & CẤT CÁNH\n    // ==========================================================================\n    initScreen4() {\n        const strapLeft = document.getElementById('seatbelt-strap-left');\n        const seatbeltContainer = document.getElementById('seatbelt-puzzle-box');\n        const btnEngineSound = document.getElementById('btn-engine-sound');\n        const btnTakeoff = document.getElementById('btn-takeoff-fly');\n        const portholeSky = document.getElementById('cabin-porthole-sky');\n        const btnNext4 = document.getElementById('btn-next-screen-4');\n\n        // Kéo khóa dây an toàn\n        if (strapLeft && seatbeltContainer) {\n            let isDragging = false;\n            let startX = 0;\n\n            const onPointerDown = (e) => {\n                if (this.seatbeltLocked) return;\n                isDragging = true;\n                strapLeft.setPointerCapture(e.pointerId);\n                startX = e.clientX;\n            };\n\n            const onPointerMove = (e) => {\n                if (!isDragging || this.seatbeltLocked) return;\n                const dx = Math.max(0, Math.min(40, e.clientX - startX));\n                strapLeft.style.transform = `translateX(${dx}px)`;\n\n                if (dx >= 30) {\n                    // Khóa thành công!\n                    this.seatbeltLocked = true;\n                    seatbeltContainer.classList.add('seatbelt-buckled');\n                    if (window.audioMgr) {\n                        window.audioMgr.playClack();\n                        setTimeout(() => {\n                            window.audioMgr.speak('Clack! Dây an toàn đã khóa chặt rồi! Bé an toàn tuyệt đối nhé!');\n                        }, 200);\n                    }\n                    if (window.effectsMgr) {\n                        const rect = seatbeltContainer.getBoundingClientRect();\n                        window.effectsMgr.burstStarsAt(rect.left + rect.width / 2, rect.top + rect.height / 2);\n                    }\n                    if (btnTakeoff) {\n                        btnTakeoff.removeAttribute('disabled');\n                        btnTakeoff.classList.add('kid-btn-primary', 'pop-in');\n                    }\n                }\n            };\n\n            const onPointerUp = (e) => {\n                if (!isDragging) return;\n                isDragging = false;\n                strapLeft.releasePointerCapture(e.pointerId);\n                if (!this.seatbeltLocked) {\n                    strapLeft.style.transform = 'translateX(0px)';\n                }\n            };\n\n            strapLeft.addEventListener('pointerdown', onPointerDown);\n            strapLeft.addEventListener('pointermove', onPointerMove);\n            strapLeft.addEventListener('pointerup', onPointerUp);\n        }\n\n        // Bật/tắt làm quen âm thanh động cơ\n        if (btnEngineSound) {\n            btnEngineSound.onclick = () => {\n                if (window.audioMgr) {\n                    if (window.audioMgr.isEngineRunning) {\n                        window.audioMgr.stopEngineSound();\n                        btnEngineSound.textContent = '🔊 Nghe thử động cơ êm';\n                    } else {\n                        window.audioMgr.startEngineSound(0.3);\n                        btnEngineSound.textContent = '⏸️ Đang nghe động cơ êm';\n                        window.audioMgr.speak('Đây là tiếng động cơ máy bay êm dịu, bé đừng lo lắng nhé!');\n                    }\n                }\n            };\n        }\n\n        // Nút Bay Lên Nào! (Cất cánh)\n        if (btnTakeoff) {\n            btnTakeoff.onclick = () => {\n                if (!this.seatbeltLocked) {\n                    if (window.audioMgr) {\n                        window.audioMgr.speak('Bé hãy thắt dây an toàn trước khi bay nhé!');\n                    }\n                    return;\n                }\n\n                if (this.isFlying) return;\n                this.isFlying = true;\n\n                if (window.audioMgr) {\n                    window.audioMgr.playWhoosh();\n                    window.audioMgr.startEngineSound(0.4);\n                    setTimeout(() => {\n                        window.audioMgr.playCabinChime();\n                        window.audioMgr.speak('Vù vù! Máy bay đang bay lượn trên những đám mây trắng bồng bềnh!');\n                    }, 1200);\n                }\n\n                // Hiệu ứng mây bay cuộn nhanh\n                document.querySelectorAll('.fluffy-cloud').forEach(cloud => {\n                    cloud.style.animationDuration = '3s';\n                });\n\n                // Chuyển cảnh trời hoàng hôn sang sáng\n                setTimeout(() => {\n                    if (portholeSky) portholeSky.classList.add('sunset');\n                }, 3000);\n\n                setTimeout(() => {\n                    if (btnNext4) {\n                        btnNext4.classList.remove('hidden');\n                        btnNext4.classList.add('pop-in');\n                    }\n                }, 4000);\n            };\n        }\n\n        if (btnNext4) {\n            btnNext4.addEventListener('click', () => {\n                if (window.audioMgr) {\n                    window.audioMgr.stopEngineSound();\n                    window.audioMgr.playPop();\n                }\n                this.initScreen5();\n                this.showScreen(5);\n            });\n        }\n    }\n\n    // ==========================================================================\n    // MÀN HÌNH 5: NHẬN HÀNH LÝ & BẰNG KHEN TỐT NGHIỆP\n    // ==========================================================================\n    initScreen5() {\n        const bags = document.querySelectorAll('.carousel-bag');\n        const certModal = document.getElementById('cert-modal');\n        const certStickerBadge = document.getElementById('cert-sticker-badge');\n        const btnReplay = document.getElementById('btn-replay-all');\n\n        // Gán sticker của bé vào 1 chiếc vali ngẫu nhiên (hoặc chiếc màu cam đặc biệt)\n        const myBagIndex = 2; // Chiếc thứ 3 là vali của bé\n        bags.forEach((bag, idx) => {\n            const stickerSpan = bag.querySelector('.bag-sticker');\n            if (idx === myBagIndex) {\n                if (stickerSpan) stickerSpan.textContent = this.selectedSticker;\n                bag.setAttribute('data-mine', 'true');\n            } else {\n                const fakeStickers = ['🍒', '🚀', '⚽', '🌺'];\n                if (stickerSpan) stickerSpan.textContent = fakeStickers[idx % fakeStickers.length];\n                bag.setAttribute('data-mine', 'false');\n            }\n\n            bag.onclick = () => {\n                const isMine = bag.getAttribute('data-mine') === 'true';\n\n                if (isMine) {\n                    // Chọn đúng vali của mình!\n                    bag.style.transform = 'scale(1.4) translateY(-20px)';\n                    document.querySelector('.carousel-suitcases').classList.add('paused');\n\n                    if (certStickerBadge) certStickerBadge.textContent = this.selectedSticker;\n\n                    if (window.effectsMgr) {\n                        window.effectsMgr.startCelebrationFireworks(7000);\n                    }\n\n                    if (window.audioMgr) {\n                        window.audioMgr.playFanfare();\n                        setTimeout(() => {\n                            window.audioMgr.speak('Hoan hô! Bé đã tìm đúng chiếc vali của mình và hoàn thành xuất sắc chuyến bay đầu tiên!');\n                        }, 500);\n                    }\n\n                    // Mở Bằng Khen Phi Công Nhí\n                    setTimeout(() => {\n                        if (certModal) certModal.classList.add('show');\n                    }, 1200);\n                } else {\n                    // Chọn nhầm vali khác\n                    if (window.audioMgr) {\n                        window.audioMgr.playBoing();\n                        window.audioMgr.speak('Vali này của bạn khác rồi, bé hãy tìm chiếc có hình ' + this.selectedSticker + ' nhé!');\n                    }\n                    bag.style.transform = 'scale(0.9)';\n                    setTimeout(() => { bag.style.transform = ''; }, 300);\n                }\n            };\n        });\n\n        // Chơi lại từ đầu\n        if (btnReplay) {\n            btnReplay.onclick = () => {\n                if (window.audioMgr) window.audioMgr.playPop();\n                window.location.reload();\n            };\n        }\n    }\n}\n\n// Khởi chạy ứng dụng khi DOM tải xong\ndocument.addEventListener('DOMContentLoaded', () => {\n    window.kidFlightApp = new KidFlightApp();\n});\n","Description":"Tạo controller và game logic cho toàn bộ 5 màn hình tương tác","Overwrite":true,"TargetFile":"c:\\Demo.plane\\js\\app.js","toolAction":"Writing file","toolSummary":"Create app.js"}}]}
