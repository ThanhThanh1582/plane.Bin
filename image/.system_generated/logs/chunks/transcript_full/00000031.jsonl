v class=\"activity-feedback-overlay hidden\" id=\"feedback-act-9\">\n                        <span class=\"feedback-text\">Bin: “Những đám mây thật kỳ diệu!”</span>\n                        <button class=\"tycoon-btn tycoon-btn-green btn-next-activity\" data-next=\"10\">\n                            HỌC NÓI NHỎ 🤫 ➡️\n                        </button>\n                    </div>\n                </div>\n            </section>\n\n            <!-- ==========================================================================\n                 CHẶNG 7 — HOẠT ĐỘNG 10: NÓI NHỎ VỪA ĐỦ NGHE (100% UNIFIED SCENE ART)\n                 ========================================================================== -->\n            <section id=\"act-10\" class=\"activity-container\" data-act=\"10\" data-stage=\"7\">\n                <div class=\"activity-intro-view\" id=\"intro-act-10\">\n                    <span class=\"intro-header-badge\">CHẶNG 7 — HOẠT ĐỘNG 10</span>\n                    <h2 class=\"intro-activity-title\">NÓI NHỎ VỪA ĐỦ NGHE</h2>\n                    <div class=\"intro-art-frame\">\n                        <img src=\"assets/scenes/scene_act10_whisper.jpg\" alt=\"Bin nói nhỏ\">\n                    </div>\n                    <p class=\"intro-prompt-quote\">Mẹ: “Trên máy bay mình nói nhỏ vừa đủ nghe nhé.”</p>\n                    <button class=\"tycoon-btn tycoon-btn-primary btn-start-activity\" data-act=\"10\" style=\"font-size: 17px; padding: 8px 28px;\">\n                        BẮT ĐẦU HOẠT ĐỘNG 🚀\n                    </button>\n                </div>\n\n                <div class=\"activity-gameplay-view hidden\" id=\"gameplay-act-10\">\n                    <div class=\"unified-scene-stage\">\n                        <img id=\"scene-img-act-10\" class=\"unified-scene-img\" src=\"assets/scenes/scene_act7_buckled.jpg\" alt=\"Scene Nói nhỏ\">\n\n                        <div class=\"scene-interactive-hud\">\n                            <span style=\"font-weight: 90