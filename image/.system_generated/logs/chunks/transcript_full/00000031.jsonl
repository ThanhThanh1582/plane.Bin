intro-view\" id=\"intro-act-8\">\n                    <span class=\"intro-header-badge\">CHẶNG 5 — HOẠT ĐỘNG 8</span>\n                    <h2 class=\"intro-activity-title\">GIÚP TAI DỄ CHỊU KHI CẤT CÁNH</h2>\n                    <div class=\"intro-art-frame\">\n                        <img src=\"assets/scenes/scene_act7_buckled.jpg\" alt=\"Bin ngồi ghế đã cài đai\">\n                    </div>\n                    <p class=\"intro-prompt-quote\">Mẹ: “Tai Bin hơi khó chịu. Bin uống một ngụm nước nhé.”</p>\n                    <button class=\"tycoon-btn tycoon-btn-primary btn-start-activity\" data-act=\"8\" style=\"font-size: 17px; padding: 8px 28px;\">\n                        BẮT ĐẦU HOẠT ĐỘNG 🚀\n                    </button>\n                </div>\n\n                <div class=\"activity-gameplay-view hidden\" id=\"gameplay-act-8\">\n                    <div class=\"unified-scene-stage\">\n                        <img id=\"scene-img-act-8\" class=\"unified-scene-img\" src=\"assets/scenes/scene_act7_buckled.jpg\" alt=\"Scene Uống nước\">\n\n                        <div class=\"scene-interactive-hud\" id=\"hud-drink-act-8\">\n                            <button id=\"btn-drink-action-8\" class=\"tycoon-btn tycoon-btn-primary\" style=\"font-size: 16px; padding: 8px 24px;\">\n                                🥤 Cho Bin uống từng ngụm nước nhỏ\n                            </button>\n                        </div>\n                    </div>\n\n                    <div class=\"activity-feedback-overlay hidden\" id=\"feedback-act-8\">\n                        <span class=\"feedback-text\">Bin: “Tai Bin dễ chịu hơn rồi!”</span>\n                        <button class=\"tycoon-btn tycoon-btn-green btn-next-activity\" data-next=\"9\">\n                            NGẮM MÂY ☁️ ➡️\n                        </button>\n                    </div>\n                </div>\n            </section>\n\n            <!-- =======================================================================