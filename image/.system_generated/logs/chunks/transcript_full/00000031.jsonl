y\n33:             poses: {\n34:                 standing: 'assets/characters/bin/bin_point_right.jpg',\n35:                 pointing: 'assets/characters/bin/bin_point_right.jpg',\n36:                 seated_open: 'assets/characters/bin/bin_seated_plane.jpg',\n37:                 seated_fastened: 'assets/characters/bin/bin_seatbelt_fastened.jpg',\n38:                 drinking_water: 'assets/characters/bin/bin_drink_water.jpg',\n39:                 looking_window: 'assets/characters/bin/bin_looking_window.jpg',\n40:                 whispering: 'assets/characters/bin/bin_whisper_sitting.jpg',\n41:                 sitting_neat: 'assets/characters/bin/bin_whisper_sitting.jpg',\n42:                 holding_badge: 'assets/characters/bin/bin_holding_badge.jpg'\n43:             }\n44:         };\n45: \n46:         this.init();\n47:     }\n48: \n49:     init() {\n50:         this.updateAll();\n51:     }\n52: \n53:     // --- Cập nhật từng thành phần trang phục ---\n54:     setShirt(val) {\n55:         this.characterState.outfit.shirt = val;\n56:         console.log('[CharacterRenderer] Outfit updated:', this.characterState.outfit);\n57:         this.updateAll();\n58:     }\n59: \n60:     setPants(val) {\n61:         this.characterState.outfit.pants = val;\n62:         console.log('[CharacterRenderer] Outfit updated:', this.characterState.outfit);\n63:         this.updateAll();\n64:     }\n65: \n66:     setShoes(val) {\n67:         this.characterState.outfit.shoes = val;\n68:         console.log('[CharacterRenderer] Outfit updated:', this.characterState.outfit);\n69:         this.updateAll();\n70:     }\n71: \n72:     setPose(poseName) {\n73:         this.characterState.pose = poseName;\n74:         this.updateAll();\n75:     }\n76: \n77:     setSeatbelt(status) {\n78:         this.characterState.seatbelt = status;\n79:         this.updateAll();\n80:     }\n81: \n82:     reset() {\n83:         this.characterState = {\n84:             outfit: { shirt: null, pants: null, shoes: null },\n85:             pose: 'standing',\n86:             expression: 'normal',\n87:             seatbelt: 'none',\n88:             holding: null\n89:         };\n90:         this.updateAll();\n91:     }\n92: \n93:     // --- State Machine ánh xạ sang Artwork thật của Level 1 ---\n94:     getOutfitSpriteSrc() {\n95:         const s = this.characterState.outfit.shirt;\n96:         const p = this.characterState.outfit.pants;\n97:         const sh = this.characterState.outfit.shoes;\n98: \n99:         // Trạng thái 0: Mộc ban đầu (áo ba lỗ trắng + tất mộc)\n100:         if (!s && !p && !sh) {\n101:             return this.assets.outfits.base_neutral;\n102:         }\n103:         // Trạng thái 1: Đã chọn áo vàng\n104:         if (s && !p && !sh) {\n105:             return this.assets.outfits.yellow_shirt_only;\n106:         }\n107:         // Trạng thái 2: Đã chọn áo vàng + quần xanh\n108:         if (s && p && !sh) {\n109:             return this.assets.outfits.yellow_shirt_blue_pants;\n110:         }\n111:         // Trạng thái 3: Đầy đủ áo vàng + quần xanh + giày dán xé\n112:         if (s && p && sh) {\n113:             return this.assets.outfits.yellow_shirt_blue_pants_shoes;\n114:         }\n115: \n116:         // Chuyển tiếp linh hoạt nếu chọn quần/giày trước\n117:         if (s && sh && !p) return this.assets.outfits.yellow_shirt_only;\n118:         if (p && !s) return this.assets.outfits.base_neutral;\n119: \n120:         return this.assets.outfits.yellow_shirt_blue_pants_shoes;\n121:     }\n122: \n123:     // --- Render trực tiếp vào DOM container ---\n124:     renderTo(containerEl, customMode = null, customSeatbelt = null) {\n125:         if (!containerEl) return;\n126: \n127:         const effectivePose = customMode || this.characterState.pose;\n128:         const effectiveSeatbelt = customSeatbelt !== null ? customSeatbelt : this.characterState.seatbelt;\n129: \n130:         let src = '';\n131: \n132:         if (effectivePose === 'level1_outfit') {\n13