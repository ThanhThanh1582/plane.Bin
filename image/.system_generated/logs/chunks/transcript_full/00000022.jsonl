span>\n                    </div>\n                </div>\n\n                <button id=\"btn-next-level-7\" class=\"tycoon-btn tycoon-btn-green hidden\" style=\"margin-top: 10px; font-size: 19px; padding: 10px 28px;\">\n                    MÁY BAY HẠ CÁNH RỒI! 🛬 ➡️\n                </button>\n            </section>\n\n            <!-- ==========================================================================\n                 LEVEL 8: HẠ CÁNH & NHẬN VALI & REWARD\n                 ========================================================================== -->\n            <section id=\"screen-8\" class=\"screen\">\n                <div class=\"carousel-final-arena\">\n                    <button id=\"unbuckle-latch-btn\" class=\"tycoon-btn\" disabled style=\"border: 3px dashed #78909C; font-size: 18px; padding: 12px 26px; opacity: 0.6;\">\n                        <span>⏳ Máy bay đang chạy vào bãi đỗ...</span>\n                    </button>\n\n                    <div id=\"baggage-carousel-lvl8\" class=\"carousel-track-chunky hidden\">\n                        <div class=\"carousel-suitcases-track\">\n                            <button class=\"carousel-bag-tile\" style=\"background: linear-gradient(180deg, #FF5252 0%, #D50000 100%); border: 3px solid #FFD54F;\" data-is-bin=\"true\" aria-label=\"Vali đỏ hình gấu\">\n                                <span>🐻</span>\n                            </button>\n                            <button class=\"carousel-bag-tile\" style=\"background: linear-gradient(180deg, #29B6F6 0%, #0288D1 100%); border: 3px solid #FFF;\" data-is-bin=\"false\" aria-label=\"Vali xanh tên lửa\">\n                                <span>🚀</span>\n                            </button>\n                            <button class=\"carousel-bag-tile\" style=\"background: linear-gradient(180deg, #FFEE58 0%, #FDD835 100%); border: 3px solid #FFF;\" data-is-bin=\"false\" aria-label=\"Vali vàng quả cherry\">\n                                <span>🍒</span>\n                            </button>\n                            <button class=\"carousel-bag-tile\" style=\"background: linear-gradient(180deg, #ECEFF1 0%, #B0BEC5 100%); border: 3px solid #FFF;\" data-is-bin=\"false\" aria-label=\"Vali bạc bóng đá\">\n                                <span>⚽</span>\n                            </button>\n                            <button class=\"carousel-bag-tile\" style=\"background: linear-gradient(180deg, #BA68C8 0%, #7B1FA2 100%); border: 3px solid #FFF;\" data-is-bin=\"false\" aria-label=\"Vali tím ngôi sao\">\n                                <span>⭐</span>\n                            </button>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- MÀN THƯỞNG: HÀNH KHÁCH NHÍ XUẤT SẮC -->\n                <div id=\"golden-medal-modal\" class=\"golden-medal-modal\">\n                    <div style=\"display: flex; justify-content: center; margin-bottom: 6px;\">\n                        <div id=\"bin-character-mount-lvl8\" style=\"width: 190px; height: 250px;\"></div>\n                    </div>\n                    <h2 style=\"font-size: 24px; font-weight: 900; color: #E65100; margin: 4px 0;\">HÀNH KHÁCH NHÍ XUẤT SẮC</h2>\n                    <p style=\"font-size: 15px; font-weight: 800; color: #37474F; margin: 4px 0;\">Bé Bin đã hoàn thành chuyến bay đầu tiên!</p>\n                    <div style=\"background: #E1F5FE; color: #0277BD; padding: 6px 16px; border-radius: 999px; font-weight: 900; font-size: 14px; display: inline-block; margin: 6px 0;\">\n                        ✈️ Đã nhận Mô hình Máy Bay vào bộ sưu tập của Bin!\n                    </div>\n\n                    <button id=\"btn-replay-adventure\" class=\"tycoon-btn tycoon-btn-primary\" style=\"font-size: 18px; padding: 10px 28px; margin-top: 12px;\">\n                        🔄 CHƠI LẠI CÙNG BIN\n                    </button>\n                </div>\n            </section>\n\n        </main>\n\n        <!-- CỔNG BA MẸ (PARENT CONTROL HUB) -->\n        <div id=\"parent-modal\" class=\"parent-modal-overlay\">\n            <div class=\"parent-control-card\">\n                <h2 style=\"color: #D84315; font-size: 21px; margin-bottom: 10px;\">🛡️ Cổng Dành Cho Ba Mẹ</h2>\n                \n                <div class=\"parent-tip-box\">\n                    <strong>💡 Giúp tai bé dễ chịu khi máy bay lên/xuống:</strong> Khi cất cánh hoặc hạ cánh, cho bé ngồi thẳng và uống từng ngụm nước nhỏ để khuyến khích động tác nuốt, giúp tai dễ chịu hơn. Nếu bé đau tai nhiều hoặc đang có bệnh lý tai mũi họng, ba mẹ nên tham khảo ý kiến bác sĩ trước chuyến bay.\n                </div>\n\n                <div class=\"parent-tip-box\">\n                    <strong>💡 Chuẩn bị tâm lý trước chuyến đi:</strong> Cùng bé xem trước các bước trong ứng dụng này để bé làm quen với không khí sân bay và các bước an toàn trước khi bay thực tế.\n                </div>\n\n                <div style=\"margin: 10px 0;\">\n                    <strong style=\"font-size: 14px; color: #37474F;\">Chọn nhanh màn chơi:</strong>\n                    <div class=\"level-jump-grid\">\n                        <button class=\"jump-btn\" data-level=\"1\">1. Mặc đồ</button>\n                        <button class=\"jump-btn\" data-level=\"2\">2. Xếp vali</button>\n                        <button class=\"jump-btn\" data-level=\"3\">3. An ninh</button>\n                        <button class=\"jump-btn\" data-level=\"4\">4. Cổng bay</button>\n                        <button class=\"jump-btn\" data-level=\"5\">5. Đai an toàn</button>\n                        <button class=\"jump-btn\" data-level=\"6\">6. Ngắm mây</button>\n                        <button class=\"jump-btn\" data-level=\"7\">7. Lịch sự</button>\n                        <button class=\"jump-btn\" data-level=\"8\">8. Nhận vali</button>\n                    </div>\n                </div>\n\n                <div style=\"display: flex; justify-content: space-between; align-items: center; margin: 8px 0; font-weight: 800; font-size: 14px;\">\n                    <span>Âm lượng hiệu ứng:</span>\n                    <input id=\"setting-volume\" type=\"range\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.85\" style=\"width: 130px; height: 24px;\">\n                </div>\n\n                <div style=\"display: flex; justify-content: space-between; align-items: center; margin: 8px 0; font-weight: 800; font-size: 14px;\">\n                    <span>Giảm hiệu ứng chuyển động:</span>\n                    <input id=\"setting-reduced-motion\" type=\"checkbox\" style=\"width: 22px; height: 22px;\">\n                </div>\n\n                <div style=\"display: flex; gap: 10px; margin-top: 12px;\">\n                    <button id=\"btn-reset-app\" class=\"tycoon-btn\" style=\"flex: 1; font-size: 15px;\">\n                        🔄 Chơi lại từ đầu\n                    </button>\n                    <button id=\"btn-close-parent\" class=\"tycoon-btn tycoon-btn-primary\" style=\"flex: 1; font-size: 15px;\">\n                        Đóng Bảng Cài Đặt ✓\n                    </button>\n                </div>\n            </div>\n        </div>\n\n    </div>\n\n    <!-- Scripts: audio -> effects -> character-renderer -> app -->\n    <script src=\"js/audio.js\"></script>\n    <script src=\"js/effects.js\"></script>\n    <script src=\"js/character-renderer.js\"></script>\n    <script src=\"js/app.js\"></script>\n</body>\n</html>\n","Description":"Cập nhật index.html chuẩn UI/UX 4 tầng, không khung trắng quanh Bin, không lộ đáp án trước","Overwrite":true,"TargetFile":"c:\\Demo.plane\\index.html","toolAction":"Writing file","toolSummary":"Update index.html for 8 levels UI/UX"}}]}
