-columns: 1fr 1fr;\n    gap: 20px;\n    align-items: center;\n}\n\n.seat-plush-box {\n    background: linear-gradient(180deg, #1976D2 0%, #0D47A1 100%);\n    border-radius: 38px;\n    border: 8px solid #0D47A1;\n    box-shadow: 0 10px 0 #002171, var(--shadow-chunky);\n    padding: 18px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    position: relative;\n}\n\n.safety-sign-led {\n    background: #FF5252;\n    color: white;\n    font-weight: 900;\n    font-size: 14px;\n    padding: 4px 16px;\n    border-radius: var(--radius-round);\n    margin-bottom: 8px;\n    transition: background 0.3s;\n}\n\n.safety-sign-led.green-safe {\n    background: #00E676;\n    color: #004D40;\n    box-shadow: 0 0 18px #00E676;\n}\n\n.knight-cape-icon {\n    position: absolute;\n    top: 50px;\n    font-size: 54px;\n    opacity: 0;\n    transform: scale(0.5);\n    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);\n}\n\n.knight-cape-icon.active {\n    opacity: 1;\n    transform: scale(1);\n    animation: gentle-sway 1.5s infinite;\n}\n\n.seatbelt-straps-row {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 16px;\n    height: 70px;\n    position: relative;\n}\n\n.strap-left, .strap-right {\n    height: 46px;\n    display: flex;\n    align-items: center;\n    cursor: grab;\n    touch-action: none;\n    transition: transform 0.2s;\n}\n\n.strap-left {\n    background: #37474F;\n    width: 90px;\n    border-radius: 8px 0 0 8px;\n    position: relative;\n}\n\n.buckle-insert {\n    position: absolute;\n    right: -18px;\n    width: 22px;\n    height: 30px;\n    background: #B0BEC5;\n    border: 3px solid #78909C;\n    border-radius: 4px;\n}\n\n.strap-right {\n    background: #37474F;\n    width: 90px;\n    border-radius: 0 8px 8px 0;\n    position: relative;\n}\n\n.buckle-receiver {\n    position: absolute;\n    left: -18px;\n    width: 28px;\n    height: 42px;\n    background: #90A4AE;\n    border: 3px solid #546E7A;\n    border-radius: 8px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n}\n\n.seatbelt-buckled .strap-left {\n    transform: translateX(18px) !important;\n}\n\n.seatbelt-buckled .buckle-receiver {\n    background: #00E676;\n    border-color: #00BFA5;\n    box-shadow: 0 0 18px #00E676;\n}\n\n/* ==========================================================================\n   LEVEL 6: NGẮM MÂY BIẾN HÌNH\n   ========================================================================== */\n.cloud-window-frame {\n    width: 100%;\n    max-width: 860px;\n    height: 310px;\n    background: linear-gradient(180deg, #29B6F6 0%, #81D4FA 60%, #E1F5FE 100%);\n    border-radius: 44px;\n    border: 14px solid #ECEFF1;\n    box-shadow: inset 0 0 25px rgba(0,0,0,0.18), 0 12px 0 #CFD8DC, var(--shadow-chunky);\n    display: flex;\n    align-items: center;\n    justify-content: space-around;\n    padding: 10px;\n}\n\n.morph-cloud-tile {\n    background: rgba(255, 255, 255, 0.95);\n    border-radius: 40px;\n    padding: 16px 26px;\n    box-shadow: 0 8px 18px rgba(0,0,0,0.12);\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    cursor: pointer;\n    border: 3px solid transparent;\n    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);\n}\n\n.morph-cloud-tile:hover { transform: translateY(-4px) scale(1.08); }\n\n.morph-cloud-tile.morphed {\n    background: #FFF9C4;\n    border-color: #FFD54F;\n    box-shadow: 0 0 25px #FFD54F;\n    animation: gentle-bounce 0.6s infinite alternate;\n}\n\n/* ==========================================================================\n   LEVEL 7: MÓN QUÀ LỊCH SỰ\n   ========================================================================== */\n.etiquette-arena {\n    width: 100%;\n    max-width: 860px;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 20px;\n}\n\n.etiquette-card-chunky {\n    background: rgba(255, 255, 255, 0.95);\n    border-radius: 30px;\n    padding: 20px;\n    border: 4px solid #B3E5FC;\n    box-shadow: 0 8px 0 #81D4FA, var(--shadow-chunky);\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 14px;\n}\n\n.volume-emotion-options {\n    display: flex;\n    gap: 14px;\n}\n\n.volume-emotion-btn {\n    width: 72px;\n    height: 72px;\n    border-radius: 24px;\n    background: #FFF;\n    border: 3px solid #CFD8DC;\n    box-shadow: 0 7px 0 #B0BEC5;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);\n}\n\n.volume-emotion-btn:hover { transform: translateY(-3px) scale(1.06); }\n\n.volume-emotion-btn span {\n    font-size: 28px;\n    line-height: 1;\n}\n\n.volume-emotion-btn small {\n    font-size: 11px;\n    font-weight: 900;\n    color: #455A64;\n    margin-top: 2px;\n}\n\n.volume-emotion-btn.selected {\n    transform: scale(1.15);\n    border-color: #00E676;\n    background: #E8F5E9;\n    box-shadow: 0 7px 0 #00BFA5, 0 0 16px #00E676;\n}\n\n/* ==========================================================================\n   LEVEL 8: LẤY VALI & HUY HIỆU DỰ THƯỞNG (CAROUSEL)\n   ========================================================================== */\n.carousel-final-arena {\n    width: 100%;\n    max-width: 900px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 14px;\n}\n\n.carousel-track-chunky {\n    width: 90%;\n    height: 160px;\n    border: 16px solid #455A64;\n    border-radius: 80px;\n    background: #ECEFF1;\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: space-around;\n    box-shadow: inset 0 0 18px rgba(0,0,0,0.25);\n    overflow: hidden;\n}\n\n.carousel-suitcases-track {\n    display: flex;\n    gap: 30px;\n    position: absolute;\n    animation: carousel-orbit 14s linear infinite;\n}\n\n.carousel-suitcases-track.paused {\n    animation-play-state: paused;\n}\n\n.carousel-bag-tile {\n    width: 78px;\n    height: 90px;\n    border-radius: 20px;\n    border: 4px solid rgba(0,0,0,0.2);\n    box-shadow: 0 6px 12px rgba(0,0,0,0.18);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 36px;\n    cursor: pointer;\n    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);\n}\n\n.carousel-bag-tile:hover { transform: scale(1.12); }\n.carousel-bag-tile:active { transform: scale(1.3) translateY(-10px); }\n\n.golden-medal-modal {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%) scale(0.8);\n    opacity: 0;\n    visibility: hidden;\n    width: 90%;\n    max-width: 580px;\n    background: linear-gradient(135deg, #FFFDE7 0%, #FFF9C4 100%);\n    border-radius: 38px;\n    border: 8px solid #FFD54F;\n    box-shadow: 0 20px 60px rgba(0,0,0,0.35);\n    padding: 26px;\n    text-align: center;\n    z-index: 200;\n    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);\n}\n\n.golden-medal-modal.show {\n    opacity: 1;\n    visibility: visible;\n    transform: translate(-50%, -50%) scale(1);\n    animation: popBounce 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);\n}\n\n/* ==========================================================================\n   CỔNG BA MẸ (PARENT CONTROL HUB)\n   ========================================================================== */\n.parent-modal-overlay {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100vw;\n    height: 100vh;\n    background: rgba(0, 0, 0, 0.65);\n    backdrop-filter: blur(8px);\n    z-index: 999;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    opacity: 0;\n    visibility: hidden;\n    transition: all 0.3s ease;\n}\n\n.parent-modal-overlay.open {\n    opacity: 1;\n    visibility: visible;\n}\n\n.parent-control-card {\n    width: 90%;\n    max-width: 560px;\n    max-height: 88vh;\n    overflow-y: auto;\n    background: #FFFFFF;\n    border-radius: 36px;\n    padding: 24px;\n    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);\n    border: 5px solid #FF8A65;\n}\n\n.parent-tip-box {\n    background: #FFF3E0;\n    border-left: 5px solid #FF9800;\n    padding: 10px 14px;\n    border-radius: 12px;\n    margin-bottom: 10px;\n    font-size: 14px;\n    line-height: 1.45;\n    color: #4E342E;\n}\n\n.level-jump-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 8px;\n    margin: 10px 0;\n}\n\n.jump-btn {\n    padding: 8px;\n    background: #ECEFF1;\n    border: 2px solid #CFD8DC;\n    border-radius: 12px;\n    font-weight: 800;\n    font-size: 14px;\n    cursor: pointer;\n    transition: transform 0.15s;\n}\n\n.jump-btn:hover { transform: scale(1.05); }\n\n/* ==========================================================================\n   KEYFRAME ANIMATIONS\n   ========================================================================== */\n@keyframes gentle-sway {\n    0%, 100% { transform: rotate(-3deg); }\n    50% { transform: rotate(3deg); }\n}\n\n@keyframes gentle-bounce {\n    0% { transform: translateY(0); }\n    100% { transform: translateY(-8px); }\n}\n\n@keyframes binHappyJump {\n    0% { transform: translateY(0) scale(1); }\n    100% { transform: translateY(-16px) scale(1.08); }\n}\n\n@keyframes springShake {\n    10%, 90% { transform: translate3d(-3px, 0, 0) rotate(-4deg); }\n    20%, 80% { transform: translate3d(5px, 0, 0) rotate(4deg); }\n    30%, 50%, 70% { transform: translate3d(-6px, 0, 0) rotate(-3deg); }\n    40%, 60% { transform: translate3d(6px, 0, 0) rotate(3deg); }\n}\n\n@keyframes stampSlam {\n    0% { transform: translate(-50%, -50%) scale(2.8) rotate(-40deg); opacity: 0; }\n    50% { transform: translate(-50%, -50%) scale(0.9) rotate(-10deg); opacity: 1; }\n    100% { transform: translate(-50%, -50%) scale(1.15) rotate(-15deg); opacity: 1; }\n}\n\n@keyframes popBounce {\n    0% { transform: scale(0.7); }\n    60% { transform: scale(1.25); }\n    100% { transform: scale(1); }\n}\n\n@keyframes lamp-blink {\n    0% { opacity: 0.3; }\n    100% { opacity: 1; }\n}\n\n@keyframes carousel-orbit {\n    0% { transform: translateX(0); }\n    100% { transform: translateX(-400px); }\n}\n\n.pop-in {\n    animation: popIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;\n}\n\n@keyframes popIn {\n    0% { transform: scale(0.6); opacity: 0; }\n    100% { transform: scale(1); opacity: 1; }\n}\n\n.hidden {\n    display: none !important;\n}\n\n/* ==========================================================================\n   RESPONSIVE OPTIMIZATIONS\n   ========================================================================== */\n@media (max-width: 900px) {\n    .wardrobe-arena, .suitcase-arena, .cabin-seat-arena, .etiquette-arena {\n        grid-template-columns: 1fr;\n        flex-direction: column;\n        gap: 12px;\n    }\n    .bin-stage-pedestal {\n        width: 180px;\n        height: 240px;\n    }\n    .bin-dynamic-avatar {\n        width: 130px;\n        height: 180px;\n    }\n    .security-station-grid {\n        grid-template-columns: 1fr;\n    }\n    .parent-prompt-signboard {\n        padding: 6px 14px;\n    }\n    .prompt-speech-text {\n        font-size: 17px;\n    }\n    .prompt-avatar-sprite {\n        width: 42px;\n        height: 42px;\n    }\n}\n","Description":"Cập nhật style.css cho dynamic character states của Bé Bin","Overwrite":true,"TargetFile":"c:\\Demo.plane\\css\\style.css","toolAction":"Writing file","toolSummary":"Update style.css with dynamic avatar classes"}}]}
