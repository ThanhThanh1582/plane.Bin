dow-soft);\n    border: 2px solid #FFF;\n}\n\n.stage-dot {\n    width: 34px;\n    height: 34px;\n    border-radius: 50%;\n    background: #ECEFF1;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 15px;\n    cursor: pointer;\n    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);\n    box-shadow: inset 0 -3px 0 #CFD8DC;\n    border: none;\n}\n\n.stage-dot.active {\n    background: linear-gradient(180deg, #F8D978 0%, #F5A45D 100%);\n    transform: scale(1.18);\n    box-shadow: 0 4px 12px rgba(245, 164, 93, 0.45), inset 0 -3px 0 #E67E22;\n}\n\n.stage-dot.completed {\n    background: linear-gradient(180deg, #A5D6A7 0%, #82C99A 100%);\n    box-shadow: inset 0 -3px 0 #66BB6A;\n}\n\n.stage-dot.locked {\n    opacity: 0.35;\n    cursor: not-allowed;\n    filter: grayscale(0.8);\n}\n\n/* NÚT BẤM STORYBOOK BO TRÒN */\n.tycoon-btn {\n    min-width: 60px;\n    min-height: 42px;\n    padding: 6px 18px;\n    border: none;\n    border-radius: var(--radius-round);\n    background: #FFFFFF;\n    color: var(--text-dark);\n    font-weight: 900;\n    font-size: 15px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    cursor: pointer;\n    box-shadow: 0 5px 0 #CFD8DC, 0 8px 14px rgba(0, 0, 0, 0.1);\n    transition: all 0.12s ease;\n    touch-action: manipulation;\n}\n\n.tycoon-btn:active:not(:disabled) {\n    transform: translateY(3px);\n    box-shadow: 0 2px 0 #CFD8DC;\n}\n\n.tycoon-btn:disabled {\n    cursor: not-allowed;\n    opacity: 0.6;\n}\n\n.tycoon-btn-green {\n    background: linear-gradient(180deg, #82C99A 0%, #66BB6A 100%);\n    color: #1B5E20;\n    box-shadow: 0 5px 0 #43A047, 0 8px 18px rgba(67, 160, 71, 0.3);\n}\n\n.tycoon-btn-primary {\n    background: linear-gradient(180deg, #F8D978 0%, #F5A45D 100%);\n    color: #5D4037;\n    box-shadow: 0 5px 0 #E67E22, 0 8px 18px rgba(230, 126, 34, 0.3);\n}\n\n/* Cổng Ba Mẹ: Vòng giữ 3 giây */\n.parent-gate-btn {\n    position: relative;\n    overflow: hidden;\n}\n\n.parent-hold-ring {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    pointer-events: none;\n    transform: rotate(-90deg);\n}\n\n.parent-hold-ring circle {\n    fill: none;\n    stroke: #FF7043;\n    stroke-width: 5;\n    stroke-dasharray: 175;\n    stroke-dashoffset: 175;\n    transition: stroke-dashoffset 0.1s linear;\n}\n\n/* ==========================================================================\n   TẦNG 2: TIẾN TRÌNH PHỤ (SUB-PROGRESS) & BIỂN BÁO LỜI THOẠI BA MẸ\n   ========================================================================== */\n.parent-prompt-container {\n    width: 100%;\n    max-width: 900px;\n    margin: 0 auto 2px auto;\n    padding: 0 16px;\n    z-index: 40;\n    display: flex;\n    flex-direction: column;\n    gap: 3px;\n}\n\n.sub-progress-bar {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 12px;\n    background: rgba(255, 255, 255, 0.9);\n    padding: 2px 14px;\n    border-radius: var(--radius-round);\n    font-size: 13px;\n    font-weight: 800;\n    color: #455A64;\n    border: 1px solid rgba(255, 255, 255, 0.9);\n}\n\n.parent-prompt-signboard {\n    background: rgba(255, 255, 255, 0.96);\n    border-radius: 20px;\n    padding: 4px 16px;\n    border: 3px solid #FFE082;\n    box-shadow: 0 3px 0 #FFCA28, var(--shadow-soft);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    text-align: center;\n}\n\n.prompt-avatar-sprite {\n    width: 42px;\n    height: 42px;\n    border-radius: 50%;\n    border: 3px solid #F5A45D;\n    box-shadow: 0 3px 8px rgba(0,0,0,0.12);\n    background-image: var(--char-sprite);\n    background-repeat: no-repeat;\n    flex-shrink: 0;\n}\n\n.prompt-avatar-sprite.speaker-mom {\n    background-size: 500% auto;\n    background-position: 29.5% 18%;\n    border-color: #EFA49A;\n}\n\n.prompt-avatar-sprite.speaker-dad {\n    background-size: 500% auto;\n    background-position: 51.5% 18%;\n    border-color: #82C99A;\n}\n\n.prompt-avatar-sprite.speaker-bin {\n    background-size: 500% auto;\n    background-position: 8.5% 18%;\n    border-color: #F5A45D;\n}\n\n.prompt-avatar-sprite.speaker-attendant {\n    background-size: 500% auto;\n    background-position: 88.5% 18%;\n    border-color: #00897B;\n}\n\n.prompt-speech-text {\n    font-size: 17px;\n    font-weight: 900;\n    color: var(--text-dark);\n    line-height: 1.3;\n}\n\n/* ==========================================================================\n   TẦNG 3: VIEWPORT 13 HOẠT ĐỘNG (UNIFIED SCENE ART & INTRO VIEW)\n   ========================================================================== */\n.screens-viewport {\n    flex: 1;\n    position: relative;\n    width: 100%;\n    height: calc(100vh - 110px);\n    overflow: hidden;\n}\n\n.activity-container {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    opacity: 0;\n    visibility: hidden;\n    transform: scale(0.98);\n    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.34, 1.25, 0.64, 1), visibility 0.3s;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    padding: 2px 14px 8px 14px;\n    background-size: cover;\n    background-position: center;\n    background-repeat: no-repeat;\n}\n\n.activity-container.active {\n    opacity: 1;\n    visibility: visible;\n    transform: scale(1);\n}\n\n/* MÀN GIỚI THIỆU HOẠT ĐỘNG (INTRO VIEW) */\n.activity-intro-view {\n    width: 100%;\n    max-width: 820px;\n    height: 90%;\n    background: rgba(255, 255, 255, 0.96);\n    backdrop-filter: blur(10px);\n    border-radius: var(--radius-story);\n    border: 4px solid #FFE082;\n    box-shadow: 0 10px 0 #FFCA28, var(--shadow-chunky);\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: space-between;\n    padding: 12px 20px;\n    text-align: center;\n    margin: auto 0;\n    z-index: 10;\n}\n\n.intro-header-badge {\n    background: #E1F5FE;\n    color: #0288D1;\n    font-size: 13px;\n    font-weight: 900;\n    padding: 3px 14px;\n    border-radius: var(--radius-round);\n    border: 2px solid #B3E5FC;\n}\n\n.intro-activity-title {\n    font-size: 21px;\n    font-weight: 900;\n    color: #E65100;\n    margin: 2px 0;\n}\n\n.intro-art-frame {\n    width: 100%;\n    max-width: 620px;\n    height: 250px;\n    border-radius: 20px;\n    overflow: hidden;\n    box-shadow: 0 6px 16px rgba(0,0,0,0.12);\n    border: 3px solid #FFF;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background: #FFF;\n}\n\n.intro-art-frame img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n}\n\n.intro-prompt-quote {\n    font-size: 16px;\n    font-weight: 800;\n    color: #37474F;\n    line-height: 1.3;\n    padding: 0 10px;\n}\n\n/* MÀN THỰC HIỆN HOẠT ĐỘNG (GAMEPLAY VIEW) */\n.activity-gameplay-view {\n    width: 100%;\n    height: 100%;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    position: relative;\n}\n\n/* ==========================================================================\n   UNIFIED SCENE ART STAGE (HOÀN TOÀN KHÔNG CÓ KHUNG TRẮNG / STICKER)\n   ========================================================================== */\n.unified-scene-stage {\n    width: 100%;\n    max-width: 860px;\n    height: 86%;\n    position: relative;\n    border-radius: 28px;\n    overflow: hidden;\n    box-shadow: 0 8px 24px rgba(0,0,0,0.18), 0 0 0 4px #FFFFFF;\n    background: #000;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin: auto 0;\n}\n\n.unified-scene-img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    transition: opacity 0.35s ease, transform 0.35s cubic-bezier(0.34, 1.25, 0.64, 1);\n}\n\n/* THANH HUD TƯƠNG TÁC PHÍA DƯỚI CỦA UNIFIED SCENE */\n.scene-interactive-hud {\n    position: absolute;\n    bottom: 12px;\n    left: 50%;\n    transform: translateX(-50%);\n    background: rgba(255, 255, 255, 0.95);\n    backdrop-filter: blur(8px);\n    border-radius: var(--radius-round);\n    padding: 8px 20px;\n    border: 3px solid #FFE082;\n    box-shadow: 0 6px 0 #FFCA28, var(--shadow-soft);\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    z-index: 20;\n}\n\n/* OVERLAY PHẢN HỒI HOÀN THÀNH */\n.activity-feedback-overlay {\n    position: absolute;\n    bottom: 14px;\n    left: 50%;\n    transform: translateX(-50%);\n    background: rgba(255, 255, 255, 0.98);\n    border-radius: 30px;\n    padding: 8px 22px;\n    border: 4px solid #82C99A;\n    box-shadow: 0 8px 0 #43A047, var(--shadow-chunky);\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    z-index: 60;\n    animation: popBounce 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);\n    white-space: nowrap;\n}\n\n.activity-feedback-overlay.hidden {\n    display: none !important;\n}\n\n.feedback-text {\n    font-size: 17px;\n    font-weight: 900;\n    color: #1B5E20;\n}\n\n/* ==========================================================================\n   ACTIVITY 1: WARDROBE (OUTFIT STATE MACHINE)\n   ========================================================================== */\n.wardrobe-arena {\n    width: 100%;\n    max-width: 960px;\n    display: grid;\n    grid-template-columns: 1.2fr 1fr;\n    gap: 20px;\n    align-items: center;\n    margin: auto 0;\n}\n\n.wardrobe-cabinet-art {\n    background: rgba(255, 255, 255, 0.9);\n    backdrop-filter: blur(8px);\n    border: 4px solid #FFE082;\n    border-radius: var(--radius-story);\n    padding: 10px;\n    box-shadow: var(--shadow-chunky);\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 10px;\n}\n\n.clothes-tile-art {\n    min-height: 85px;\n    background: #FFFFFF;\n    border-radius: 18px;\n    border: 3px solid #CFD8DC;\n    box-shadow: 0 4px 0 #B0BEC5, 0 6px 12px rgba(0,0,0,0.06);\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    padding: 4px;\n    cursor: pointer;\n    touch-action: none;\n    transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);\n}\n\n.clothes-tile-art:hover { transform: translateY(-3px) scale(1.04); }\n.clothes-tile-art:active { transform: scale(1.15); z-index: 100; }\n.clothes-tile-art.shake-wobble {\n    animation: springShake 0.45s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;\n    border-color: #E75B52 !important;\n}\n\n.item-img-art {\n    width: 58px;\n    height: 58px;\n    object-fit: contain;\n    pointer-events: none;\n}\n\n.item-label-tag {\n    font-size: 12px;\n    font-weight: 800;\n    color: var(--text-dark);\n    margin-top: 2px;\n    text-align: center;\n}\n\n.bin-stage-pedestal {\n    width: 260px;\n    height: 380px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    position: relative;\n}\n\n.bin-mount-lvl1 {\n    width: 250px;\n    height: 370px;\n}\n\n.bin-layered-stack {\n    position: relative;\n    width: 100%;\n    height: 100%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n}\n\n.bin-layer {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n    pointer-events: none;\n}\n\n/* ==========================================================================\n   ACTIVITY 4: SOI HÀNH LÝ QUA MÁY QUÉT (ĐỘC LẬP)\n   ========================================================================== */\n.xray-focused-arena {\n    width: 100%;\n    max-width: 820px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 14px;\n    margin: auto 0;\n}\n\n.xray-scanner-chunky {\n    width: 100%;\n    max-width: 580px;\n    background: rgba(255, 255, 255, 0.95);\n    border-radius: 36px;\n    border: 4px solid #00E676;\n    box-shadow: 0 8px 0 #00BFA5, var(--shadow-chunky);\n    padding: 16px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 10px;\n}\n\n.xray-screen-large {\n    width: 100%;\n    height: 130px;\n    background: #00251A;\n    border-radius: 22px;\n    border: 4px solid #00E676;\n    box-shadow: inset 0 0 20px rgba(0, 230, 118, 0.5);\n    display: flex;\n    align-items: center;\n    justify-content: space-around;\n    padding: 8px;\n}\n\n.xray-box-touch {\n    width: 76px;\n    height: 76px;\n    background: #00E676;\n    border-radius: 18px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 36px;\n    cursor: pointer;\n    box-shadow: 0 0 14px #00E676;\n    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);\n}\n\n.xray-box-touch:hover { transform: scale(1.12); }\n.xray-box-touch.revealed { animation: popBounce 0.35s cubic-bezier(0.34, 1.56, 0.64, 1); }\n\n/* ==========================================================================\n   CÁC HOẠT ĐỘNG KHÁC (2, 3, 5, 6, 13)\n   ========================================================================== */\n.suitcase-arena {\n    width: 100%;\n    max-width: 880px;\n    display: flex;\n    gap: 20px;\n    align-items: center;\n    justify-content: center;\n    margin: auto 0;\n}\n\n.clothes-tile {\n    width: 105px;\n    height: 85px;\n    background: #FFFFFF;\n    border-radius: 18px;\n    border: 3px solid #CFD8DC;\n    box-shadow: 0 4px 0 #B0BEC5, 0 6px 12px rgba(0,0,0,0.06);\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n    transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);\n    padding: 4px;\n}\n\n.clothes-tile:hover { transform: translateY(-3px) scale(1.04); }\n.clothes-tile.shake-wobble { animation: springShake 0.45s cubic-bezier(0.36, 0.07, 0.19, 0.97) both; }\n\n.suitcase-box-red {\n    width: 270px;\n    height: 280px;\n    border-radius: 34px;\n    border: 5px solid #8E0000;\n    box-shadow: 0 10px 0 #5f0000, var(--shadow-chunky);\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    padding: 10px;\n    position: relative;\n}\n\n.suitcase-inner-grid {\n    width: 100%;\n    flex: 1;\n    border-radius: 22px;\n    border: 3px dashed #E75B52;\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    grid-template-rows: repeat(2, 1fr);\n    gap: 6px;\n    padding: 6px;\n    align-items: center;\n    justify-items: center;\n}\n\n.boarding-pass-chunky {\n    width: 220px;\n    height: 110px;\n    background: #FFF9C4;\n    border-radius: 20px;\n    border: 3px dashed #FFB300;\n    box-shadow: 0 6px 14px rgba(0,0,0,0.1);\n    padding: 12px;\n    cursor: pointer;\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    transition: transform 0.2s;\n    position: relative;\n}\n\n.stamp-badge {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%) rotate(-15deg) scale(0);\n    border: 3px solid #43A047;\n    color: #2E7D32;\n    font-weight: 900;\n    font-size: 19px;\n    padding: 6px 14px;\n    border-radius: 10px;\n    opacity: 0;\n    background: #E8F5E9;\n    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);\n}\n\n.stamp-badge.stamped {\n    opacity: 1;\n    transform: translate(-50%, -50%) rotate(-15deg) scale(1.1);\n    animation: stampSlam 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;\n}\n\n.gate-detector-chunky {\n    width: 160px;\n    height: 220px;\n    border: 14px solid #78909C;\n    border-bottom: none;\n    border-radius: 24px 24px 0 0;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: flex-end;\n    cursor: pointer;\n    background: rgba(236, 239, 241, 0.6);\n    position: relative;\n}\n\n.gate-lamps-row {\n    position: absolute;\n    top: -22px;\n    display: flex;\n    gap: 16px;\n}\n\n.gate-lamp-led {\n    width: 22px;\n    height: 22px;\n    border-radius: 50%;\n    background: #CFD8DC;\n    border: 2px solid #546E7A;\n}\n\n.gate-lamp-led.green-flash {\n    background: #00E676;\n    box-shadow: 0 0 16px #00E676;\n    animation: lamp-blink 0.25s alternate 6;\n}\n\n.gates-array-row {\n    display: flex;\n    justify-content: space-around;\n    gap: 14px;\n}\n\n.gate-pillar {\n    width: 125px;\n    height: 125px;\n    background: #263238;\n    color: #F8D978;\n    border: 4px solid #455A64;\n    border-radius: 22px;\n    box-shadow: 0 6px 0 #102027;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n    font-family: monospace;\n    font-weight: 900;\n    transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);\n}\n\n.gate-pillar.matched {\n    background: linear-gradient(180deg, #2E7D32 0%, #1B5E20 100%);\n    border-color: #00E676;\n    color: #FFFFFF;\n    box-shadow: 0 6px 0 #004D40, 0 0 20px #00E676;\n    animation: popBounce 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);\n}\n\n.volume-emotion-options {\n    display: flex;\n    gap: 12px;\n}\n\n.volume-emotion-btn {\n    width: 86px;\n    height: 80px;\n    border-radius: 20px;\n    background: #FFF;\n    border: 3px solid #CFD8DC;\n    box-shadow: 0 5px 0 #B0BEC5;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);\n}\n\n.volume-emotion-btn.selected {\n    transform: scale(1.12);\n    border-color: #43A047;\n    background: #E8F5E9;\n    box-shadow: 0 5px 0 #2E7D32, 0 0 14px #00E676;\n}\n\n.carousel-track-chunky {\n    width: 90%;\n    height: 150px;\n    border: 14px solid #455A64;\n    border-radius: 75px;\n    background: #ECEFF1;\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: space-around;\n    box-shadow: inset 0 0 16px rgba(0,0,0,0.2);\n    overflow: hidden;\n}\n\n.carousel-suitcases-track {\n    display: flex;\n    gap: 28px;\n    position: absolute;\n    animation: carousel-orbit 14s linear infinite;\n}\n\n.carousel-suitcases-track.paused { animation-play-state: paused; }\n\n.carousel-bag-tile {\n    width: 76px;\n    height: 86px;\n    border-radius: 18px;\n    border: 3px solid rgba(0,0,0,0.2);\n    box-shadow: 0 4px 10px rgba(0,0,0,0.15);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 34px;\n    cursor: pointer;\n    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);\n}\n\n.golden-medal-modal {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%) scale(0.8);\n    opacity: 0;\n    visibility: hidden;\n    width: 90%;\n    max-width: 560px;\n    background: linear-gradient(135deg, #FFFDE7 0%, #FFF9C4 100%);\n    border-radius: 36px;\n    border: 6px solid #F8D978;\n    box-shadow: 0 16px 50px rgba(0,0,0,0.3);\n    padding: 22px;\n    text-align: center;\n    z-index: 200;\n    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);\n}\n\n.golden-medal-modal.show {\n    opacity: 1;\n    visibility: visible;\n    transform: translate(-50%, -50%) scale(1);\n    animation: popBounce 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);\n}\n\n/* ==========================================================================\n   CỔNG BA MẸ (PARENT CONTROL HUB)\n   ========================================================================== */\n.parent-modal-overlay {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100vw;\n    height: 100vh;\n    background: rgba(0, 0, 0, 0.6);\n    backdrop-filter: blur(6px);\n    z-index: 999;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    opacity: 0;\n    visibility: hidden;\n    transition: all 0.3s ease;\n}\n\n.parent-modal-overlay.open { opacity: 1; visibility: visible; }\n\n.parent-control-card {\n    width: 90%;\n    max-width: 540px;\n    max-height: 88vh;\n    overflow-y: auto;\n    background: #FFFFFF;\n    border-radius: 32px;\n    padding: 22px;\n    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25);\n    border: 4px solid #F5A45D;\n}\n\n.parent-tip-box {\n    background: #FFF3E0;\n    border-left: 4px solid #F5A45D;\n    padding: 8px 12px;\n    border-radius: 10px;\n    margin-bottom: 8px;\n    font-size: 13px;\n    line-height: 1.4;\n    color: #4E342E;\n}\n\n.level-jump-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 8px;\n    margin: 8px 0;\n}\n\n.jump-btn {\n    padding: 8px;\n    background: #ECEFF1;\n    border: 2px solid #CFD8DC;\n    border-radius: 10px;\n    font-weight: 800;\n    font-size: 13px;\n    cursor: pointer;\n    transition: transform 0.15s;\n}\n\n/* ==========================================================================\n   KEYFRAME ANIMATIONS\n   ========================================================================== */\n@keyframes springShake {\n    10%, 90% { transform: translate3d(-3px, 0, 0) rotate(-3deg); }\n    20%, 80% { transform: translate3d(4px, 0, 0) rotate(3deg); }\n    30%, 50%, 70% { transform: translate3d(-5px, 0, 0) rotate(-2deg); }\n    40%, 60% { transform: translate3d(5px, 0, 0) rotate(2deg); }\n}\n@keyframes stampSlam {\n    0% { transform: translate(-50%, -50%) scale(2.4) rotate(-35deg); opacity: 0; }\n    50% { transform: translate(-50%, -50%) scale(0.95) rotate(-10deg); opacity: 1; }\n    100% { transform: translate(-50%, -50%) scale(1.1) rotate(-15deg); opacity: 1; }\n}\n@keyframes popBounce { 0% { transform: scale(0.8); } 60% { transform: scale(1.18); } 100% { transform: scale(1); } }\n@keyframes lamp-blink { 0% { opacity: 0.3; } 100% { opacity: 1; } }\n@keyframes carousel-orbit { 0% { transform: translateX(0); } 100% { transform: translateX(-380px); } }\n\n.pop-in { animation: popIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; }\n@keyframes popIn { 0% { transform: scale(0.7); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }\n.hidden { display: none !important; }\n\n/* ==========================================================================\n   RESPONSIVE