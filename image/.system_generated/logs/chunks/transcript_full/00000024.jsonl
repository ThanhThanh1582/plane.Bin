u khi tách nền\n        this.transparentCache = {};\n\n        // Bảng ánh xạ Artwork Storybook 2D Thật\n        this.assetManifest = {\n            outfitSprites: {\n                base_neutral: 'file:///C:/Users/USER/.gemini/antigravity/brain/6f49409f-fe23-4490-984d-4f0e771339c6/bin_base_neutral_1787728929375.jpg',\n                yellow_shirt_only: 'file:///C:/Users/USER/.gemini/antigravity/brain/6f49409f-fe23-4490-984d-4f0e771339c6/bin_yellow_shirt_only_1787728966000.jpg',\n                yellow_shirt_blue_pants: 'file:///C:/Users/USER/.gemini/antigravity/brain/6f49409f-fe23-4490-984d-4f0e771339c6/bin_yellow_shirt_blue_pants_1787728991730.jpg',\n                yellow_shirt_blue_pants_shoes: 'file:///C:/Users/USER/.gemini/antigravity/brain/6f49409f-fe23-4490-984d-4f0e771339c6/bin_yellow_shirt_blue_pants_shoes_1787729023680.jpg'\n            },\n            storybookPoses: {\n                standing: 'file:///C:/Users/USER/.gemini/antigravity/brain/6f49409f-fe23-4490-984d-4f0e771339c6/bin_point_right_1787725750609.jpg',\n                pointing: 'file:///C:/Users/USER/.gemini/antigravity/brain/6f49409f-fe23-4490-984d-4f0e771339c6/bin_point_right_1787725750609.jpg',\n                seated_open: 'file:///C:/Users/USER/.gemini/antigravity/brain/6f49409f-fe23-4490-984d-4f0e771339c6/bin_seated_plane_1787725580022.jpg',\n                seated_fastened: 'file:///C:/Users/USER/.gemini/antigravity/brain/6f49409f-fe23-4490-984d-4f0e771339c6/bin_seatbelt_fastened_1787725612313.jpg',\n                drinking_water: 'file:///C:/Users/USER/.gemini/antigravity/brain/6f49409f-fe23-4490-984d-4f0e771339c6/bin_drink_water_1787725639196.jpg',\n                looking_window: 'file:///C:/Users/USER/.gemini/antigravity/brain/6f49409f-fe23-4490-984d-4f0e771339c6/bin_looking_window_1787725671427.jpg',\n                whispering: 'file:///C:/Users/USER/.gemini/antigravity/brain/6f49409f-fe23-4490-984d-4f0e771339c6/bin_whisper_sitting_1787725691994.jpg',\n                sitting_neat: 'file:///C:/Users/USER/.gemini/antigravity/brain/6f49409f-fe23-4490-984d-4f0e771339c6/bin_whisper_sitting_1787725691994.jpg',\n                holding_badge: 'file:///C:/Users/USER/.gemini/antigravity/brain/6f49409f-fe23-4490-984d-4f0e771339c6/bin_holding_badge_1787725718575.jpg'\n            }\n        };\n\n        this.init();\n    }\n\n    init() {\n        this.updateAll();\n    }\n\n    // ==========================================================================\n    // FLOOD-FILL BACKGROUND REMOVAL (TÁCH NỀN NGOÀI, GIỮ 100% ĐẶC CHO THÂN BÉ BIN)\n    // ==========================================================================\n\n    getTransparentImage(src, callback) {\n        if (this.transparentCache[src]) {\n            callback(this.transparentCache[src]);\n            return;\n        }\n\n        const img = new Image();\n        img.crossOrigin = 'anonymous';\n        img.onload = () => {\n            try {\n                const canvas = document.createElement('canvas');\n                canvas.width = img.naturalWidth || img.width;\n                canvas.height = img.naturalHeight || img.height;\n                const ctx = canvas.getContext('2d');\n                ctx.drawImage(img, 0, 0);\n\n                const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);\n                const data = imgData.data;\n                const w = canvas.width;\n                const h = canvas.height;\n\n                const visited = new Uint8Array(w * h);\n                const queue = [];\n\n                const isOuterWhite = (x, y) => {\n                    const idx = (y * w + x) * 4;\n                    const r = data[idx];\n                    const g = data[idx + 1];\n                    const b = data[idx + 2];\n                    return r > 235 && g > 235 && b > 235;\n                };\n\n                for (let x = 0; x < w; x++) {\n                    if (isOuterWhite(x, 0)) { queue.push(x, 0); visited[0 * w + x] = 1; }\n                    if (isOuterWhite(x, h - 1)) { queue.push(x, h - 1); visited[(h - 1) * w + x] = 1; }\n                }\n                for (let y = 0; y < h; y++) {\n                    if (isOuterWhite(0, y) && !visited[y * w + 0]) { queue.push(0, y); visited[y * w + 0] = 1; }\n                    if (isOuterWhite(w - 1, y) && !visited[y * w + (w - 1)]) { queue.push(w - 1, y); visited[y * w + (w - 1)] = 1; }\n                }\n\n                let head = 0;\n                while (head < queue.length) {\n                    const qx = queue[head++];\n                    const qy = queue[head++];\n\n                    const idx = (qy * w + qx) * 4;\n                    data[idx + 3] = 0;\n\n                    const neighbors = [ [qx + 1, qy], [qx - 1, qy], [qx, qy + 1], [qx, qy - 1] ];\n                    for (let i = 0; i < 4; i++) {\n                        const nx = neighbors[i][0];\n                        const ny = neighbors[i][1];\n                        if (nx >= 0 && nx < w && ny >= 0 && ny < h) {\n                            const nPos = ny * w + nx;\n                            if (!visited[nPos] && isOuterWhite(nx, ny)) {\n                                visited[nPos] = 1;\n                                queue.push(nx, ny);\n                            }\n                        }\n                    }\n                }\n\n                ctx.putImageData(imgData, 0, 0);\n                const transparentUrl = canvas.toDataURL('image/png');\n                this.transparentCache[src] = transparentUrl;\n                callback(transparentUrl);\n            } catch (e) {\n                callback(src);\n            }\n        };\n        img.onerror = () => {\n            callback(src);\n        };\n        img.src = src;\n    }\n\n    // ==========================================================================\n    // PUBLIC STATE API (GỌI TỪ GAMEPLAY CONTROLLER)\n    // ==========================================================================\n\n    setShirt(value) {\n        this.characterState.outfit.shirt = value;\n        console.log('[CharacterRenderer] State updated:', JSON.parse(JSON.stringify(this.characterState)));\n        this.updateAll();\n    }\n\n    setPants(value) {\n        this.characterState.outfit.pants = value;\n        console.log('[CharacterRenderer] State updated:', JSON.parse(JSON.stringify(this.characterState)));\n        this.updateAll();\n    }\n\n    setShoes(value) {\n        this.characterState.outfit.shoes = value;\n        console.log('[CharacterRenderer] State updated:', JSON.parse(JSON.stringify(this.characterState)));\n        this.updateAll();\n    }\n\n    setPose(poseName) {\n        this.characterState.pose = poseName;\n        this.updateAll();\n    }\n\n    setSeatbelt(seatbeltState) {\n        this.characterState.seatbelt = seatbeltState; // 'none' | 'open' | 'fastened'\n        this.updateAll();\n    }\n\n    setHolding(item) {\n        this.characterState.holding = item;\n        if (item === 'water') {\n            this.setPose('drinking_water');\n        } else if (item === 'badge') {\n            this.setPose('holding_badge');\n        } else {\n            this.updateAll();\n        }\n    }\n\n    reset() {\n        this.characterState = {\n            outfit: { shirt: null, pants: null, shoes: null },\n            pose: 'standing',\n            expression: 'normal',\n            seatbelt: 'none',\n            holding: null\n        };\n        this.updateAll();\n    }\n\n    // ==========================================================================\n    // RESOLVE OUTFIT SPRITE (LEVEL 1 STATE MACHINE)\n    // ==========================================================================\n\n    getOutfitSprite() {\n        const s = this.characterState.outfit.shirt;\n        const p = this.characterState.outfit.pants;\n        const sh = this.characterState.outfit.shoes;\n\n        // Trạng thái 0: Chưa mặc đồ ngoài\n        if (!s && !p && !sh) {\n            return this.assetManifest.outfitSprites.base_neutral;\n        }\n\n        // Trạng thái 1: Đã chọn áo vàng\n        if (s && !p && !sh) {\n            return this.assetManifest.outfitSprites.yellow_shirt_only;\n        }\n\n        // Trạng thái 2: Đã chọn áo vàng + quần xanh\n        if (s && p && !sh) {\n            return this.assetManifest.outfitSprites.yellow_shirt_blue_pants;\n        }\n\n        // Trạng thái 3: Đầy đủ áo vàng + quần xanh + giày dán xé\n        if (s && p && sh) {\n            return this.assetManifest.outfitSprites.yellow_shirt_blue_pants_shoes;\n        }\n\n        // Các kết hợp chuyển tiếp khác\n        if (s && sh && !p) return this.assetManifest.outfitSprites.yellow_shirt_only;\n        if (p && !s) return this.assetManifest.outfitSprites.base_neutral;\n\n        return this.assetManifest.outfitSprites.yellow_shirt_blue_pants_shoes;\n    }\n\n    // ==========================================================================\n    // RENDER ENGINE\n    // ==========================================================================\n\n    renderTo(containerEl, customMode = null, customSeatbelt = null) {\n        if (!containerEl) return;\n\n        const effectivePose = customMode || this.characterState.pose;\n        const effectiveSeatbelt = customSeatbelt !== null ? customSeatbelt : this.characterState.seatbelt;\n\n        let rawSrc = '';\n\n        if (effectivePose === 'level1_outfit') {\n            rawSrc = this.getOutfitSprite();\n        } else if (effectivePose === 'seated') {\n            const poseKey = effectiveSeatbelt === 'fastened' ? 'seated_fastened' : 'seated_open';\n            rawSrc = this.assetManifest.storybookPoses[poseKey];\n        } else {\n            rawSrc = this.assetManifest.storybookPoses[effectivePose] || this.assetManifest.storybookPoses.standing;\n        }\n\n        containerEl.innerHTML = '';\n        containerEl.classList.add('bin-character-frame');\n\n        const wrapper = document.createElement('div');\n        wrapper.className = 'bin-layered-stack';\n\n        const poseImg = document.createElement('img');\n        poseImg.className = 'bin-layer bin-layer-pose pop-in-soft';\n        poseImg.alt = `Bé Bin ${effectivePose}`;\n        poseImg.style.opacity = '1';\n\n        this.getTransparentImage(rawSrc, (cleanSrc) => {\n            poseImg.src = cleanSrc;\n        });\n\n        wrapper.appendChild(poseImg);\n        containerEl.appendChild(wrapper);\n    }\n\n    updateAll() {\n        // 1. Mount point Level 1: Bé Bin thay đổi trang phục thật qua Outfit State Machine\n        const lvl1Mount = document.getElementById('bin-character-mount-lvl1');\n        if (lvl1Mount) this.renderTo(lvl1Mount, 'level1_outfit');\n\n        // 2. Mount point Level 3 Cổng An Ninh\n        const lvl3Mount = document.getElementById('bin-character-mount-lvl3');\n        if (lvl3Mount) this.renderTo(lvl3Mount, 'pointing');\n\n        // 3. Mount point Level 5 Ghế Ngồi Khoang Bay\n        const lvl5Mount = document.getElementById('bin-character-mount-lvl5');\n        if (lvl5Mount) {\n            const pose5 = this.characterState.pose === 'drinking_water' ? 'drinking_water' : 'seated';\n            this.renderTo(lvl5Mount, pose5, this.characterState.seatbelt);\n        }\n\n        // 4. Mount point Level 6 Nhìn Cửa Sổ\n        const lvl6Mount = document.getElementById('bin-character-mount-lvl6');\n        if (lvl6Mount) this.renderTo(lvl6Mount, 'looking_window');\n\n        // 5. Mount point Level 7 Lịch Sự\n        const lvl7Mount = document.getElementById('bin-character-mount-lvl7');\n        if (lvl7Mount) {\n            const pose7 = this.characterState.pose === 'whispering' ? 'whispering' : (this.characterState.pose === 'sitting_neat' ? 'sitting_neat' : 'seated');\n            this.renderTo(lvl7Mount, pose7, 'fastened');\n        }\n\n        // 6. Mount point Level 8 Nhận Thưởng\n        const lvl8Mount = document.getElementById('bin-character-mount-lvl8');\n        if (lvl8Mount) {\n            const pose8 = this.characterState.pose === 'holding_badge' ? 'holding_badge' : 'standing';\n            this.renderTo(lvl8Mount, pose8);\n        }\n    }\n}\n\n// Khởi tạo instance toàn cục\nwindow.binRenderer = new CharacterRenderer();\n","Description":"Cập nhật character-renderer.js hỗ trợ Outfit State Machine Level 1 thay đổi quần áo thật 100%","Overwrite":true,"TargetFile":"c:\\Demo.plane\\js\\character-renderer.js","toolAction":"Writing file","toolSummary":"Update character-renderer.js with Outfit State Machine"}}]}
